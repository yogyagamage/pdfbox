    private static class SimpleRandomAccessRead implements RandomAccessRead {
        private byte[] data;
        private long position = 0;
        
        public SimpleRandomAccessRead(byte[] data) {
            this.data = data;
        }
        
        @Override
        public long getPosition() throws IOException {
            return position;
        }
        
        @Override
        public void seek(long position) throws IOException {
            this.position = position;
        }
        
        @Override
        public int read() throws IOException {
            if (position >= data.length) {
                return -1;
            }
            return data[(int)position++] & 0xFF;
        }
        
        @Override
        public int read(byte[] b, int offset, int length) throws IOException {
            if (position >= data.length) {
                return -1;
            }
            int bytesToRead = (int)Math.min(length, data.length - position);
            System.arraycopy(data, (int)position, b, offset, bytesToRead);
            position += bytesToRead;
            return bytesToRead;
        }
        
        @Override
        public long length() throws IOException {
            return data.length;
        }
        
        @Override
        public void close() throws IOException {
            // No-op
        }
        
        @Override
        public boolean isClosed() {
            return false;
        }
        
        @Override
        public RandomAccessRead createView(long startOffset, long streamLength) throws IOException {
            byte[] viewData = new byte[(int)streamLength];
            long originalPosition = position;
            seek(startOffset);
            read(viewData, 0, (int)streamLength);
            seek(originalPosition);
            return new SimpleRandomAccessRead(viewData);
        }
        
        @Override
        public boolean isEOF() throws IOException {
            return position >= data.length;
        }
        
        @Override
        public int peek() throws IOException {
            if (position >= data.length) {
                return -1;
            }
            return data[(int)position] & 0xFF;
        }
        
        @Override
        public void rewind(int bytes) throws IOException {
            position = Math.max(0, position - bytes);
        }
        
        @Override
        public byte[] readFully(int length) throws IOException {
            byte[] result = new byte[length];
            int bytesRead = read(result, 0, length);
            if (bytesRead < length) {
                byte[] trimmed = new byte[bytesRead];
                System.arraycopy(result, 0, trimmed, 0, bytesRead);
                return trimmed;
            }
            return result;
        }
        
        @Override
        public int available() throws IOException {
            return (int)Math.max(0, data.length - position);
        }
    }

