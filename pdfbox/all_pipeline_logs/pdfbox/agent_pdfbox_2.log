    private byte[] createIndexedPngWithHighBitDepth() throws Exception {
        // Create a minimal PNG with indexed color type (3) and bit depth 16
        // PNG signature + IHDR chunk + PLTE chunk + IDAT chunk + IEND chunk
        
        // PNG signature (8 bytes)
        byte[] pngSignature = new byte[] {
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk (13 bytes of data + 4 bytes length + 4 bytes type + 4 bytes CRC)
        // Width: 1, Height: 1, Bit depth: 16, Color type: 3 (indexed)
        // Compression: 0, Filter: 0, Interlace: 0
        byte[] ihdrData = new byte[13];
        // Width = 1
        ihdrData[0] = 0; ihdrData[1] = 0; ihdrData[2] = 0; ihdrData[3] = 1;
        // Height = 1
        ihdrData[4] = 0; ihdrData[5] = 0; ihdrData[6] = 0; ihdrData[7] = 1;
        // Bit depth = 16
        ihdrData[8] = 16;
        // Color type = 3 (indexed)
        ihdrData[9] = 3;
        // Compression method = 0
        ihdrData[10] = 0;
        // Filter method = 0
        ihdrData[11] = 0;
        // Interlace method = 0
        ihdrData[12] = 0;
        
        // PLTE chunk (3 colors = 9 bytes)
        byte[] plteData = new byte[] {
            (byte) 0xFF, 0x00, 0x00,  // Red
            (byte) 0x00, 0xFF, 0x00,  // Green
            (byte) 0x00, 0x00, 0xFF   // Blue
        };
        
        // IDAT chunk (compressed data - minimal valid zlib stream for 1 pixel)
        // Simple deflate block with no compression for 2 bytes (16-bit index)
        byte[] idatData = new byte[] {
            0x78, 0x01,  // zlib header
            0x01, 0x01, 0x00, (byte) 0xFE, (byte) 0xFF,  // deflate block
            0x00, 0x00, 0x00, 0x00  // 1 pixel with index 0 (2 bytes: 0x00 0x00)
        };
        
        // IEND chunk (0 bytes data)
        
        // Combine everything
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        baos.write(pngSignature);
        
        // Write IHDR chunk
        writeChunk(baos, "IHDR".getBytes(), ihdrData);
        
        // Write PLTE chunk
        writeChunk(baos, "PLTE".getBytes(), plteData);
        
        // Write IDAT chunk
        writeChunk(baos, "IDAT".getBytes(), idatData);
        
        // Write IEND chunk
        writeChunk(baos, "IEND".getBytes(), new byte[0]);
        
        return baos.toByteArray();
    }
    
    private void writeChunk(java.io.ByteArrayOutputStream baos, byte[] type, byte[] data) throws IOException {
        // Write length (big-endian)
        int length = data.length;
        baos.write((length >> 24) & 0xFF);
        baos.write((length >> 16) & 0xFF);
        baos.write((length >> 8) & 0xFF);
        baos.write(length & 0xFF);
        
        // Write chunk type
        baos.write(type);
        
        // Write data
        baos.write(data);
        
        // Calculate and write CRC (simplified - using dummy CRC for test)
        byte[] crcBytes = new byte[type.length + data.length];
        System.arraycopy(type, 0, crcBytes, 0, type.length);
        System.arraycopy(data, 0, crcBytes, type.length, data.length);
        int crc = calculateCRC(crcBytes);
        baos.write((crc >> 24) & 0xFF);
        baos.write((crc >> 16) & 0xFF);
        baos.write((crc >> 8) & 0xFF);
        baos.write(crc & 0xFF);
    }
    
    private int calculateCRC(byte[] bytes) {
        // Simplified CRC calculation for test purposes
        // In real PNG, this would use the actual CRC algorithm
        return 0x12345678;  // Dummy CRC value
    }
}

