package org.apache.pdfbox.multipdf;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.junit.jupiter.api.Test;
import java.io.IOException;
import java.util.List;

public class Splitter_PDDocumentmethod_LogdebugFikaTest {

    @Test
    public void testSplitTriggersLogDebug() throws IOException {
        Splitter splitter = new Splitter();
        splitter.setSplitAtPage(1);
        
        try (PDDocument sourceDocument = new PDDocument()) {
            PDPage page1 = new PDPage();
            sourceDocument.addPage(page1);
            
            PDPage page2 = new PDPage();
            sourceDocument.addPage(page2);
            
            List<PDDocument> result = splitter.split(sourceDocument);
            
            for (PDDocument doc : result) {
                doc.close();
            }
        }
    }
}

