 */
@Override
public void processPage(PDPage page) throws IOException {
    if ((((currentPageNo >= startPage) && (currentPageNo <= endPage)) && ((startBookmarkPageNumber == (-1)) || (currentPageNo >= startBookmarkPageNumber))) && ((endBookmarkPageNumber == (-1)) || (currentPageNo <= endBookmarkPageNumber))) // PATH: Test should invoke the next PDFTextStripper.writePage(...) [step in execution path]
