        // Set the soft mask in the graphics state to trigger the call chain
        pageDrawer.getGraphicsState().setSoftMask(softMask);
        
        // Call the entry point method
        pageDrawer.strokePath();
        
        // Cleanup
        graphics.dispose();
        document.close();
    }
