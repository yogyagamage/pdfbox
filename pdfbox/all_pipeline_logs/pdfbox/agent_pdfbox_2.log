        // Create a mock PDDocument
        PDDocument mockDocument = mock(PDDocument.class);
        
        // Create a mock TrueTypeFont that returns null for vertical header
        TrueTypeFont mockTtf = mock(TrueTypeFont.class);
        when(mockTtf.getVerticalHeader()).thenReturn(null);
        
        // Mock required methods to avoid NPE during execution
        HeaderTable mockHeader = mock(HeaderTable.class);
        when(mockHeader.getUnitsPerEm()).thenReturn(1000);
        when(mockTtf.getHeader()).thenReturn(mockHeader);
        
