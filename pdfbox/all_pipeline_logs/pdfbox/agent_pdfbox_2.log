        PDAcroForm acroForm = new PDAcroForm(document);
        
        // Create a real PDChoice instance using the public constructor
        PDChoice pdChoice = new PDChoice(acroForm);
        
        // Set up the field to be a multi-select combo box
        // We need to set the flag directly on the COS dictionary
        COSDictionary cosDict = pdChoice.getCOSObject();
        int currentFlags = cosDict.getInt(COSName.FF, 0);
        currentFlags |= PDChoice.FLAG_COMBO;
        currentFlags |= PDChoice.FLAG_MULTI_SELECT;
        cosDict.setInt(COSName.FF, currentFlags);
        
        // Add options to the field
        COSArray optionsArray = new COSArray();
        optionsArray.add(COSName.getPDFName("Option1"));
        optionsArray.add(COSName.getPDFName("Option2"));
        optionsArray.add(COSName.getPDFName("Option3"));
        cosDict.setItem(COSName.OPT, optionsArray);
        
        // Create a widget annotation and add it to the field
        PDAnnotationWidget widget = new PDAnnotationWidget();
        COSDictionary widgetDict = new COSDictionary();
        widgetDict.setItem(COSName.TYPE, COSName.ANNOT);
        widgetDict.setItem(COSName.SUBTYPE, COSName.WIDGET);
        widget.setCOSObject(widgetDict);
        pdChoice.setWidget(widget);
        
        // Prepare values to set
