public class FontMapperImpl_FileSystemFontProvidersaveDiskCache_LogwarnFikaTest {

    @Test
    public void testGetProviderTriggersLogWarn() throws Exception {
        // Create a temporary directory that will be used as font cache directory
        Path tempDir = Files.createTempDirectory("pdfbox-fontcache-test");
        String originalCacheDir = System.getProperty("pdfbox.fontcache");
        try {
            // Set the font cache directory to our temp directory
            System.setProperty("pdfbox.fontcache", tempDir.toString());
            
            // Create an instance of FontMapperImpl using the default constructor
            FontMapperImpl fontMapper = new FontMapperImpl();
            
            // Clear any existing font provider to force initialization
            Field fontProviderField = FontMapperImpl.class.getDeclaredField("fontProvider");
            fontProviderField.setAccessible(true);
            fontProviderField.set(fontMapper, null);
            
            // Call getProvider() which should trigger the chain ending in Log.warn()
            fontMapper.getProvider();
            
        } finally {
            // Restore original system property
            if (originalCacheDir != null) {
                System.setProperty("pdfbox.fontcache", originalCacheDir);
            } else {
                System.clearProperty("pdfbox.fontcache");
            }
            
            // Clean up temp directory
            try {
                Files.walk(tempDir)
                     .sorted((a, b) -> -a.compareTo(b))
                     .map(Path::toFile)
                     .forEach(File::delete);
            } catch (IOException e) {
                // Ignore cleanup errors
            }
        }
    }
}

