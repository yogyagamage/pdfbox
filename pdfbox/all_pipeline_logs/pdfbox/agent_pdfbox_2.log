            0x00, 0x06, // stringOffset = 6
            
            // Name record
            0x00, 0x00, // platformID = Unicode
            0x00, 0x00, // encodingID
            0x00, 0x00, // languageID
            0x00, 0x06, // nameID = PostScript name
            0x00, 0x0C, // length = 12
            0x00, 0x00, // offset = 0 (relative to string storage)
            
            // String storage: "Test|Font" in UTF-16BE
            0x00, 0x54, 0x00, 0x65, 0x00, 0x73, 0x00, 0x74, 0x00, 0x7C, 0x00, 0x46,
            0x00, 0x6F, 0x00, 0x6E, 0x00, 0x74
