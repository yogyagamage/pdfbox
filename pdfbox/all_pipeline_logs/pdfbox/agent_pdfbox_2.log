    public void testStrokePathToLogDebug() throws IOException {
        // Create minimal PDDocument with a page
        PDDocument document = new PDDocument();
        PDPage page = new PDPage(PDRectangle.A4);
        document.addPage(page);
        
        // Create a mock PDFRenderer (required for PageDrawerParameters)
        PDFRenderer renderer = new PDFRenderer(document);
        
        // Create PageDrawerParameters with required dependencies
        PageDrawerParameters parameters = new PageDrawerParameters(page, renderer);
        
        // Instantiate PageDrawer using the provided constructor
        PageDrawer pageDrawer = new PageDrawer(parameters);
        
        // Create a Graphics2D context for drawing
        BufferedImage image = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = image.createGraphics();
        
