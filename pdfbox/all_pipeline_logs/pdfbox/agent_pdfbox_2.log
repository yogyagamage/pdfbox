        COSDictionary softMaskDict = new COSDictionary();
        softMaskDict.setItem(COSName.TYPE, COSName.MASK);
        softMaskDict.setItem(COSName.S, COSName.LUMINOSITY);
        softMaskDict.setItem(COSName.G, form);
        
        // Create backdrop color array
        COSArray backdropArray = new COSArray();
        backdropArray.addFloat(0.5f);
        backdropArray.addFloat(0.5f);
        backdropArray.addFloat(0.5f);
        softMaskDict.setItem(COSName.BC, backdropArray);
        
        PDSoftMask softMask = new PDSoftMask(softMaskDict);
        
        // Set up graphics state with the soft mask
        pageDrawer.getGraphicsState().setSoftMask(softMask);
        
        // Create a simple path to stroke
        pageDrawer.moveTo(10, 10);
        pageDrawer.lineTo(50, 50);
        
        // This should trigger the call chain:
        // strokePath() -> getStrokingPaint() -> applySoftMaskToPaint() -> 
        // new TransparencyGroup() -> LOG.warn()
        pageDrawer.strokePath();
        
        // Cleanup
        graphics.dispose();
        document.close();
    }
}

