public class FontMapperImpl_FileSystemFontProvidersaveDiskCache_LogwarnFikaTest {

    @Test
    public void testGetProviderTriggersLogWarn() throws Exception {
        FontMapperImpl fontMapper = new FontMapperImpl();
        
        // Create a temporary directory that will be unwritable to trigger IOException
        Path tempDir = Files.createTempDirectory("pdfbox-test");
        File tempFile = tempDir.toFile();
        tempFile.setWritable(false);
        
        try {
            // Set the pdfbox.fontcache system property to point to the unwritable directory
            System.setProperty("pdfbox.fontcache", tempDir.toString());
            
            // Clear the static fontCache to ensure new FileSystemFontProvider is created
            Field fontCacheField = FontMapperImpl.class.getDeclaredField("fontCache");
            fontCacheField.setAccessible(true);
            FontCache cache = (FontCache) fontCacheField.get(null);
            
            // Clear any existing cache to force saveDiskCache to be called
            Field cacheField = cache.getClass().getDeclaredField("cache");
            cacheField.setAccessible(true);
            java.util.Map<?, ?> map = (java.util.Map<?, ?>) cacheField.get(cache);
            map.clear();
            
            // This should trigger the call chain:
            // getProvider() -> DefaultFontProvider.<clinit>() -> FileSystemFontProvider constructor
            // -> saveDiskCache() -> Log.warn()
            fontMapper.getProvider();
            
        } finally {
            // Cleanup
            tempFile.setWritable(true);
            Files.deleteIfExists(tempDir);
            System.clearProperty("pdfbox.fontcache");
        }
    }
}

