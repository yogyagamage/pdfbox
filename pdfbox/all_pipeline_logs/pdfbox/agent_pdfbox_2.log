    private static class RandomAccessReadBuffer implements RandomAccessRead {
        private final byte[] data;
        private long position = 0;
        private boolean closed = false;
        
        public RandomAccessReadBuffer(byte[] data) {
            this.data = data;
        }
        
        public int read() throws IOException {
            checkClosed();
            if (position >= data.length) {
                return -1;
            }
            return data[(int) position++] & 0xFF;
        }
        
        public int read(byte[] b, int off, int len) throws IOException {
            checkClosed();
            if (position >= data.length) {
                return -1;
            }
            int bytesToRead = (int) Math.min(len, data.length - position);
            System.arraycopy(data, (int) position, b, off, bytesToRead);
            position += bytesToRead;
            return bytesToRead;
        }
        
        public long getPosition() throws IOException {
            checkClosed();
            return position;
        }
        
        public void seek(long position) throws IOException {
            checkClosed();
            this.position = Math.min(position, data.length);
        }
        
        public long length() throws IOException {
            checkClosed();
            return data.length;
        }
        
        public boolean isClosed() {
            return closed;
        }
        
        public void close() throws IOException {
            closed = true;
        }
        
        public RandomAccessReadBuffer clone() {
            return new RandomAccessReadBuffer(data);
        }
        
        public int peek() throws IOException {
            checkClosed();
            if (position >= data.length) {
                return -1;
            }
            return data[(int) position] & 0xFF;
        }
        
        public void rewind(int bytes) throws IOException {
            checkClosed();
            position = Math.max(0, position - bytes);
        }
        
        public boolean isEOF() throws IOException {
            checkClosed();
            return position >= data.length;
        }
        
        public int available() throws IOException {
            checkClosed();
            return (int) Math.max(0, data.length - position);
        }
        
        private void checkClosed() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
        }
    }
