        PDAcroForm acroForm = new PDAcroForm(document);
        
        // Create a COSDictionary for a PDComboBox field
        COSDictionary fieldDict = new COSDictionary();
        fieldDict.setItem(COSName.FT, COSName.CH);
        fieldDict.setItem(COSName.T, new COSString("TestComboBox"));
        
        // Create a widget annotation dictionary
        COSDictionary widgetDict = new COSDictionary();
        widgetDict.setItem(COSName.TYPE, COSName.ANNOT);
        widgetDict.setItem(COSName.SUBTYPE, COSName.WIDGET);
        
        // Add widget to field's kids array
        COSArray kidsArray = new COSArray();
        kidsArray.add(widgetDict);
        fieldDict.setItem(COSName.KIDS, kidsArray);
        
