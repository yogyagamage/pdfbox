package org.apache.pdfbox.pdfparser;

import org.apache.pdfbox.cos.COSObject;
import org.apache.pdfbox.cos.COSObjectKey;
import org.apache.pdfbox.io.RandomAccessRead;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;

class COSParservalidateStreamLength_LogdebugFikaTest {

    @Test
    void testDereferenceCOSObjectPathToLogDebug() throws IOException {
        // Create a minimal PDF content that will trigger the desired path
        String pdfContent = "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<< /Length 0 >>\n" +
                "stream\n" +
                "endstream\n" +
                "endobj\n" +
                "xref\n" +
                "0 2\n" +
                "0000000000 65535 f \n" +
                "0000000018 00000 n \n" +
                "trailer\n" +
                "<< /Size 2 /Root 1 0 R >>\n" +
                "startxref\n" +
                "55\n" +
                "%%EOF";
        
        RandomAccessRead source = new RandomAccessRead() {
            private int position = 0;
            private final byte[] data = pdfContent.getBytes();
            
            @Override
            public void close() throws IOException {
                // no-op
            }
            
            @Override
            public int read() throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                return data[position++] & 0xFF;
            }
            
            @Override
            public int read(byte[] b, int off, int len) throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                int bytesToRead = Math.min(len, data.length - position);
                System.arraycopy(data, position, b, off, bytesToRead);
                position += bytesToRead;
                return bytesToRead;
            }
            
            @Override
            public long getPosition() throws IOException {
                return position;
            }
            
            @Override
            public void seek(long pos) throws IOException {
                position = (int) pos;
            }
            
            @Override
            public long length() throws IOException {
                return data.length;
            }
            
            @Override
            public int peek() throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                return data[position] & 0xFF;
            }
            
            @Override
            public void rewind(int bytes) throws IOException {
                position = Math.max(0, position - bytes);
            }
            
            @Override
            public byte[] readFully(int length) throws IOException {
                byte[] result = new byte[length];
                int read = read(result, 0, length);
                if (read < length) {
                    throw new IOException("Unexpected end of file");
                }
                return result;
            }
            
            @Override
            public boolean isClosed() {
                return false;
