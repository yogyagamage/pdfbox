    @Test
    public void testShowTransparencyGroupTriggersLogWarn() throws IOException {
        // Create minimal PDDocument and PDPage
        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);
            
            // Create PDFRenderer with the document
            PDFRenderer renderer = new PDFRenderer(document);
            
            // Create PageDrawerParameters using reflection since constructor is package-private
            PageDrawerParameters parameters = new PageDrawerParameters(
                page,
                renderer,
                false, // subsamplingAllowed
                null,  // destination
                null,  // renderingHints
                0.0f   // imageDownscalingOptimizationThreshold
            );
            
            // Instantiate PageDrawer using the provided constructor
            PageDrawer pageDrawer = new PageDrawer(parameters);
            
            // Create a PDTransparencyGroup with null BBox to trigger the warning
            // PDTransparencyGroup extends PDFormXObject
            PDFormXObject form = new PDFormXObject(document);
            PDTransparencyGroup transparencyGroup = new PDTransparencyGroup(form);
            
            // Set null BBox to trigger the warning in the constructor
            // We need to access the COSDictionary to remove the BBox entry
            transparencyGroup.getCOSObject().removeItem(org.apache.pdfbox.cos.COSName.BBOX);
            
            // Create a minimal Graphics2D context for the pageDrawer
            BufferedImage bufferedImage = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
            Graphics2D graphics = bufferedImage.createGraphics();
            
            // Initialize the pageDrawer by calling drawPage (this sets up internal state)
            pageDrawer.drawPage(graphics, PDRectangle.A4);
            
            // Call the entry point method - this should traverse the path to Log.warn()
            pageDrawer.showTransparencyGroup(transparencyGroup);
            
            graphics.dispose();
        }
    }
}

