public class PDFStreamEngine_SoftMaskmethod_LogdebugFikaTest {

    @Test
    public void testShowTextStringTriggersLogDebug() throws Exception {
        // Create a custom PageDrawer that will use a real SoftMask
        PageDrawer drawer = new PageDrawer() {
            // We need to override getGraphicsState to return a state with a soft mask
            @Override
            public PDGraphicsState getGraphicsState() {
                PDGraphicsState state = super.getGraphicsState();
                if (state != null) {
                    try {
                        // Create a soft mask that will trigger the path
                        PDSoftMask softMask = createSoftMaskWithBackdropColor();
                        state.setSoftMask(softMask);
                    } catch (IOException e) {
                        // Ignore for test
                    }
                }
                return state;
            }
            
            // Override getStrokingPaint to ensure we get to applySoftMaskToPaint
            @Override
            private Paint getStrokingPaint() throws IOException {
                // Return a simple paint that will be wrapped by SoftMask
                return Color.BLACK;
            }
            
            // Override drawGlyph to make sure it calls getStrokingPaint
            @Override
            private void drawGlyph(GeneralPath path, PDFont font, int code, 
                                  Vector displacement, AffineTransform at) throws IOException {
                // Call parent implementation which will call getStrokingPaint
                super.drawGlyph(path, font, code, displacement, at);
            }
        };
        
        // Initialize the drawer with a page
        PDPage page = new PDPage(PDRectangle.A4);
        drawer.processPage(page);
        
        // Set up graphics state with a font
        PDGraphicsState state = drawer.getGraphicsState();
        PDTextState textState = state.getTextState();
        PDFont font = PDType1Font.HELVETICA;
        textState.setFont(font);
        textState.setFontSize(12);
        
        // Create text matrix and other required state
        state.setTextMatrix(new Matrix());
        
        // Call the entry point method
        byte[] textBytes = "Test".getBytes();
        drawer.showTextString(textBytes);
    }
    
    private PDSoftMask createSoftMaskWithBackdropColor() throws IOException {
        // Create a soft mask dictionary
        COSDictionary dict = new COSDictionary();
        dict.setItem(COSName.S, COSName.LUMINOSITY); // Luminosity subtype
        
        // Create backdrop color array that will cause IOException when converted to RGB
        COSArray backdropArray = new COSDictionary(); // Wrong type - will cause IOException
        dict.setItem(COSName.BC, backdropArray);
        
        // Create transparency group
        COSDictionary groupDict = new COSDictionary();
        groupDict.setItem(COSName.TYPE, COSName.GROUP);
        groupDict.setItem(COSName.S, COSName.TRANSPARENCY);
        PDTransparencyGroup group = new PDTransparencyGroup(groupDict);
        
        dict.setItem(COSName.G, group);
        
        // Create transfer function
        PDFunction transferFunction = new PDFunctionTypeIdentity(null);
        
        return new PDSoftMask(dict, transferFunction);
    }
    
    // Inner class to simulate PageDrawer behavior
    private static class PageDrawer extends PDFStreamEngine {
        private Map<PDFont, GlyphCache> glyphCaches = new HashMap<>();
        private Deque<PDGraphicsState> graphicsStack = new ArrayDeque<>();
        
        public PageDrawer() {
            graphicsStack.push(new PDGraphicsState(PDRectangle.A4));
        }
        
        @Override
        protected void showFontGlyph(Matrix textRenderingMatrix, PDFont font, 
                                    int code, Vector displacement) throws IOException {
            // Create a simple path for the glyph
            GeneralPath path = new GeneralPath();
            path.moveTo(0, 0);
            path.lineTo(10, 0);
            path.lineTo(10, 10);
            path.lineTo(0, 10);
            path.closePath();
            
            AffineTransform at = textRenderingMatrix.createAffineTransform();
            at.concatenate(font.getFontMatrix().createAffineTransform());
            
            // Call drawGlyph
            drawGlyph(path, font, code, displacement, at);
        }
        
        private void drawGlyph(GeneralPath path, PDFont font, int code, 
                              Vector displacement, AffineTransform at) throws IOException {
            // This will call getStrokingPaint
            getStrokingPaint();
        }
        
        private Paint getStrokingPaint() throws IOException {
            PDGraphicsState graphicsState = getGraphicsState();
            // Create a simple paint
            Paint paint = Color.BLACK;
            
            // Get soft mask from graphics state
            PDSoftMask softMask = graphicsState.getSoftMask();
            
            // Call applySoftMaskToPaint
            return applySoftMaskToPaint(paint, softMask);
        }
        
        private Paint applySoftMaskToPaint(Paint parentPaint, PDSoftMask softMask) throws IOException {
            if (softMask == null || softMask.getGroup() == null) {
                return parentPaint;
            }
            
            // Create a buffered image for the mask
            BufferedImage image = new BufferedImage(10, 10, BufferedImage.TYPE_INT_ARGB);
            BufferedImage gray = new BufferedImage(10, 10, BufferedImage.TYPE_BYTE_GRAY);
            
            Rectangle2D bounds = new Rectangle2D.Float(0, 0, 10, 10);
            
            // Get backdrop color - this will be null or invalid
            PDColor backdropColor = null;
            if (COSName.LUMINOSITY.equals(softMask.getSubType())) {
                COSArray backdropArray = softMask.getBackdropColor();
                if (backdropArray != null) {
                    // This will cause an exception when trying to convert to RGB
                    backdropColor = new PDColor(backdropArray, PDDeviceRGB.INSTANCE);
                }
            }
            
            // Get transfer function
            PDFunction transferFunction = softMask.getTransferFunction();
            
            // Create SoftMask - this will trigger Log.debug when backdropColor conversion fails
            new SoftMask(parentPaint, gray, bounds, backdropColor, transferFunction);
            
            return parentPaint;
        }
        
        @Override
        public PDGraphicsState getGraphicsState() {
            return graphicsStack.peek();
        }
        
        @Override
        protected void showGlyph(Matrix textRenderingMatrix, PDFont font, 
                                int code, Vector displacement) throws IOException {
            showFontGlyph(textRenderingMatrix, font, code, displacement);
        }
        
        @Override
        protected void showText(byte[] string) throws IOException {
            PDGraphicsState state = getGraphicsState();
            PDTextState textState = state.getTextState();
            PDFont font = textState.getFont();
            
            if (font == null) {
                font = PDType1Font.HELVETICA;
            }
            
            float fontSize = textState.getFontSize();
            Matrix parameters = new Matrix(fontSize, 0, 0, fontSize, 0, 0);
            Matrix textMatrix = state.getTextMatrix();
            Matrix ctm = state.getCurrentTransformationMatrix();
            Matrix textRenderingMatrix = parameters.multiply(textMatrix).multiply(ctm);
            
            InputStream in = new ByteArrayInputStream(string);
            while (in.available() > 0) {
                int before = in.available();
                int code = font.readCode(in);
                Vector w = font.getDisplacement(code);
                
                showGlyph(textRenderingMatrix, font, code, w);
                break; // Just process first character
            }
        }
    }
    
    // Simple GlyphCache stub
    private static class GlyphCache {
        public GlyphCache(PDVectorFont font) {
        }
        
        public GeneralPath getPathForCharacterCode(int code) {
            GeneralPath path = new GeneralPath();
            path.moveTo(0, 0);
            path.lineTo(10, 0);
            path.lineTo(10, 10);
            path.lineTo(0, 10);
            path.closePath();
            return path;
        }
    }
}

