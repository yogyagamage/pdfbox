        // Create a COSStream that will be used as the shading dictionary
        COSStream stream = new COSStream();
        // Set required entries for a Type 5 shading
        stream.setInt(COSName.SHADING_TYPE, 5);
        stream.setInt(COSName.BITS_PER_COORDINATE, 8);
        stream.setInt(COSName.BITS_PER_COMPONENT, 8);
        stream.setInt(COSName.VERTICES_PER_ROW, 2);
        
        // Create decode array: [xmin xmax ymin ymax c1min c1max ...]
        COSArray decode = new COSArray();
        decode.add(COSInteger.ZERO);
        decode.add(COSInteger.get(255));
        decode.add(COSInteger.ZERO);
        decode.add(COSInteger.get(255));
        decode.add(COSInteger.ZERO);
        decode.add(COSInteger.get(255));
        stream.setItem(COSName.DECODE, decode);
        
        // Provide some stream data that can be read by collectTriangles
        // Need at least 2 rows * 2 vertices per row = 4 vertices
        // Each vertex: 8 bits x, 8 bits y, 8 bits color = 3 bytes per vertex
        // 4 vertices = 12 bytes total
        byte[] vertexData = new byte[] {
            0x00, 0x00, 0x00,  // vertex 1: x=0, y=0, color=0
            0x40, 0x40, 0x40,  // vertex 2: x=64, y=64, color=64
            0x80, 0x80, 0x80,  // vertex 3: x=128, y=128, color=128
            0xC0, 0xC0, 0xC0   // vertex 4: x=192, y=192, color=192
        };
        stream.createOutputStream().write(vertexData);
        
        // Create concrete subclass instance (PDShadingType5 extends PDTriangleBasedShadingType)
