    Filter ccittFax = new CCITTFaxFilter();
    Filter lzw = new LZWFilter();
    Filter asciiHex = new ASCIIHexFilter();
    Filter ascii85 = new ASCII85Filter();
    Filter runLength = new RunLengthDecodeFilter();
