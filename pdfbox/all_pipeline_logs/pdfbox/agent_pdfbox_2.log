package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject;
import org.apache.pdfbox.pdmodel.graphics.image.CustomFactory;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayOutputStream;
import java.io.DataOutputStream;
import java.io.IOException;

public class PDImageXObject_PNGConverterbuildImageObject_LogdebugFikaTest {

    @Test
    public void testCreateFromByteArrayTriggersLogDebug() throws IOException {
        // Create a minimal valid PNG that will pass initial checks but fail in buildImageObject
        // PNG signature + IHDR chunk + gAMA chunk with gamma != 1/2.2 + IDAT chunk + IEND chunk
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        DataOutputStream dos = new DataOutputStream(baos);
        
        // PNG signature
        dos.write(new byte[]{(byte) 137, 80, 78, 71, 13, 10, 26, 10});
        
        // IHDR chunk (13 bytes data)
        int width = 1;
        int height = 1;
        int bitDepth = 8;
        int colorType = 2; // Truecolor
        int compressionMethod = 0;
        int filterMethod = 0;
        int interlaceMethod = 0;
        
        // Write IHDR chunk length (13)
        dos.writeInt(13);
        // Write chunk type "IHDR"
        dos.writeBytes("IHDR");
        // Write IHDR data
        dos.writeInt(width);
        dos.writeInt(height);
        dos.write(bitDepth);
        dos.write(colorType);
        dos.write(compressionMethod);
        dos.write(filterMethod);
        dos.write(interlaceMethod);
        // Write CRC for IHDR (dummy value - will be recalculated)
        dos.writeInt(0x12345678);
        
        // gAMA chunk (4 bytes data) with gamma = 1.0 (not 1/2.2)
        // gamma = 1.0 means stored value = 1/1.0 * 100000 = 100000
        int gammaValue = 100000; // 1.0 gamma
        // Write gAMA chunk length (4)
        dos.writeInt(4);
        // Write chunk type "gAMA"
        dos.writeBytes("gAMA");
        // Write gamma value
        dos.writeInt(gammaValue);
        // Write CRC for gAMA (dummy value)
        dos.writeInt(0x23456789);
        
        // IDAT chunk (minimal valid data for 1x1 RGB image)
        // 1 scanline: filter byte + 3 color bytes
        byte[] idatData = new byte[]{0, 100, 100, 100};
        // Write IDAT chunk length
        dos.writeInt(idatData.length);
        // Write chunk type "IDAT"
        dos.writeBytes("IDAT");
        // Write compressed data (using raw deflate format with no compression)
        // Deflate block: BFINAL=1, BTYPE=00 (no compression)
        dos.write(0x01); // BFINAL=1, BTYPE=00
        // LEN = 4, NLEN = ~4
        dos.writeShort(4); // LEN
        dos.writeShort(~4); // NLEN
        // Write the actual image data
        dos.write(idatData);
        // Write CRC for IDAT (dummy value)
        dos.writeInt(0x34567890);
        
        // IEND chunk (0 bytes data)
        dos.writeInt(0);
        dos.writeBytes("IEND");
        dos.writeInt(0x45678901); // CRC
        
        dos.flush();
        byte[] pngBytes = baos.toByteArray();
        
        // Create a mock PDDocument
        PDDocument mockDocument = Mockito.mock(PDDocument.class);
        
        // Create a mock CustomFactory (not used for PNG path but required by method signature)
        CustomFactory mockCustomFactory = Mockito.mock(CustomFactory.class);
        
        // Call the entry point method
        PDImageXObject.createFromByteArray(mockDocument, pngBytes, "test.png", mockCustomFactory);
    }
}

