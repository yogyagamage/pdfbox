    boolean noAntiAlias = (isRectangular(linePath) && (bounds.getWidth() > 1)) && (bounds.getHeight() > 1);
    if (noAntiAlias) {
        graphics.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_OFF);
