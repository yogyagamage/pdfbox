import java.io.IOException;
import java.io.InputStream;

class PDFParser_COSParservalidateStreamLength_LogdebugFikaTest {

    @Test
    void testParseTriggersLogDebug() throws IOException {
        // Create a minimal PDF content that will trigger the desired call chain
        byte[] pdfBytes = (
                "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<< /Length 0 >>\n" +
                "stream\n" +
                "endstream\n" +
                "endobj\n" +
                "trailer\n" +
                "<< /Root 1 0 R >>\n" +
                "startxref\n" +
                "0\n" +
                "%%EOF"
        ).getBytes();

        RandomAccessRead source = new RandomAccessRead() {
            private int position = 0;
            private final byte[] data = pdfBytes;

            @Override
            public int read() throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                return data[position++] & 0xFF;
            }

            @Override
            public int read(byte[] b, int off, int len) throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                int bytesToRead = Math.min(len, data.length - position);
                System.arraycopy(data, position, b, off, bytesToRead);
                position += bytesToRead;
                return bytesToRead;
            }

            @Override
            public long getPosition() throws IOException {
                return position;
            }

            @Override
            public void seek(long pos) throws IOException {
                position = (int) pos;
            }

            @Override
            public long length() throws IOException {
                return data.length;
            }

            @Override
            public boolean isClosed() {
                return false;
            }

            @Override
            public void close() throws IOException {
                // no-op
            }

            @Override
            public int peek() throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                return data[position] & 0xFF;
            }

            @Override
            public void rewind(int bytes) throws IOException {
                position = Math.max(0, position - bytes);
            }

            @Override
            public RandomAccessReadView createView(long startPosition, long streamLength) throws IOException {
                throw new UnsupportedOperationException();
            }

            @Override
            public boolean isEOF() throws IOException {
                return position >= data.length;
            }
        };

        // Mock the stream cache function to avoid NPE
        RandomAccessStreamCache.StreamCacheCreateFunction streamCacheCreateFunction = 
            Mockito.mock(RandomAccessStreamCache.StreamCacheCreateFunction.class);
        Mockito.when(streamCacheCreateFunction.create()).thenReturn(Mockito.mock(RandomAccessStreamCache.class));

        // Create parser with lenient mode to allow stream length 0
        PDFParser parser = new PDFParser(source, "", null, null, streamCacheCreateFunction);
        
        // This should trigger the call chain ending in Log.debug()
        parser.parse(true);
    }
}

