            (byte)0xE6, 0x27, 0x3E, (byte)0x9C // CRC (dummy)
        };
        
        // IEND chunk
        byte[] iendData = new byte[] {
            0x00, 0x00, 0x00, 0x00, // chunk length: 0
            0x49, 0x45, 0x4E, 0x44, // "IEND"
            (byte)0xAE, 0x42, 0x60, (byte)0x82 // CRC (dummy)
        };
        
        // Combine all chunks
