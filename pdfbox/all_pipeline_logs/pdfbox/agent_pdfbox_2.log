        String base64Appearance = java.util.Base64.getEncoder().encodeToString(appearanceXML.getBytes());
        appearanceElement.setTextContent(base64Appearance);
        mainElement.appendChild(appearanceElement);
        
        // Instantiate using the constructor that takes Element parameter
        // This will trigger the full call chain including Log.debug in parseArrayElement
        FDFAnnotationStamp stamp = new FDFAnnotationStamp(mainElement);
    }
}

