    void testDrawImageTriggersLogWarn() throws IOException {
        // Create a mock PageDrawerParameters
        PageDrawerParameters parameters = mock(PageDrawerParameters.class);
        PDPage page = new PDPage();
        when(parameters.getPage()).thenReturn(page);
        when(parameters.getRenderer()).thenReturn(mock(PDFRenderer.class));
        when(parameters.isSubsamplingAllowed()).thenReturn(false);
        when(parameters.getDestination()).thenReturn(RenderDestination.EXPORT);
        when(parameters.getRenderingHints()).thenReturn(new RenderingHints(null));
        when(parameters.getImageDownscalingOptimizationThreshold()).thenReturn(0.5f);

        // Instantiate PageDrawer using the constructor
        PageDrawer drawer = new PageDrawer(parameters);

        // Set up the graphics context
        BufferedImage bufferedImage = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = bufferedImage.createGraphics();
        drawer.drawPage(graphics, new PDRectangle(100, 100));

        // Create a PDImage that is a stencil and has a pattern color space
        PDImage pdImage = mock(PDImage.class);
        when(pdImage.isStencil()).thenReturn(true);
        when(pdImage.getInterpolate()).thenReturn(false);
        when(pdImage.getImage()).thenReturn(new BufferedImage(10, 10, BufferedImage.TYPE_BYTE_BINARY));

        // Create a pattern color space for non-stroking color
        PDPattern patternColorSpace = mock(PDPattern.class);
        PDTilingPattern tilingPattern = mock(PDTilingPattern.class);
        when(tilingPattern.getXStep()).thenReturn(0.0f); // This will trigger the log warning
        when(tilingPattern.getYStep()).thenReturn(1.0f);
        when(tilingPattern.getBBox()).thenReturn(new PDRectangle(0, 0, 10, 10));
        when(tilingPattern.getPaintType()).thenReturn(PDTilingPattern.PAINT_COLORED);
        when(tilingPattern.getMatrix()).thenReturn(new org.apache.pdfbox.util.Matrix());
        when(patternColorSpace.getPattern(null)).thenReturn(tilingPattern);

        PDColor patternColor = mock(PDColor.class);
        when(patternColor.getColorSpace()).thenReturn(patternColorSpace);

        // Mock the graphics state to return the pattern color
        PDGraphicsState graphicsState = mock(PDGraphicsState.class);
        when(graphicsState.getNonStrokingColor()).thenReturn(patternColor);
        when(graphicsState.getNonStrokingJavaComposite()).thenReturn(AlphaComposite.getInstance(AlphaComposite.SRC_OVER));
        when(graphicsState.getSoftMask()).thenReturn(null);
        when(graphicsState.getCurrentTransformationMatrix())
