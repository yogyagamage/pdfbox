class PDTextField_BaseParsermethod_LogwarnFikaTest {

    @Test
    void testSetValueTriggersLogWarn() throws IOException {
        // Create minimal PDAcroForm with required resources
        PDAcroForm acroForm = new PDAcroForm(null);
        
        // Create PDResources with a font to avoid "Could not find font" error
        PDResources resources = new PDResources();
        PDFont font = PDType1Font.HELVETICA;
        resources.put(COSName.getPDFName("Helv"), font);
        acroForm.setDefaultResources(resources);
        
        // Create field dictionary with required DA entry
        COSDictionary fieldDict = new COSDictionary();
        fieldDict.setItem(COSName.DA, new COSString("/Helv 12 Tf 0 g"));
        fieldDict.setItem(COSName.FT, COSName.TX);
        
        // Create PDTextField using the constructor that accepts field dictionary
        PDTextField textField = new PDTextField(acroForm, fieldDict, null);
        
        // Set a field name to avoid NPE in error message
        textField.setPartialName("TestField");
        
        // This should trigger the static initializer of BaseParser which logs the warning
        textField.setValue("Test Value");
    }
}

