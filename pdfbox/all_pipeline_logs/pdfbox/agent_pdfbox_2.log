        // This ensures setValue(int) will work with export values
        button.setFieldFlag(PDButton.FLAG_RADIO, true);
        button.setFieldFlag(PDButton.FLAG_PUSHBUTTON, false);
        button.setFieldFlag(PDButton.FLAG_RADIOS_IN_UNISON, false);
        
        // Add export values to make setValue(int) work
