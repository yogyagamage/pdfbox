import org.apache.commons.logging.Log;
import org.apache.fontbox.ttf.FontHeaders;
import org.apache.fontbox.ttf.OTFParser;
import org.apache.fontbox.ttf.TTFParser;
import org.apache.fontbox.util.autodetect.FontFileFinder;
import org.apache.pdfbox.io.RandomAccessReadBufferedFile;
import org.apache.pdfbox.pdmodel.font.FileSystemFontProvider.FSFontInfo;
import org.junit.jupiter.api.Test;
import java.io.File;
import java.io.IOException;
import java.net.URI;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.List;

public class FontMapperImpl_FileSystemFontProvideraddTrueTypeFontImpl_LogwarnFikaTest {

    @Test
    public void testGetProviderTriggersLogWarn() throws Exception {
        FontMapperImpl fontMapper = new FontMapperImpl();
        
        FontProvider provider = fontMapper.getProvider();
        
        FileSystemFontProvider fileSystemProvider = (FileSystemFontProvider) provider;
        
        List<File> fontFiles = new ArrayList<>();
        File tempFontFile = createTempFontFileWithPipeInName();
        fontFiles.add(tempFontFile);
        
        try {
            java.lang.reflect.Method scanFontsMethod = FileSystemFontProvider.class
                    .getDeclaredMethod("scanFonts", List.class);
            scanFontsMethod.setAccessible(true);
            scanFontsMethod.invoke(fileSystemProvider, fontFiles);
        } finally {
            tempFontFile.delete();
        }
    }

    private File createTempFontFileWithPipeInName() throws IOException {
        File tempFile = File.createTempFile("testFont|WithPipe", ".ttf");
        tempFile.deleteOnExit();
        
        byte[] fakeFontData = createFakeFontDataWithPipeInName();
        Files.write(tempFile.toPath(), fakeFontData);
        
        return tempFile;
    }

    private byte[] createFakeFontDataWithPipeInName() {
        byte[] data = new byte[1024];
        
        data[0] = 0x00; // version
        data[1] = 0x01;
        data[2] = 0x00;
        data[3] = 0x00;
        
        data[4] = 0x00; // numTables
        data[5] = 0x01;
        
        data[12] = 'n'; // "name" table tag
        data[13] = 'a';
        data[14] = 'm';
        data[15] = 'e';
        
        data[16] = 0x00; // checksum
        data[17] = 0x00;
        data[18] = 0x00;
        data[19] = 0x00;
        
        data[20] = 0x00; // offset
        data[21] = 0x00;
        data[22] = 0x04;
        data[23] = 0x00;
        
        data[24] = 0x00; // length
        data[25] = 0x00;
        data[26] = 0x01;
        data[27] = 0x00;
        
        int nameTableOffset = 0x400;
        data[nameTableOffset] = 0x00; // format
        data[nameTableOffset + 1] = 0x00;
        
        data[nameTableOffset + 2] = 0x00; // count
        data[nameTableOffset + 3] = 0x01;
        
        data[nameTableOffset + 4] = 0x00; // stringOffset
        data[nameTableOffset + 5] = 0x06;
        
        data[nameTableOffset + 6] = 0x00; // platformID (Unicode)
        data[nameTableOffset + 7] = 0x03;
        
        data[nameTableOffset + 8] = 0x00; // encodingID (Unicode 2.0)
        data[nameTableOffset + 9] = 0x01;
        
        data[nameTableOffset + 10] = 0x00; // languageID (English)
        data[nameTableOffset + 11] = 0x09;
        
        data[nameTableOffset + 12] = 0x00; // nameID (PostScript name = 6)
        data[nameTableOffset + 13] = 0x06;
        
        data[nameTableOffset + 14] = 0x00; // length
        data[nameTableOffset + 15] = 0x14;
        
        data[nameTableOffset + 16] = 0x00; // offset
        data[nameTableOffset + 17] = 0x00;
        
        int stringOffset = nameTableOffset + 18;
        String postScriptName = "Test|Font|Name";
        byte[] nameBytes = postScriptName.getBytes(java.nio.charset.StandardCharsets.UTF_16BE);
        System.arraycopy(nameBytes, 0, data, stringOffset, Math.min(nameBytes.length, data.length - stringOffset));
        
        return data;
    }
}

