import org.apache.pdfbox.io.RandomAccessRead;
import org.apache.pdfbox.io.RandomAccessStreamCache;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.InputStream;

public class PDFParser_COSParserparseXref_LogerrorFikaTest {

    private static class SimpleRandomAccessRead implements RandomAccessRead {
        private byte[] data;
        private long position = 0;
        
        public SimpleRandomAccessRead(byte[] data) {
            this.data = data;
        }
        
        @Override
        public void close() throws IOException {
            // No-op
        }
        
        @Override
        public int read() throws IOException {
            if (position >= data.length) {
                return -1;
            }
            return data[(int) position++] & 0xFF;
        }
        
        @Override
        public int read(byte[] b, int off, int len) throws IOException {
            if (position >= data.length) {
                return -1;
            }
            int bytesToRead = (int) Math.min(len, data.length - position);
            System.arraycopy(data, (int) position, b, off, bytesToRead);
            position += bytesToRead;
            return bytesToRead;
        }
        
        @Override
        public long getPosition() throws IOException {
            return position;
        }
        
        @Override
        public void seek(long position) throws IOException {
            this.position = position;
        }
        
        @Override
        public long length() throws IOException {
            return data.length;
        }
        
        @Override
        public RandomAccessReadView createView(long startOffset, long streamLength) throws IOException {
            return new RandomAccessReadView(this, startOffset, streamLength);
        }
        
        @Override
        public boolean isClosed() {
            return false;
        }
        
        @Override
        public boolean isEOF() throws IOException {
            return position >= data.length;
        }
        
        @Override
        public int peek() throws IOException {
            if (position >= data.length) {
                return -1;
            }
            return data[(int) position] & 0xFF;
        }
        
        @Override
        public void rewind(int bytes) throws IOException {
            position = Math.max(0, position - bytes);
        }
        
        @Override
        public byte[] readFully(int length) throws IOException {
            byte[] result = new byte[length];
            int bytesRead = read(result, 0, length);
            if (bytesRead < length) {
                byte[] trimmed = new byte[bytesRead];
                System.arraycopy(result, 0, trimmed, 0, bytesRead);
                return trimmed;
            }
            return result;
        }
        
        @Override
        public int available() throws IOException {
            return (int) Math.max(0, data.length - position);
        }
    }

    @Test
    public void testParsePathToLogError() throws IOException {
        // Create a minimal PDF that will trigger the error path in parseXref
        // PDF header + some data that will cause parseXref to fail and trigger LOG.error
        String pdfContent = "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<< /Type /Catalog /Pages 2 0 R >>\n" +
                "endobj\n" +
                "2 0 obj\n" +
                "<< /Type /Pages /Kids [] /Count 0 >>\n" +
                "endobj\n" +
                "xref\n" +
                "0 3\n" +
                "0000000000 65535 f \n" +
                "0000000010 00000 n \n" +
                "0000000050 00000 n \n" +
                "trailer\n" +
                "<< /Size 3 /Root 1 0 R /Prev 0 >>\n" +
                "startxref\n" +
                "100\n" +
                "%%EOF";
        
        byte[] pdfBytes = pdfContent.getBytes();
        SimpleRandomAccessRead source = new SimpleRandomAccessRead(pdfBytes);
        
        // Create PDFParser instance using the simplest constructor
        PDFParser parser = new PDFParser(source, "");
        
        // Call parse with lenient=true to ensure LOG.error is called instead of throwing exception
        parser.parse(true);
    }
}

