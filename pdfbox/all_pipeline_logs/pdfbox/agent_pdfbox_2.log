        // and exceptions are caught and logged with debug
        parser.parse(true);
    }
    
    // Simple implementation of RandomAccessRead without anonymous inner class
    static class SimpleRandomAccessRead implements RandomAccessRead {
        private final byte[] data;
        private int position;
        private boolean closed;
        
        SimpleRandomAccessRead(byte[] data) {
            this.data = data;
            this.position = 0;
            this.closed = false;
        }
        
        public void close() throws IOException {
            closed = true;
        }
        
        public int read() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            if (position >= data.length) {
                return -1;
            }
            return data[position++] & 0xFF;
        }
        
        public int read(byte[] b, int off, int len) throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            if (position >= data.length) {
                return -1;
            }
            int bytesToRead = Math.min(len, data.length - position);
            System.arraycopy(data, position, b, off, bytesToRead);
            position += bytesToRead;
            return bytesToRead;
        }
        
        public long getPosition() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            return position;
        }
        
        public void seek(long position) throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            if (position < 0 || position > data.length) {
                throw new IOException("Invalid position");
            }
            this.position = (int) position;
        }
        
        public long length() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            return data.length;
        }
        
        public boolean isClosed() {
            return closed;
        }
        
        public RandomAccessReadView createView(long startOffset, long streamLength) throws IOException {
            throw new IOException("Not implemented");
        }
        
        public int peek() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
