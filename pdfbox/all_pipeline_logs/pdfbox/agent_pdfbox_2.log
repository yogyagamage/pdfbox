        // Set up graphics context
        BufferedImage image = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = image.createGraphics();
        pageDrawer.drawPage(graphics, new PDRectangle(100, 100));

        // Create a PDTilingPattern with XStep = 0 to trigger the warning
        PDTilingPattern tilingPattern = mock(PDTilingPattern.class);
        when(tilingPattern.getPaintType()).thenReturn(PDTilingPattern.PAINT_COLORED);
        when(tilingPattern.getXStep()).thenReturn(0f);
        when(tilingPattern.getYStep()).thenReturn(10f);
        when(tilingPattern.getBBox()).thenReturn(new PDRectangle(0, 0, 100, 100));
        when(tilingPattern.getMatrix()).thenReturn(new org.apache.pdfbox.util.Matrix());

        // Create a PDColor with PDPattern color space
        PDColor color = mock(PDColor.class);
