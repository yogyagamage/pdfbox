package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

public class PDImageXObject_PNGConvertercreateCOSStreamwithIccProfile_LogerrorFikaTest {

    @Test
    public void testCreateFromByteArrayTriggersLogError() throws IOException {
        // Create a minimal PNG that will trigger the error path in createCOSStreamwithIccProfile
        byte[] pngBytes = createInvalidPNGWithBadICCProfile();
        
        try (PDDocument document = new PDDocument()) {
            // Call the entry point method
            PDImageXObject.createFromByteArray(document, pngBytes, "test.png", null);
        }
    }

    private byte[] createInvalidPNGWithBadICCProfile() {
        // PNG signature
        byte[] pngSignature = new byte[] {
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk: width=1, height=1, bit depth=8, color type=2 (Truecolor)
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x01, // width
            0x00, 0x00, 0x00, 0x01, // height
            0x08, // bit depth
            0x02, // color type (Truecolor)
            0x00, // compression method
            0x00, // filter method
            0x00  // interlace method
        };
        byte[] ihdrChunk = createChunk("IHDR", ihdrData);
        
        // Create an iCCP chunk with invalid structure (too few bytes after name)
        // The name "ICC" followed by null terminator (4 bytes total), then compression method (1 byte)
        // Total length = 5 bytes, which is less than the required data after name
        byte[] iccpData = new byte[] {
            'I', 'C', 'C', 0, // name with null terminator
            0 // compression method
            // No actual profile data - this makes iccProfileDataStart >= state.iCCP.length
            // which triggers the LOG.error("Invalid iCCP chunk, to few bytes")
        };
        byte[] iccpChunk = createChunk("iCCP", iccpData);
        
        // IDAT chunk with minimal valid data for 1x1 RGB image
        byte[] idatData = new byte[] {
            0x00, // filter type
            0x00, 0x00, 0x00 // RGB pixel (black)
        };
        byte[] idatChunk = createChunk("IDAT", idatData);
        
        // IEND chunk
        byte[] iendChunk = createChunk("IEND", new byte[0]);
        
        // Combine all chunks
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        try {
            baos.write(pngSignature);
            baos.write(ihdrChunk);
            baos.write(iccpChunk);
            baos.write(idatChunk);
            baos.write(iendChunk);
        } catch (IOException e) {
            // Should not happen with ByteArrayOutputStream
        }
        
        return baos.toByteArray();
    }

    private byte[] createChunk(String type, byte[] data) {
        ByteArrayOutputStream chunk = new ByteArrayOutputStream();
        
        // Write length (4 bytes, big-endian)
        int length = data.length;
        chunk.write((length >> 24) & 0xFF);
        chunk.write((length >> 16) & 0xFF);
        chunk.write((length >> 8) & 0xFF);
        chunk.write(length & 0xFF);
        
        // Write chunk type
        try {
            chunk.write(type.getBytes("ASCII"));
            // Write data
            chunk.write(data);
            
            // Calculate CRC (simplified - using dummy CRC for test)
            int crc = 0x12345678; // Dummy CRC
            chunk.write((crc >> 24) & 0xFF);
            chunk.write((crc >> 16) & 0xFF);
            chunk.write((crc >> 8) & 0xFF);
            chunk.write(crc & 0xFF);
        } catch (IOException e) {
            // Should not happen with ByteArrayOutputStream
        }
        
        return chunk.toByteArray();
    }
}

