        setStrokingColor(pageDrawer, color);
        
        // Create a line path so strokePath() has something to draw
        pageDrawer.moveTo(10, 10);
        pageDrawer.lineTo(50, 50);
        
        // Call the entry point method
        pageDrawer.strokePath();
        
        // Cleanup
        graphics.dispose();
        document.close();
    }
    
    private PageDrawerParameters createPageDrawerParameters(PDFRenderer renderer, PDPage page) throws Exception {
        // Use reflection to create PageDrawerParameters since constructor is package-private
        Class<?> paramsClass = Class.forName("org.apache.pdfbox.rendering.PageDrawerParameters");
        java.lang.reflect.Constructor<?> constructor = paramsClass.getDeclaredConstructor(
            PDPage.class, PDFRenderer.class, org.apache.pdfbox.rendering.RenderDestination.class,
            java.awt.RenderingHints.class, float.class, boolean.class
        );
