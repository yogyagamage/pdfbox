public class PDFStreamEngine_BaseParsermethod_LogwarnFikaTest5 {

    @Test
    public void testShowTextStringTriggersBaseParserStaticLogWarn() throws IOException {
        PDFStreamEngine engine = new PDFStreamEngine();
        
        PDPage page = new PDPage();
        engine.processPage(page);
        
        PDType3Font type3Font = createType3Font();
        PDType3CharProc charProc = createType3CharProc();
        
        COSDictionary fontDict = new COSDictionary();
        fontDict.setItem(COSName.SUBTYPE, COSName.TYPE3);
        fontDict.setItem(COSName.FONT_BBOX, new PDRectangle(0, 0, 100, 100).getCOSArray());
        fontDict.setItem(COSName.FONT_MATRIX, new Matrix().getCOSArray());
        fontDict.setItem(COSName.CHAR_PROCS, new COSDictionary());
        
        PDResources resources = new PDResources();
        resources.getCOSObject().setItem(COSName.FONT, new COSDictionary());
        
        PDFont font = PDFont.createFont(fontDict, resources);
        
        byte[] textBytes = new byte[] { 65 };
        
        engine.showTextString(textBytes);
    }
    
    private PDType3Font createType3Font() {
        COSDictionary fontDict = new COSDictionary();
        fontDict.setItem(COSName.SUBTYPE, COSName.TYPE3);
        fontDict.setItem(COSName.FONT_BBOX, new PDRectangle(0, 0, 100, 100).getCOSArray());
        fontDict.setItem(COSName.FONT_MATRIX, new Matrix().getCOSArray());
        
        COSDictionary charProcsDict = new COSDictionary();
        fontDict.setItem(COSName.CHAR_PROCS, charProcsDict);
        
        PDResources resources = new PDResources();
        return new PDType3Font(fontDict, resources);
    }
    
    private PDType3CharProc createType3CharProc() {
        COSStream stream = new COSStream();
        try {
            stream.createUnfilteredStream().write("0 0 0 0 0 0 d1".getBytes());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
        
        COSDictionary charProcDict = new COSDictionary();
        charProcDict.setItem(COSName.TYPE, COSName.STREAM);
        charProcDict.setItem(COSName.SUBTYPE, COSName.FORM);
        charProcDict.setItem(COSName.BBOX, new PDRectangle(0, 0, 10, 10).getCOSArray());
        charProcDict.setItem(COSName.MATRIX, new Matrix().getCOSArray());
        
        PDResources resources = new PDResources();
        return new PDType3CharProc(stream, resources);
    }
}

