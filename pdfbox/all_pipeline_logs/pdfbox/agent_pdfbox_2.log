                    uris.add(tempPfbFile.toUri());
                    return uris;
                }
            };
            
            // Create FontMapperImpl instance using default constructor
            FontMapperImpl fontMapper = new FontMapperImpl();
            
            // Get provider - this will trigger the full chain
            fontMapper.getProvider();
            
        } finally {
            // Clean up temporary file
            Files.deleteIfExists(tempPfbFile);
        }
    }
