        PageDrawerParameters parameters = mock(PageDrawerParameters.class);
        when(parameters.getPage()).thenReturn(page);
        when(parameters.getRenderer()).thenReturn(mock(PDFRenderer.class));
        when(parameters.isSubsamplingAllowed()).thenReturn(false);
        when(parameters.getDestination()).thenReturn(RenderDestination.EXPORT);
        when(parameters.getRenderingHints()).thenReturn(new RenderingHints(new HashMap<>()));
        when(parameters.getImageDownscalingOptimizationThreshold()).thenReturn(0.5f);

        // Instantiate PageDrawer using the provided constructor
