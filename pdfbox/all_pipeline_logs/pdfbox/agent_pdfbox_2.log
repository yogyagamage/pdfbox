class PageDrawer_TilingPaintgetAnchorRect_LogwarnFikaTest {

    @Test
    void testStrokePathTriggersLogWarn() throws Exception {
        // Create minimal required objects
        PDDocument document = new PDDocument();
        PDPage page = new PDPage(PDRectangle.A4);
        document.addPage(page);
        
        // Create a PDFRenderer (required for PageDrawerParameters)
