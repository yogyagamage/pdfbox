    // Real implementation of RandomAccessRead without anonymous inner class
    private static class SimpleRandomAccessRead implements RandomAccessRead {
        private final byte[] data;
        private int position;
        private boolean closed;

        public SimpleRandomAccessRead(byte[] data) {
            this.data = data;
            this.position = 0;
            this.closed = false;
        }

        public int read() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            if (position >= data.length) {
                return -1;
            }
            return data[position++] & 0xFF;
        }

        public int read(byte[] b, int off, int len) throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            if (position >= data.length) {
                return -1;
            }
            int bytesToRead = Math.min(len, data.length - position);
            System.arraycopy(data, position, b, off, bytesToRead);
            position += bytesToRead;
            return bytesToRead;
        }

        public long getPosition() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            return position;
        }

        public void seek(long position) throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            if (position < 0 || position > data.length) {
                throw new IOException("Invalid seek position");
            }
            this.position = (int) position;
        }

        public long length() throws IOException {
            if (closed) {
                throw new IOException("Stream closed");
            }
            return data.length;
        }

        public boolean isClosed() {
            return closed;
        }

        public void close() throws IOException {
            closed = true;
        }

        public RandomAccessRead createView(long startPosition, long streamLength) throws IOException {
            throw new IOException("createView not implemented");
        }
    }
