package org.apache.pdfbox.pdmodel.interactive.form;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.form.PDAcroForm;
import org.apache.pdfbox.pdmodel.interactive.form.PDButton;
import org.apache.pdfbox.pdmodel.interactive.form.PDNonTerminalField;
import org.junit.jupiter.api.Test;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

public class PDButton_AppearanceGeneratorHelpermethod_LogFactorygetLogFikaTest {

    @Test
    public void testSetValueTriggersLogFactoryGetLog() throws IOException {
        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // Create a real PDAcroForm
        PDAcroForm acroForm = new PDAcroForm(document);
        
        // Create a COSDictionary for the button field
        COSDictionary fieldDict = new COSDictionary();
        fieldDict.setItem(COSName.FT, COSName.BTN);
        
        // Set export values to make setValue(int) work
        COSDictionary optDict = new COSDictionary();
        List<String> exportValues = new ArrayList<>();
        exportValues.add("Export1");
        exportValues.add("Export2");
