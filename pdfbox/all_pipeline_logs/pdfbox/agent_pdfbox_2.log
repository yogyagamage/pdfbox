        // We need enough bits to satisfy the readVertex method:
        // bitsPerCoordinate * 2 + bitsPerColorComponent * numberOfColorComponents
        // Let's set bitsPerCoordinate = 8, bitsPerColorComponent = 8, numberOfColorComponents = 3
        // Total bits per vertex = 8*2 + 8*3 = 40 bits = 5 bytes
        // We need at least one vertex, so 5 bytes minimum
        byte[] data = new byte[] {
            (byte) 0x7F, // x coordinate (8 bits)
            (byte) 0x7F, // y coordinate (8 bits)
            (byte) 0x7F, // color component 1 (8 bits)
            (byte) 0x7F, // color component 2 (8 bits)
