public class PublicKeySecurityHandlercomputeRecipientInfo_KeyTransRecipientInfomethodFikaTest {

    static {
        Security.addProvider(new BouncyCastleProvider());
    }

    @Test
    public void testPrepareDocumentForEncryption() throws Exception {
        PublicKeyProtectionPolicy protectionPolicy = createPublicKeyProtectionPolicy();
        PublicKeySecurityHandler handler = new PublicKeySecurityHandler(protectionPolicy);
        
        PDDocument document = new PDDocument();
        try {
            handler.prepareDocumentForEncryption(document);
        } finally {
            document.close();
        }
    }

    private PublicKeyProtectionPolicy createPublicKeyProtectionPolicy() throws Exception {
        KeyPairGenerator keyPairGenerator = KeyPairGenerator.getInstance("RSA");
        keyPairGenerator.initialize(2048);
        KeyPair keyPair = keyPairGenerator.generateKeyPair();
        
        X509Certificate certificate = generateSelfSignedCertificate(keyPair);
        
        List<PublicKeyRecipient> recipients = new ArrayList<>();
        recipients.add(new SimplePublicKeyRecipient(certificate, AccessPermission.getOwner()));
        
        return new SimplePublicKeyProtectionPolicy(recipients);
    }

    private X509Certificate generateSelfSignedCertificate(KeyPair keyPair) throws Exception {
        X500Principal issuer = new X500Principal("CN=Test");
        BigInteger serial = BigInteger.valueOf(System.currentTimeMillis());
        Date notBefore = new Date(System.currentTimeMillis() - 1000L * 60 * 60 * 24 * 30);
        Date notAfter = new Date(System.currentTimeMillis() + 1000L * 60 * 60 * 24 * 365);
        
        X509v3CertificateBuilder certBuilder = new JcaX509v3CertificateBuilder(
                issuer,
                serial,
                notBefore,
                notAfter,
                issuer,
                keyPair.getPublic()
        );
        
        return new JcaX509CertificateConverter()
                .setProvider("BC")
                .getCertificate(certBuilder.build(
                        new JcaContentSignerBuilder("SHA256withRSA")
                                .setProvider("BC")
                                .build(keyPair.getPrivate())
                ));
    }

    private static class SimplePublicKeyProtectionPolicy extends PublicKeyProtectionPolicy {
        private final List<PublicKeyRecipient> recipients;

        public SimplePublicKeyProtectionPolicy(List<PublicKeyRecipient> recipients) {
            this.recipients = recipients;
        }

        public int getNumberOfRecipients() {
            return recipients.size();
        }

        public Iterator<PublicKeyRecipient> getRecipientsIterator() {
            return recipients.iterator();
        }
    }

    private static class SimplePublicKeyRecipient implements PublicKeyRecipient {
        private final X509Certificate certificate;
        private final AccessPermission permission;

        public SimplePublicKeyRecipient(X509Certificate certificate, AccessPermission permission) {
            this.certificate = certificate;
            this.permission = permission;
        }

        public X509Certificate getX509() {
            return certificate;
        }

        public AccessPermission getPermission() {
            return permission;
        }
    }
}

