import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.cos.COSArray;
import org.apache.pdfbox.pdmodel.PDResources;
import org.apache.pdfbox.filter.FilterFactory;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

class PDInlineImage_JBIG2Filtermethod_LogFactorygetLogFikaTest {

    @Test
    void testCreateInputStreamTriggersJBIG2FilterStaticInitializer() throws IOException {
        // Create minimal parameters dictionary
        COSDictionary parameters = new COSDictionary();
        
        // Set up parameters to trigger JBIG2Filter usage
        // We need to set filters to include JBIG2_DECODE
        COSArray filtersArray = new COSArray();
        filtersArray.add(COSName.JBIG2_DECODE);
        parameters.setItem(COSName.F, filtersArray);
        
        // Set required parameters for JBIG2 filter
        parameters.setInt(COSName.W, 10);
        parameters.setInt(COSName.H, 10);
        parameters.setInt(COSName.BPC, 1);
        
        // Create empty image data (JBIG2 filter will fail but static initializer already ran)
        byte[] imageData = new byte[0];
        
        // Mock resources to avoid NPE
        PDResources resources = Mockito.mock(PDResources.class);
        
        // Create PDInlineImage instance
        PDInlineImage inlineImage = new PDInlineImage(parameters, imageData, resources);
        
        // Set filters to include JBIG2_DECODE for createInputStream
        List<String> filters = new ArrayList<>();
        filters.add("JBIG2Decode");
        inlineImage.setFilters(filters);
        
        // Create stop filters list that doesn't contain JBIG2Decode
        List<String> stopFilters = new ArrayList<>();
        
        // This will trigger FilterFactory.INSTANCE initialization,
        // which creates JBIG2Filter instance, triggering its static initializer
        // which calls LogFactory.getLog(JBIG2Filter.class)
        try {
            inlineImage.createInputStream(stopFilters);
        } catch (IOException e) {
            // Expected - JBIG2 filter will fail with empty data
            // But static initializer has already been triggered
        }
    }
}

