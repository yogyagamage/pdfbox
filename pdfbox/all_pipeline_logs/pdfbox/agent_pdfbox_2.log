        // 1. generateNormalAppearance()
        // 2. extractFontDetails() 
        // 3. PDFStreamParser constructor -> BaseParser static initializer
        // 4. BaseParser static initializer -> Log.warn() when charset loading fails
        handler.generateNormalAppearance();
        
        // Clean up
        document.close();
    }
}

