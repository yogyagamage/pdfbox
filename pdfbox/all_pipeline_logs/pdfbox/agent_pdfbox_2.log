        Document doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().newDocument();
        
        // Create root appearance element with KEY="AP" to pass the check in parseStampAnnotationAppearanceXML
        Element appearanceEl = doc.createElement("dict");
        appearanceEl.setAttribute("KEY", "AP");
        
        // Create a STREAM child element that will trigger parseStreamElement
        Element streamEl = doc.createElement("STREAM");
        streamEl.setAttribute("KEY", "N");
        
        // Create an ARRAY child element inside the stream that will trigger parseArrayElement
        Element arrayEl = doc.createElement("ARRAY");
        arrayEl.setAttribute("KEY", "BBox");
        
        // Add enough child elements to satisfy the BBox check (needs at least 4)
        for (int i = 0; i < 4; i++) {
            Element intEl = doc.createElement("INT");
            intEl.setAttribute("KEY", "coord" + i);
            intEl.setAttribute("VAL", "10");
            arrayEl.appendChild(intEl);
        }
        
        streamEl.appendChild(arrayEl);
        appearanceEl.appendChild(streamEl);
        
        // Create the main element that will be passed to the constructor
        Element mainElement = doc.createElement("annotation");
        mainElement.setAttribute("page", "1"); // Required to avoid IOException
        mainElement.setAttribute("subtype", "Stamp");
        
