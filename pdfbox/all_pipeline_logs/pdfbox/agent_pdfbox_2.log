package org.apache.pdfbox.pdmodel.interactive.form;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDAcroForm;
import org.apache.pdfbox.pdmodel.interactive.digitalsignature.PDSignature;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.cos.COSString;
import org.apache.pdfbox.pdmodel.PDResources;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationWidget;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import java.io.IOException;

class PDSignatureField_BaseParsermethod_LogwarnFikaTest {

    @Test
    void testSetValueTriggersBaseParserStaticInitializer() throws IOException {
        PDDocument document = new PDDocument();
        PDAcroForm acroForm = new PDAcroForm(document);
        
        PDSignatureField signatureField = new PDSignatureField(acroForm);
        
        PDSignature signature = new PDSignature();
        
        COSDictionary widgetDict = new COSDictionary();
        widgetDict.setItem(COSName.RECT, new PDRectangle(100, 100).getCOSArray());
        PDAnnotationWidget widget = new PDAnnotationWidget(widgetDict);
        signatureField.getWidgets().add(widget);
        
        COSDictionary fieldDict = signatureField.getCOSObject();
        fieldDict.setItem(COSName.DA, COSString.newInstance("0 g /Helv 12 Tf"));
        
        PDResources dr = new PDResources();
        acroForm.setDefaultResources(dr);
        
        signatureField.setValue(signature);
        
        document.close();
    }
}

