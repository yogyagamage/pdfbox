public class PDImageXObject_PNGConverterconvertPng_LogerrorFikaTest {

    @Test
    public void testCreateFromByteArrayTriggersLogError() throws IOException {
        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // Create PNG data that will cause the Log.error call in convertPng
        // We need PNG header, IHDR chunk with invalid bit depth (e.g., 3)
        byte[] pngData = createInvalidBitDepthPNG();
        
        // Create a mock CustomFactory (not used for PNG path but required by signature)
        CustomFactory customFactory = mock(CustomFactory.class);
        
        try {
            // This should trigger the call chain:
            // createFromByteArray -> PNGConverter.convertPNGImage -> PNGConverter.convertPng -> Log.error
            PDImageXObject.createFromByteArray(document, pngData, "test.png", customFactory);
        } catch (Exception e) {
            // Expected - we don't care about exceptions, only that Log.error was called
        } finally {
            document.close();
        }
    }
    
    private byte[] createInvalidBitDepthPNG() {
        // PNG signature
        byte[] pngSignature = new byte[] {
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk with invalid bit depth = 3
        // IHDR structure: width=1, height=1, bitDepth=3, colorType=2, compression=0, filter=0, interlace=0
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x01, // width = 1
            0x00, 0x00, 0x00, 0x01, // height = 1
            0x03,                   // bitDepth = 3 (invalid)
            0x02,                   // colorType = 2 (RGB)
            0x00,                   // compressionMethod = 0
            0x00,                   // filterMethod = 0
            0x00                    // interlaceMethod = 0
        };
        
        // Calculate CRC for IHDR (using a pre-calculated value for simplicity)
        byte[] crc = new byte[] { (byte) 0x9A, 0x76, 0x82, 0x6D };
        
        // Build complete PNG
        byte[] png = new byte[pngSignature.length + 4 + 4 + 13 + 4];
        int pos = 0;
        
        // PNG signature
        System.arraycopy(pngSignature, 0, png, pos, pngSignature.length);
        pos += pngSignature.length;
        
        // IHDR chunk length (13)
        png[pos++] = 0x00;
        png[pos++] = 0x00;
        png[pos++] = 0x00;
        png[pos++] = 0x0D;
        
        // IHDR chunk type
        png[pos++] = 'I';
        png[pos++] = 'H';
        png[pos++] = 'D';
        png[pos++] = 'R';
        
        // IHDR data
        System.arraycopy(ihdrData, 0, png, pos, ihdrData.length);
        pos += ihdrData.length;
        
        // CRC
        System.arraycopy(crc, 0, png, pos, crc.length);
        
        return png;
    }
}

