        COSDictionary dict = new COSDictionary();
        dict.setItem(COSName.TYPE, COSName.FORM);
        dict.setItem(COSName.SUBTYPE, COSName.FORM);
        // Don't set BBox to make it null
        dict.setItem(COSName.RESOURCES, new COSDictionary());
        
        COSDictionary groupDict = new COSDictionary();
        groupDict.setItem(COSName.CS, COSName.DEVICERGB);
        groupDict.setItem(COSName.S, COSName.TRANSPARENCY);
        dict.setItem(COSName.GROUP, groupDict);
        
        return new PDTransparencyGroup(dict);
    }
    
    private org.apache.pdfbox.pdmodel.graphics.state.PDSoftMask createSoftMaskWithTransparencyGroup(
            PDTransparencyGroup form) {
        COSDictionary dict = new COSDictionary();
        dict.setItem(COSName.S, COSName.LUMINOSITY); // Use LUMINOSITY to get backdrop color path
        dict.setItem(COSName.G, form);
        
        // Add backdrop color array
        COSArray backdropArray = new COSArray();
        backdropArray.addFloat(0.5f);
        backdropArray.addFloat(0.5f);
        backdropArray.addFloat(0.5f);
        dict.setItem(COSName.BC, backdropArray);
        
        return new org.apache.pdfbox.pdmodel.graphics.state.PDSoftMask(dict);
    }
    
    private org.apache.pdfbox.pdmodel.graphics.shading.PDShading createShadingWithBBox() {
        COSDictionary dict = new COSDictionary();
        dict.setItem(COSName.SHADING_TYPE, COSInteger.get(2)); // Axial shading
        dict.setItem(COSName.COLORSPACE, COSName.DEVICERGB);
        
        // Add BBox to ensure area is not empty
        COSArray bboxArray = new COSArray();
        bboxArray.addFloat(0f);
        bboxArray.addFloat(0f);
        bboxArray.addFloat(100f);
        bboxArray.addFloat(100f);
        dict.setItem(COSName.BBOX, bboxArray);
        
        // Add function for shading
        COSArray functionArray = new COSArray();
        functionArray.addFloat(0f);
        functionArray.addFloat(0f);
        functionArray.addFloat(0f);
        functionArray.addFloat(1f);
        functionArray.addFloat(1f);
        functionArray.addFloat(1f);
        
        COSDictionary functionDict = new COSDictionary();
        functionDict.setItem(COSName.FUNCTION_TYPE, COSInteger.get(0));
        functionDict.setItem(COSName.DOMAIN, new COSArray());
        functionDict.setItem(COSName.RANGE, new COSArray());
        functionDict.setItem(COSName.SIZE, new COSArray());
        functionDict.setItem(COSName.BITS_PER_SAMPLE, COSInteger.get(8));
        functionDict.setByteArray(COSName.DECODE, new byte[]{0,1,0,1,0,1});
        dict.setItem(COSName.FUNCTION, functionDict);
        
