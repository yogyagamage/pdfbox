import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class PDFStreamEngine_TilingPaintgetAnchorRect_LogwarnFikaTest {

    @Test
    public void testShowTextStringTriggersLogWarn() throws Exception {
        // Create a real PageDrawer instance with mocked dependencies
        PDPage page = mock(PDPage.class);
        when(page.getCropBox()).thenReturn(new PDRectangle(0, 0, 612, 792));
        when(page.getMatrix()).thenReturn(new Matrix());
        
        // Create a custom PageDrawer that extends but doesn't override methods
        // We'll use a real subclass created via inheritance in test setup
        PageDrawer drawer = createPageDrawer(page);
        
        // Set up the tiling paint factory to trigger the warning path
        setupTilingPaintFactoryForWarning(drawer);
        
        // Set up the graphics state with a colored tiling pattern
        setupGraphicsStateForTilingPattern(drawer);
        
        // Set up font and text state
        setupFontAndTextState(drawer);
        
        // Call the entry point method
        byte[] textBytes = new byte[] { 65 }; // 'A'
        drawer.showTextString(textBytes);
    }
    
    private PageDrawer createPageDrawer(PDPage page) throws IOException {
        // Create a real PageDrawer by extending it in a separate class
        // to avoid anonymous inner class in test method
        return new TestPageDrawer(page);
    }
    
    private static class TestPageDrawer extends PageDrawer {
        public TestPageDrawer(PDPage page) throws IOException {
            super(page);
        }
        // No overrides - using default implementations
    }
    
    private void setupTilingPaintFactoryForWarning(PageDrawer drawer) throws Exception {
        // Use reflection to access the tilingPaintFactory field
        java.lang.reflect.Field field = PageDrawer.class.getDeclaredField("tilingPaintFactory");
        field.setAccessible(true);
        
        // Create a TilingPaintFactory that will create a TilingPaint with XStep = 0
        TilingPaintFactory factory = new TilingPaintFactory() {
            private Map<TilingPaintParameter, WeakReference<Paint>> weakCache = new HashMap<>();
            
            @Override
            public Paint create(PDTilingPattern pattern, PDColorSpace colorSpace, PDColor color, 
                              AffineTransform xform) throws IOException {
                // Create a TilingPaint that will trigger the warning
                return new TilingPaint(drawer, pattern, colorSpace, color, xform) {
                    // Override getAnchorRect to ensure XStep is 0
                    @Override
                    private java.awt.geom.Rectangle2D getAnchorRect(PDTilingPattern pattern) throws IOException {
                        // Create a pattern with XStep = 0
                        PDTilingPattern zeroXStepPattern = createZeroXStepPattern(pattern);
                        return super.getAnchorRect(zeroXStepPattern);
                    }
                };
            }
        };
        
        field.set(drawer, factory);
    }
    
    private PDTilingPattern createZeroXStepPattern(PDTilingPattern original) throws Exception {
        // Create a mock pattern with XStep = 0
        PDTilingPattern pattern = mock(PDTilingPattern.class);
        when(pattern.getBBox()).thenReturn(new PDRectangle(0, 0, 100, 100));
        when(pattern.getXStep()).thenReturn(0f); // This triggers the warning
        when(pattern.getYStep()).thenReturn(100f);
        when(pattern.getMatrix()).thenReturn(new Matrix());
        when(pattern.getPaintType()).thenReturn(PDTilingPattern.PAINT_COLORED);
        when(pattern.getCOSObject()).thenReturn(original != null ? original.getCOSObject() : mock(org.apache.pdfbox.cos.COSDictionary.class));
        when(pattern.getResources()).thenReturn(new PDResources());
        
        return pattern;
    }
    
    private void setupGraphicsStateForTilingPattern(PageDrawer drawer) throws Exception {
        // Get the graphics stack
        java.lang.reflect.Field graphicsStackField = PDFStreamEngine.class.getDeclaredField("graphicsStack");
        graphicsStackField.setAccessible(true);
        
        @SuppressWarnings("unchecked")
        Deque<PDGraphicsState> graphicsStack = (Deque<PDGraphicsState>) graphicsStackField.get(drawer);
        
        // Create a graphics state with a colored tiling pattern
        PDGraphicsState state = new PDGraphicsState(new PDRectangle(0, 0, 612, 792));
        PDTextState textState = state.getTextState();
        
        // Set up a colored tiling pattern for stroking color
        PDTilingPattern pattern = mock(PDTilingPattern.class);
        when(pattern.getPaintType()).thenReturn(PDTilingPattern.PAINT_COLORED);
        
        PDColor patternColor = new PDColor(new float[] { 0.5f, 0.5f, 0.5f }, PDDeviceRGB.INSTANCE);
        state.setStrokingColor(patternColor);
        
        // Set rendering mode to stroke
        textState.setRenderingMode(org.apache.pdfbox.pdmodel.graphics.state.RenderingMode.STROKE);
        
        // Replace the top of the graphics stack
        graphicsStack.clear();
        graphicsStack.push(state);
    }
    
    private void setupFontAndTextState(PageDrawer drawer) throws Exception {
        // Get the graphics stack
        java.lang.reflect.Field graphicsStackField = PDFStreamEngine.class.getDeclaredField("graphicsStack");
        graphicsStackField.setAccessible(true);
        
        @SuppressWarnings("unchecked")
        Deque<PDGraphicsState> graphicsStack = (Deque<PDGraphicsState>) graphicsStackField.get(drawer);
        
        PDGraphicsState state = graphicsStack.peek();
        PDTextState textState = state.getTextState();
        
        // Set a real font
        PDFont font = PDType1Font.HELVETICA;
        textState.setFont(font);
        textState.setFontSize(12);
        
        // Set text matrix
        state.setTextMatrix(new Matrix());
        
        // Set current transformation matrix
        state.setCurrentTransformationMatrix(new Matrix());
    }
}

