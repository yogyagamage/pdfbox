public class PDFreeTextAppearanceHandler_BaseParsermethod_LogwarnFikaTest {

    @Test
    public void testGenerateNormalAppearanceTriggersBaseParserStaticInitializer() throws IOException {
        // Create a minimal annotation with a default appearance that will cause
        // PDFStreamParser to be instantiated, which triggers BaseParser static initialization
        PDAnnotationFreeText annotation = new PDAnnotationFreeText();
        annotation.setRectangle(new org.apache.pdfbox.pdmodel.common.PDRectangle(100, 100));
        
        // Set a default appearance that will be parsed by extractFontDetails
        // The content doesn't matter much, but it should be parseable
        annotation.setDefaultAppearance("/Helv 10 Tf 0 g");
        
        // Create a document to ensure the document path in extractFontDetails is taken
