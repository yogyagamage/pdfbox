        fieldDict.setItem(COSName.DA, new COSString("/Helv 12 Tf 0 g"));
        
        // Create resources for the field
        PDResources resources = new PDResources();
        fieldDict.setItem(COSName.DR, resources);
        
        // Add field to acroform's fields array
