        Path tempPfbFile = Files.createTempFile("testfont", ".pfb");
        try {
            // Write minimal PFB header content to avoid parse errors
            // PFB format: 0x80 0x01 (ASCII section marker) + length + data
            byte[] pfbHeader = new byte[] {
                (byte) 0x80, 0x01,  // Start of ASCII section
                0x00, 0x00, 0x00, 0x06,  // Length = 6
                '%', '!', 'P', 'S', '-', 'A',  // Minimal PostScript header
                (byte) 0x80, 0x02,  // Start of binary section
                0x00, 0x00, 0x00, 0x00,  // Length = 0
                (byte) 0x80, 0x03   // End of file
            };
            Files.write(tempPfbFile, pfbHeader);
            
