                if (position >= pdfBytes.length) {
                    return -1;
                }
                return pdfBytes[position++] & 0xFF;
            }

            @Override
            public int read(byte[] b, int off, int len) throws IOException {
                if (position >= pdfBytes.length) {
                    return -1;
                }
                int bytesToRead = Math.min(len, pdfBytes.length - position);
                System.arraycopy(pdfBytes, position, b, off, bytesToRead);
                position += bytesToRead;
                return bytesToRead;
            }

            @Override
            public long getPosition() throws IOException {
                return position;
            }

            @Override
            public void seek(long pos) throws IOException {
                if (pos < 0 || pos > pdfBytes.length) {
                    throw new IOException("Invalid position");
                }
                position = (int) pos;
            }

            @Override
            public long length() throws IOException {
                return pdfBytes.length;
            }

            @Override
            public boolean isClosed() {
                return closed;
            }

            @Override
            public void close() throws IOException {
                closed = true;
