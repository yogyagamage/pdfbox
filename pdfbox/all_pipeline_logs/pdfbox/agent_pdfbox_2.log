package org.apache.pdfbox.pdfparser;

import org.apache.pdfbox.io.RandomAccessRead;
import org.apache.pdfbox.io.RandomAccessReadBuffer;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDFParser_COSParserparseTrailer_LogwarnFikaTest {

    @Test
    public void testParseTrailerLogWarn() throws IOException {
        // Create a minimal PDF that will trigger the warn log in parseTrailer()
        // The PDF needs to have a malformed xref/trailer structure that causes
        // parseTrailer() to see digits instead of 't' at the expected position
        // This will make isLenient=true and the while loop execute
        
        // Minimal PDF with startxref pointing to a position that contains digits
        // instead of "trailer"
        String pdfContent = "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<< /Type /Catalog /Pages 2 0 R >>\n" +
                "endobj\n" +
                "2 0 obj\n" +
                "<< /Type /Pages /Kids [] /Count 0 >>\n" +
                "endobj\n" +
                "xref\n" +
                "0 3\n" +
                "0000000000 65535 f \n" +
                "0000000010 00000 n \n" +
                "0000000050 00000 n \n" +
                "trailer\n" +
                "<< /Size 3 /Root 1 0 R >>\n" +
                "startxref\n" +
                "100\n" +
                "%%EOF\n";
        
        // Create a custom RandomAccessRead that will return digits at position 100
        // instead of "trailer" to trigger the warn log
        byte[] pdfBytes = pdfContent.getBytes();
        // Modify bytes at position 100 to be digits
        if (pdfBytes.length > 100) {
            // Put "123" at position 100 instead of whatever is there
            pdfBytes[100] = '1';
            if (pdfBytes.length > 101) pdfBytes[101] = '2';
            if (pdfBytes.length > 102) pdfBytes[102] = '3';
        }
        
        RandomAccessRead source = new RandomAccessReadBuffer(pdfBytes);
        
        // Use the simplest constructor
        PDFParser parser = new PDFParser(source);
        
        // Set lenient to true to enable the warn log path
        parser.parse(true);
    }
}

