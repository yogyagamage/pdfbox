        };
        
        // IDAT chunk (minimal): length=2, type="IDAT", data (deflated empty), crc
        // Deflated empty data: 0x78 0x9C 0x03 0x00 0x00 0x00 0x00 0x01
        byte[] idatData = new byte[] {
            0x78, 0x9C, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01
        };
        
        // IEND chunk: length=0, type="IEND", crc
        byte[] iendData = new byte[] {};
        
        // Calculate CRC (simplified - using placeholder values)
        int ihdrCrc = 0x12345678;
        int gamaCrc = 0x87654321;
        int idatCrc = 0x11223344;
        int iendCrc = 0x55667788;
        
        // Build complete PNG
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        
        // Write signature
        baos.write(pngSignature, 0, pngSignature.length);
        
        // Write IHDR chunk
        writeChunk(baos, "IHDR".getBytes(), ihdrData, ihdrCrc);
        
        // Write gAMA chunk
        writeChunk(baos, "gAMA".getBytes(), gamaData, gamaCrc);
        
        // Write IDAT chunk
        writeChunk(baos, "IDAT".getBytes(), idatData, idatCrc);
        
        // Write IEND chunk
        writeChunk(baos, "IEND".getBytes(), iendData, iendCrc);
        
        return baos.toByteArray();
    }
    
    private void writeChunk(ByteArrayOutputStream baos, byte[] type, byte[] data, int crc) {
        // Write length (big-endian)
        int length = data.length;
        baos.write((length >> 24) & 0xFF);
        baos.write((length >> 16) & 0xFF);
        baos.write((length >> 8) & 0xFF);
        baos.write(length & 0xFF);
        
        // Write type
        baos.write(type, 0, type.length);
        
        // Write data
        baos.write(data, 0, data.length);
        
        // Write CRC (big-endian)
        baos.write((crc >> 24) & 0xFF);
        baos.write((crc >> 16) & 0xFF);
        baos.write((crc >> 8) & 0xFF);
        baos.write(crc & 0xFF);
    }
    
    // Helper class to avoid compilation errors
    private static class ByteArrayOutputStream {
        private java.io.ByteArrayOutputStream delegate = new java.io.ByteArrayOutputStream();
        
        public void write(int b) {
            delegate.write(b);
        }
        
        public void write(byte[] b, int off, int len) {
            delegate.write(b, off, len);
        }
        
        public byte[] toByteArray() {
            return delegate.toByteArray();
        }
    }
