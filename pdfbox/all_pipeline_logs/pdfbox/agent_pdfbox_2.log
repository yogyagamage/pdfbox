        // PNG signature + IHDR chunk + iCCP chunk with insufficient bytes
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        
        // PNG signature (8 bytes)
        baos.write(new byte[]{(byte)137, 80, 78, 71, 13, 10, 26, 10});
        
        // IHDR chunk (length: 13 bytes)
        // Chunk length (4 bytes): 13
        baos.write(new byte[]{0, 0, 0, 13});
        // Chunk type: IHDR
        baos.write(new byte[]{73, 72, 68, 82});
        // IHDR data: width=1, height=1, bitDepth=8, colorType=2 (Truecolor)
        // compressionMethod=0, filterMethod=0, interlaceMethod=0
        baos.write(new byte[]{
            0, 0, 0, 1,    // width
            0, 0, 0, 1,    // height
            8,             // bitDepth
            2,             // colorType
            0,             // compressionMethod
            0,             // filterMethod
            0              // interlaceMethod
        });
        // CRC for IHDR (dummy value)
        baos.write(new byte[]{0, 0, 0, 0});
        
        // iCCP chunk with insufficient bytes (less than 2 bytes after name)
        // Chunk length: 1 byte (too short)
        baos.write(new byte[]{0, 0, 0, 1});
        // Chunk type: iCCP
        baos.write(new byte[]{105, 67, 67, 80});
        // Single byte (name with no null terminator and no compression method)
        baos.write(new byte[]{65});
        // CRC for iCCP (dummy value)
        baos.write(new byte[]{0, 0, 0, 0});
        
        // IEND chunk
        baos.write(new byte[]{0, 0, 0, 0});
        baos.write(new byte[]{73, 69, 78, 68});
        baos.write(new byte[]{0, 0, 0, 0});
        
