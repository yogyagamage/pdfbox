public class FontMapperImpl_FileSystemFontProvideraddType1Font_LogwarnFikaTest {

    @Test
    public void testGetProviderTriggersLogWarn() throws Exception {
        FontMapperImpl fontMapper = new FontMapperImpl();
        
        // Create a temporary .pfb file to trigger the Type1 font path
        File tempPfbFile = File.createTempFile("testfont", ".pfb");
        tempPfbFile.deleteOnExit();
        
        // Write minimal PFB content that will cause Type1Font.createWithPFB to return a font with null name
        try (FileOutputStream fos = new FileOutputStream(tempPfbFile)) {
            // Write a minimal PFB header and some data
            // PFB format: 0x80, 1 (ASCII), length (4 bytes), data, 0x80, 3 (trailer)
            fos.write(0x80);
            fos.write(1);
            // Length = 4 bytes (little endian)
            fos.write(4);
            fos.write(0);
            fos.write(0);
            fos.write(0);
            // Some dummy data
            fos.write("test".getBytes());
            // Trailer
            fos.write(0x80);
            fos.write(3);
        }
        
        // Create a FontFileFinder that returns our test file
        FontFileFinder fontFileFinder = new FontFileFinder() {
            @Override
            public List<URI> find() {
                List<URI> uris = new ArrayList<>();
                uris.add(tempPfbFile.toURI());
                return uris;
            }
        };
        
        // Create a FileSystemFontProvider with our custom FontFileFinder
        FileSystemFontProvider provider = new FileSystemFontProvider(new FontCache()) {
            @Override
            protected void scanFonts(List<File> files) {
                // Override to only process our test file
                for (File file : files) {
                    String filePath = file.getPath().toLowerCase();
                    if (filePath.endsWith(".pfb")) {
                        addType1Font(file);
                    }
                }
            }
        };
        
        // Set the provider to trigger font loading
        fontMapper.setProvider(provider);
        
        // Call getProvider which will eventually trigger the log.warn call
        fontMapper.getProvider();
    }
}

