package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject;
import org.apache.pdfbox.pdmodel.graphics.image.CustomFactory;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import javax.imageio.ImageIO;
import java.awt.image.BufferedImage;

class PDImageXObject_PNGConverterbuildImageObject_LogdebugFikaTest {

    @Test
    void testCreateFromByteArrayTriggersLogDebug() throws IOException {
        // Create a minimal valid PNG byte array that will pass FileTypeDetector as PNG
        // and will be processed by PNGConverter.convertPNGImage
        // The PNG must have a valid signature and IHDR chunk to reach buildImageObject
        byte[] pngBytes = createMinimalPNG();
        
        // Create a real PDDocument
        try (PDDocument document = new PDDocument()) {
            // Call the entry point with null CustomFactory to force PNG processing
            PDImageXObject.createFromByteArray(document, pngBytes, "test.png", null);
        }
    }

    private byte[] createMinimalPNG() {
        // PNG signature
        byte[] signature = new byte[] {
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk: length = 13
        byte[] ihdrLength = new byte[] { 0x00, 0x00, 0x00, 0x0D };
        byte[] ihdrType = new byte[] { 'I', 'H', 'D', 'R' };
        // IHDR data: width=2, height=2, bitDepth=8, colorType=2 (Truecolor),
        // compression=0, filter=0, interlace=0
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x02, // width
            0x00, 0x00, 0x00, 0x02, // height
            0x08,                   // bitDepth
            0x02,                   // colorType (Truecolor)
            0x00,                   // compression
            0x00,                   // filter
            0x00                    // interlace
        };
        // CRC for IHDR (pre-calculated for this specific data)
        byte[] ihdrCrc = new byte[] { (byte) 0x9A, (byte) 0x9C, 0x18, 0x7D };
        
        // gAMA chunk: length = 4, with gamma value that will trigger the Log.debug call
        // Gamma = 1/1.8 ≈ 0.5555556 (not 1/2.2 ≈ 0.45454545)
        byte[] gamaLength = new byte[] { 0x00, 0x00, 0x00, 0x04 };
        byte[] gamaType = new byte[] { 'g', 'A', 'M', 'A' };
        // Gamma value as 1/gamma * 100000 = 1/1.8 * 100000 ≈ 55555 = 0xD903
        byte[] gamaData = new byte[] { 0x00, 0x00, (byte) 0xD9, 0x03 };
        // CRC for gAMA (pre-calculated)
        byte[] gamaCrc = new byte[] { (byte) 0x0C, (byte) 0x1E, 0x2A, 0x3F };
        
        // IEND chunk
        byte[] iendLength = new byte[] { 0x00, 0x00, 0x00, 0x00 };
        byte[] iendType = new byte[] { 'I', 'E', 'N', 'D' };
        byte[] iendCrc = new byte[] { (byte) 0xAE, 0x42, 0x60, (byte) 0x82 };
        
        // Combine all chunks
        int totalLength = signature.length + ihdrLength.length + ihdrType.length + 
                         ihdrData.length + ihdrCrc.length + gamaLength.length + 
                         gamaType.length + gamaData.length + gamaCrc.length + 
                         iendLength.length + iendType.length + iendCrc.length;
        
        byte[] png = new byte[totalLength];
        int offset = 0;
        
        System.arraycopy(signature, 0, png, offset, signature.length);
        offset += signature.length;
        
        System.arraycopy(ihdrLength, 0, png, offset, ihdrLength.length);
        offset += ihdrLength.length;
        System.arraycopy(ihdrType, 0, png, offset, ihdrType.length);
        offset += ihdrType.length;
        System.arraycopy(ihdrData, 0, png, offset, ihdrData.length);
        offset += ihdrData.length;
        System.arraycopy(ihdrCrc, 0, png, offset, ihdrCrc.length);
        offset += ihdrCrc.length;
        
        System.arraycopy(gamaLength, 0, png, offset, gamaLength.length);
        offset += gamaLength.length;
        System.arraycopy(gamaType, 0, png, offset, gamaType.length);
        offset += gamaType.length;
        System.arraycopy(gamaData, 0, png, offset, gamaData.length);
        offset += gamaData.length;
        System.arraycopy(gamaCrc, 0, png, offset, gamaCrc.length);
        offset += gamaCrc.length;
        
        System.arraycopy(iendLength, 0, png, offset, iendLength.length);
        offset += iendLength.length;
        System.arraycopy(iendType, 0, png, offset, iendType.length);
        offset += iendType.length;
        System.arraycopy(iendCrc, 0, png, offset, iendCrc.length);
        
        return png;
    }
}

