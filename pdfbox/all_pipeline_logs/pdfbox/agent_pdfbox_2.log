    private byte[] createMinimalTTFWithoutVerticalMetrics() {
        // Create a minimal TTF with only basic tables (no vhea table)
        // This is a simplified version - in reality you'd need proper TTF structure
        // For test purposes, we'll create data that TTFParser can parse but won't have vhea
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        try {
            // TTF header (12 bytes)
            baos.write(new byte[] {0x00, 0x01, 0x00, 0x00}); // version 1.0
            baos.write(new byte[] {0x00, 0x01}); // numTables = 1
            baos.write(new byte[] {0x00, 0x00, 0x00, 0x00}); // searchRange, entrySelector, rangeShift
            
            // Table directory entry for 'cmap' (16 bytes)
            baos.write(new byte[] {'c', 'm', 'a', 'p'}); // tag
            baos.write(new byte[] {0x00, 0x00, 0x00, 0x00}); // checksum
            baos.write(new byte[] {0x00, 0x00, 0x00, 0x1C}); // offset (28 = 12+16)
            baos.write(new byte[] {0x00, 0x00, 0x00, 0x0C}); // length (12)
            
            // 'cmap' table data (12 bytes)
            baos.write(new byte[] {0x00, 0x00}); // version
            baos.write(new byte[] {0x00, 0x01}); // numTables
            baos.write(new byte[] {0x00, 0x00}); // platformID
            baos.write(new byte[] {0x00, 0x00}); // encodingID
            baos.write(new byte[] {0x00, 0x00, 0x00, 0x0C}); // subtableOffset
            
            // Format 0 subtable (6 bytes)
            baos.write(new byte[] {0x00, 0x00}); // format
            baos.write(new byte[] {0x00, 0x06}); // length
            baos.write(new byte[] {0x00, 0x00}); // language
            
            // Add required 'head', 'hhea', 'hmtx', 'maxp', 'name', 'OS/2', 'post' tables
            // For simplicity, we'll pad with zeros - the parser should handle missing tables
            // by throwing appropriate exceptions that will be caught internally
        } catch (Exception e) {
            // Fallback to very basic data
            return new byte[] {0x00, 0x01, 0x00, 0x00, 0x00, 0x01};
        }
        return baos.toByteArray();
    }
}

