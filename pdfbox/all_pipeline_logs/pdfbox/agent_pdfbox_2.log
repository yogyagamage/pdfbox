Rectangle2D getBounds(AffineTransform xform, Matrix matrix, int controlPoints) throws IOException {
    Rectangle2D bounds = null;
    // PATH: Test should invoke the next PDMeshBasedShadingType.collectPatches(...) [step in execution path]
    for (Patch patch : collectPatches(xform, matrix, controlPoints)) {
        for (ShadedTriangle shadedTriangle : patch.listOfTriangles) {
            if (bounds == null) {
                bounds = new Rectangle2D.Double(shadedTriangle.corner[0].getX(), shadedTriangle.corner[0].getY(), 0, 0);
            }
            bounds.add(shadedTriangle.corner[0]);
            bounds.add(shadedTriangle.corner[1]);
            bounds.add(shadedTriangle.corner[2]);
        }
    }
    return bounds;
}

