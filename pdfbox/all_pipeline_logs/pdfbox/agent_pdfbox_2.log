    @Test
    public void testShadingFillTriggersLogWarn() throws IOException {
        // Create minimal PDF document
        PDDocument document = new PDDocument();
        PDPage page = new PDPage(PDRectangle.A4);
        document.addPage(page);
        
        // Create PageDrawerParameters with mocked dependencies
        PageDrawerParameters parameters = new PageDrawerParameters(
            page,
            null, // renderer
            false, // subsamplingAllowed
            null, // destination
            null, // renderingHints
            0.0f  // imageDownscalingOptimizationThreshold
        );
        
        // Instantiate PageDrawer using the provided constructor
        PageDrawer drawer = new PageDrawer(parameters);
        
        // Create a Graphics2D context for the drawer to use
        BufferedImage image = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = image.createGraphics();
        drawer.drawPage(graphics, PDRectangle.A4);
        
        // Create a shading name
        COSName shadingName = COSName.getPDFName("Sh1");
        
        // Create resources with a shading that will trigger the path
        PDResources resources = new PDResources();
        PDShading shading = PDShading.create(new COSDictionary(), document);
        // Set BBox to null to trigger the path that eventually leads to LOG.warn
        shading.getCOSObject().setItem(COSName.BBOX, null);
        resources.put(shadingName, shading);
        
        // Use reflection to set resources on the page
        page.setResources(resources);
        
        // Create a soft mask with a transparency group that has null BBox
        PDSoftMask softMask = new PDSoftMask();
        softMask.getCOSObject().setItem(COSName.S, COSName.LUMINOSITY);
        
        // Create transparency group dictionary with null BBox
        COSDictionary groupDict = new COSDictionary();
        groupDict.setItem(COSName.TYPE, COSName.GROUP);
        groupDict.setItem(COSName.S, COSName.TRANSPARENCY);
        // Explicitly set BBox to null
        groupDict.setItem(COSName.BBOX, null);
        
        // Create form dictionary for the transparency group
        COSDictionary formDict = new COSDictionary();
        formDict.setItem(COSName.TYPE, COSName.XOBJECT);
        formDict.setItem(COSName.SUBTYPE, COSName.FORM);
        formDict.setItem(COSName.GROUP, groupDict);
        formDict.setItem(COSName.RESOURCES, new COSDictionary());
        
        // Create a stream for the form (empty content)
        COSStream formStream = new COSStream();
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        baos.write("q Q".getBytes());
        formStream.setData(baos.toByteArray());
        formStream.setItem(COSName.LENGTH, COSInteger.get(baos.size()));
        
        // Merge stream items into formDict
        for (COSName key : formStream.keySet()) {
            formDict.setItem(key, formStream.getItem(key));
        }
        
        PDTransparencyGroup transparencyGroup = new PDTransparencyGroup(formDict);
        softMask.setGroup(transparencyGroup);
        
        // Set soft mask in graphics state
        drawer.getGraphicsState().setSoftMask(softMask);
        
        // Call the entry point method
        drawer.shadingFill(shadingName);
        
        // Cleanup
        graphics.dispose();
        document.close();
    }
}

