package org.apache.pdfbox.pdmodel.interactive.annotation.handlers;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationFreeText;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotation;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDBorderStyleDictionary;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAppearanceStream;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.interactive.form.PDAcroForm;
import org.apache.pdfbox.pdmodel.PDDocumentCatalog;
import org.apache.pdfbox.pdmodel.PDResources;
import org.apache.pdfbox.pdmodel.font.PDFont;
import org.apache.pdfbox.pdmodel.graphics.color.PDColor;
import org.apache.pdfbox.pdmodel.graphics.color.PDDeviceRGB;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDBorderEffectDictionary;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.nio.charset.StandardCharsets;

public class PDFreeTextAppearanceHandler_BaseParsermethod_LogwarnFikaTest {

    @Test
    public void testGenerateNormalAppearanceTriggersBaseParserStaticInitializer() throws Exception {
        // Create a minimal PDDocument with AcroForm to trigger extractFontDetails path
        PDDocument document = new PDDocument();
        
        // Create annotation with default appearance that will cause IOException in PDFStreamParser
        PDAnnotationFreeText annotation = new PDAnnotationFreeText();
        COSDictionary dict = annotation.getCOSObject();
        
        // Set a default appearance string that will be parsed
        dict.setString(COSName.DA, "/InvalidFont 12 Tf");
        
        // Set required fields to avoid NPEs
        dict.setItem(COSName.SUBTYPE, COSName.FREE_TEXT);
        dict.setItem(COSName.RECT, new PDRectangle(100, 100, 200, 50).getCOSArray());
        dict.setItem(COSName.F, COSName.getPDFName("4")); // Print flag
        
        // Create appearance stream
        PDAppearanceStream appearanceStream = new PDAppearanceStream(document);
        dict.setItem(COSName.AP, appearanceStream.getCOSObject());
        
        // Set border style to avoid NPE
        PDBorderStyleDictionary borderStyle = new PDBorderStyleDictionary();
        borderStyle.setWidth(1);
        annotation.setBorderStyle(borderStyle);
        
        // Set color
        annotation.setColor(new PDColor(new float[]{0, 0, 0}, PDDeviceRGB.INSTANCE));
        
        // Create handler with document to ensure extractFontDetails is called
        PDFreeTextAppearanceHandler handler = new PDFreeTextAppearanceHandler(annotation, document);
        
        // This should trigger the call chain:
        // 1. generateNormalAppearance()
        // 2. extractFontDetails() 
        // 3. PDFStreamParser constructor -> BaseParser class initialization
        // 4. BaseParser static initializer -> Log.warn()
        handler.generateNormalAppearance();
        
        document.close();
    }
}

