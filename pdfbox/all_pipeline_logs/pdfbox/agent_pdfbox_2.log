            0x49, 0x45, 0x4E, 0x44, // type "IEND"
            (byte) 0xAE, 0x42, 0x60, (byte) 0x82  // CRC (dummy)
        };
        
        // Call the entry point method with null CustomFactory to follow PNG path
        PDImageXObject.createFromByteArray(document, pngData, "test.png", null);
        
        // Close the document
        document.close();
    }
