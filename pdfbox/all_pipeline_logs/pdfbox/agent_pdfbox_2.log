            page, renderer, 
            org.apache.pdfbox.rendering.RenderDestination.VIEW,
            null, 0.5f, false
        );
    }
    
    private PDTilingPattern createTilingPatternWithZeroXStep() throws Exception {
        // Create a minimal PDTilingPattern with XStep = 0
        PDTilingPattern pattern = new PDTilingPattern();
        
        // Set required fields using reflection
        java.lang.reflect.Field xStepField = PDTilingPattern.class.getDeclaredField("xStep");
        xStepField.setAccessible(true);
