    private byte[] createIndexedPngWithoutPLTE() {
        // Create minimal PNG with indexed color type (3) but missing PLTE chunk
        // PNG signature + IHDR chunk + IDAT chunk + IEND chunk
        byte[] pngSignature = new byte[] {
            (byte)0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk: 13 bytes data + 4 bytes CRC
        // Width: 1, Height: 1, Bit depth: 8, Color type: 3 (indexed), 
        // Compression: 0, Filter: 0, Interlace: 0
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x0D, // Length: 13
            0x49, 0x48, 0x44, 0x52, // Type: IHDR
            0x00, 0x00, 0x00, 0x01, // Width: 1
            0x00, 0x00, 0x00, 0x01, // Height: 1
            0x08,                   // Bit depth: 8
            0x03,                   // Color type: 3 (indexed)
            0x00,                   // Compression: 0
            0x00,                   // Filter: 0
            0x00,                   // Interlace: 0
            (byte)0xAE, 0x42, 0x60, (byte)0x82 // CRC (pre-calculated for this data)
        };
        
        // IDAT chunk with minimal compressed data (1 pixel, value 0)
        byte[] idatData = new byte[] {
            0x00, 0x00, 0x00, 0x06, // Length: 6
            0x49, 0x44, 0x41, 0x54, // Type: IDAT
            0x78, 0x01,             // zlib header
            0x63, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, // compressed data
            (byte)0x0D, (byte)0xE4, 0x20, (byte)0xE1 // CRC
        };
        
        // IEND chunk
        byte[] iendData = new byte[] {
            0x00, 0x00, 0x00, 0x00, // Length: 0
            0x49, 0x45, 0x4E, 0x44, // Type: IEND
            (byte)0xAE, 0x42, 0x60, (byte)0x82 // CRC
        };
        
        // Combine all parts
        byte[] png = new byte[pngSignature.length + ihdrData.length + idatData.length + iendData.length];
        int offset = 0;
        
        System.arraycopy(pngSignature, 0, png, offset, pngSignature.length);
        offset += pngSignature.length;
        
        System.arraycopy(ihdrData, 0, png, offset, ihdrData.length);
        offset += ihdrData.length;
        
        System.arraycopy(idatData, 0, png, offset, idatData.length);
        offset += idatData.length;
        
        System.arraycopy(iendData, 0, png, offset, iendData.length);
        
        return png;
    }
