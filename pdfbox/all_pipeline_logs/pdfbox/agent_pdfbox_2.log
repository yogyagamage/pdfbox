                "<< /Type /Catalog /Pages 2 0 R >>\n" +
                "endobj\n" +
                "2 0 obj\n" +
                "<< /Type /Pages /Kids [] /Count 0 >>\n" +
                "endobj\n" +
                "xref\n" +
                "0 3\n" +
                "0000000000 65535 f \n" +
                "0000000010 00000 n \n" +
                "0000000050 00000 n \n" +
                "trailer\n" +
                "<< /Size 3 /Root 1 0 R /Prev 0 /XRefStm 999999 >>\n" +
                "startxref\n" +
                "100\n" +
                "%%EOF";
        
        byte[] pdfBytes = pdfContent.getBytes();
        InputStream inputStream = new ByteArrayInputStream(pdfBytes);
        
        // Create a RandomAccessRead from the byte array
        RandomAccessRead source = new RandomAccessRead() {
            private int position = 0;
            private final byte[] data = pdfBytes;
            
            @Override
            public void close() throws IOException {
                // No-op
            }
            
            @Override
            public int read() throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                return data[position++] & 0xFF;
            }
            
            @Override
            public int read(byte[] b, int off, int len) throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                int bytesToRead = Math.min(len, data.length - position);
                System.arraycopy(data, position, b, off, bytesToRead);
                position += bytesToRead;
                return bytesToRead;
            }
            
            @Override
            public long getPosition() throws IOException {
                return position;
            }
            
            @Override
            public void seek(long pos) throws IOException {
                if (pos < 0 || pos > data.length) {
                    throw new IOException("Position out of range");
                }
                position = (int) pos;
            }
            
            @Override
            public long length() throws IOException {
                return data.length;
            }
            
            @Override
            public boolean isClosed() {
                return false;
            }
            
            @Override
            public boolean isEOF() throws IOException {
                return position >= data.length;
            }
            
            @Override
            public int peek() throws IOException {
                if (position >= data.length) {
                    return -1;
                }
                return data[position] & 0xFF;
            }
            
            @Override
            public void rewind(int bytes) throws IOException {
                position = Math.max(0, position - bytes);
            }
            
            @Override
            public byte[] readFully(int length) throws IOException {
                byte[] result = new byte[length];
                int bytesRead = read(result, 0, length);
                if (bytesRead < length) {
                    throw new IOException("Could not read fully");
                }
                return result;
            }
            
            @Override
            public int available() throws IOException {
                return data.length - position;
            }
        };
        
        // Create PDFParser instance using the simplest constructor
        PDFParser parser = new PDFParser(source);
        
        // Set lenient to true to ensure the LOG.error path is taken
        // when parseXref encounters the invalid /XRefStm offset
        parser.parse(true);
    }
}

