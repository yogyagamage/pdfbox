package org.apache.pdfbox.pdfparser;

import org.apache.pdfbox.io.RandomAccessRead;
import org.apache.pdfbox.io.RandomAccessReadBuffer;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDFParser_COSParserparseXrefTable_LogwarnFikaTest {

    @Test
    public void testParsePathToLogWarn() throws IOException {
        // Create a minimal PDF that will trigger the path to parseXrefTable and the warn log
        // The PDF needs to have an xref table that starts with "xref" but is immediately followed by "trailer"
        // This will trigger the LOG.warn("skipping empty xref table") in parseXrefTable
        
        // PDF structure:
        // %PDF-1.4
        // 1 0 obj
        // << /Type /Catalog /Pages 2 0 R >>
        // endobj
        // 2 0 obj
        // << /Type /Pages /Kids [] /Count 0 >>
        // endobj
        // xref
        // trailer
        // << /Root 1 0 R /Size 3 >>
        // startxref
        // 0
        // %%EOF
        
        String pdfContent = "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<< /Type /Catalog /Pages 2 0 R >>\n" +
                "endobj\n" +
                "2 0 obj\n" +
                "<< /Type /Pages /Kids [] /Count 0 >>\n" +
                "endobj\n" +
                "xref\n" +
                "trailer\n" +
                "<< /Root 1 0 R /Size 3 >>\n" +
                "startxref\n" +
                "0\n" +
                "%%EOF";
        
        byte[] pdfBytes = pdfContent.getBytes();
        RandomAccessRead source = new RandomAccessReadBuffer(new ByteArrayInputStream(pdfBytes));
        
        // Use the simplest constructor
        PDFParser parser = new PDFParser(source);
        
        // Call the entry point method with lenient=true to ensure we go through the path
        // The lenient flag is important because it allows the parser to continue even with warnings
        parser.parse(true);
    }
}

