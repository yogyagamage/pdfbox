        Graphics2D graphics = image.createGraphics();
        pageDrawer.drawPage(graphics, PDRectangle.A4);
        
        // Create a PDTilingPattern with XStep = 0 to trigger the warning
        PDTilingPattern tilingPattern = createTilingPatternWithZeroXStep();
        
