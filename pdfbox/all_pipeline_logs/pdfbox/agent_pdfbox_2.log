            0x00, // interlace: 0
            (byte)0xAE, 0x42, 0x60, (byte)0x82 // CRC (dummy)
        };
        
        // IDAT chunk (minimal)
        byte[] idatData = new byte[] {
            0x00, 0x00, 0x00, 0x0C, // chunk length: 12
            0x49, 0x44, 0x41, 0x54, // "IDAT"
            0x78, 0x01, 0x63, 0x60, // zlib header
            0x00, 0x00, 0x00, 0x02, // compressed data
