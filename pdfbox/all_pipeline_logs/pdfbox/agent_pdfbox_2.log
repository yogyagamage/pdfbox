        when(mockTtf.getNumberOfGlyphs()).thenReturn(0);
        when(mockTtf.getGlyph()).thenReturn(null);
        when(mockTtf.getVerticalMetrics()).thenReturn(null);
        when(mockTtf.getHorizontalMetrics()).thenReturn(null);
        when(mockTtf.getGsubData()).thenReturn(null);
        when(mockTtf.getUnicodeCmapLookup()).thenReturn(null);
        
        // Create a minimal RandomAccessRead that will be parsed by TTFParser
        byte[] dummyFontData = new byte[] { 0, 1, 0, 0, 0 }; // Minimal TTF header
        RandomAccessRead randomAccessRead = new org.apache.pdfbox.io.RandomAccessReadBuffer(dummyFontData);
        
        // Mock TTFParser to return our mock TrueTypeFont
        TTFParser mockParser = mock(TTFParser.class);
        when(mockParser.parse(randomAccessRead)).thenReturn(mockTtf);
        
        // We cannot directly inject the mock parser, so we need to use reflection
