class PDButton_BaseParsermethod_LogwarnFikaTest2 {

    @Test
    void testSetValueTriggersLogWarn() throws IOException {
        // Create a minimal document structure
        PDDocument document = new PDDocument();
        PDAcroForm acroForm = new PDAcroForm(document);
        
        // Create a PDButton instance using the first constructor
        PDButton button = new PDButton(acroForm);
        
        // Set up required field attributes to reach the target method
        // The field needs to have a DA (default appearance) string
        COSDictionary fieldDict = button.getCOSObject();
        fieldDict.setItem(COSName.DA, COSString.newInstance());
        
        // Set up default resources in the acroform
        PDResources resources = new PDResources();
        acroForm.setDefaultResources(resources);
        
        // Set the field type to ensure it's treated as a variable text field
        // PDButton extends PDTerminalField which extends PDVariableText
        // We need to ensure the field has a valid parent structure
        fieldDict.setItem(COSName.FT, COSName.BTN);
        
        // Set a field name to avoid NPE in getFullyQualifiedName()
