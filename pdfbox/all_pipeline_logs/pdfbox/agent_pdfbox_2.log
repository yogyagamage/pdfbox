        PDFParser parser = new PDFParser(source, "");
        
        // Call parse with lenient=true to ensure LOG.error is called when parseXref fails
        try {
            parser.parse(true);
        } catch (IOException e) {
            // Expected - we're trying to trigger the error logging path
        }
    }
}

