package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.junit.jupiter.api.Test;
import javax.imageio.ImageIO;
import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

class PDImageXObject_PNGConverterbuildIndexImage_LogerrorFikaTest {

    @Test
    void testCreateFromByteArrayTriggersLogError() throws IOException {
        // Create a minimal PNG byte array that will trigger the indexed color path
        // and cause buildIndexImage to be called with missing PLTE chunk
        byte[] pngBytes = createIndexedPngWithoutPLTE();
        
        try (PDDocument document = new PDDocument()) {
            // Call the entry point with null customFactory to use default PNG conversion
            PDImageXObject.createFromByteArray(document, pngBytes, "test.png", null);
        }
    }

    private byte[] createIndexedPngWithoutPLTE() throws IOException {
        // Create a 1x1 indexed PNG without PLTE chunk
        // PNG signature
        byte[] pngSignature = new byte[]{(byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A};
        
        // IHDR chunk: width=1, height=1, bitDepth=8, colorType=3 (indexed), compression=0, filter=0, interlace=0
        byte[] ihdrData = new byte[]{
            0x00, 0x00, 0x00, 0x01, // width
            0x00, 0x00, 0x00, 0x01, // height
            0x08, // bitDepth
            0x03, // colorType=3 (indexed)
            0x00, // compression
            0x00, // filter
            0x00  // interlace
        };
        
        // IDAT chunk with minimal data (1 pixel with index 0)
        byte[] idatData = new byte[]{0x00}; // filter type 0, then pixel data
        
        // IEND chunk
        byte[] iendData = new byte[]{};
        
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        baos.write(pngSignature);
        
        // Write IHDR chunk
        baos.write(intToBytes(ihdrData.length));
        baos.write("IHDR".getBytes());
        baos.write(ihdrData);
        baos.write(intToBytes(crc32("IHDR".getBytes(), ihdrData)));
        
        // Write IDAT chunk
        baos.write(intToBytes(idatData.length));
        baos.write("IDAT".getBytes());
        baos.write(idatData);
        baos.write(intToBytes(crc32("IDAT".getBytes(), idatData)));
        
        // Write IEND chunk
        baos.write(intToBytes(iendData.length));
        baos.write("IEND".getBytes());
        baos.write(iendData);
        baos.write(intToBytes(crc32("IEND".getBytes(), iendData)));
        
        return baos.toByteArray();
    }
    
    private byte[] intToBytes(int value) {
        return new byte[]{
            (byte) (value >> 24),
            (byte) (value >> 16),
            (byte) (value >> 8),
            (byte) value
        };
    }
    
    private int crc32(byte[] chunkType, byte[] data) {
        // Simplified CRC - in reality should compute proper CRC32
        // For test purposes, we'll return a dummy value
        return 0x12345678;
    }
}

