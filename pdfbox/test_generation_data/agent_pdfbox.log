package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayOutputStream;
import java.io.DataOutputStream;
import java.io.IOException;
import java.util.zip.CRC32;

class PDImageXObject_PNGConverterbuildImageObject_LogerrorFikaTest {

    @Test
    void testCreateFromByteArrayTriggersLogError() throws IOException {
        // Create a minimal valid PNG that will pass initial checks but fail in buildImageObject
        byte[] pngBytes = createPNGWithInvalidGAMAChunk();
        
        try (PDDocument document = new PDDocument()) {
            // Call the entry point method
            PDImageXObject.createFromByteArray(
                document,
                pngBytes,
                "test.png",
                null
            );
        }
    }

    private byte[] createPNGWithInvalidGAMAChunk() throws IOException {
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        DataOutputStream dos = new DataOutputStream(baos);
        
        // PNG signature
        dos.write(new byte[]{(byte) 137, 80, 78, 71, 13, 10, 26, 10});
        
        // IHDR chunk
        writeChunk(dos, "IHDR", createIHDRChunkData());
        
        // gAMA chunk with invalid length (not 4 bytes)
        byte[] invalidGAMA = new byte[]{0, 0, 0, 0, 0}; // 5 bytes instead of 4
        writeChunk(dos, "gAMA", invalidGAMA);
        
        // IDAT chunk (minimal)
        byte[] idatData = new byte[]{120, 1}; // zlib header for empty deflate block
        writeChunk(dos, "IDAT", idatData);
        
        // IEND chunk
        writeChunk(dos, "IEND", new byte[0]);
        
        dos.flush();
        return baos.toByteArray();
    }

    private byte[] createIHDRChunkData() {
        byte[] data = new byte[13];
        // width: 1
        data[0] = 0; data[1] = 0; data[2] = 0; data[3] = 1;
        // height: 1
        data[4] = 0; data[5] = 0; data[6] = 0; data[7] = 1;
        // bit depth: 8
        data[8] = 8;
        // color type: 2 (Truecolor)
        data[9] = 2;
        // compression method: 0
        data[10] = 0;
        // filter method: 0
        data[11] = 0;
        // interlace method: 0
        data[12] = 0;
        return data;
    }

    private void writeChunk(DataOutputStream dos, String type, byte[] data) throws IOException {
        // Write length
        dos.writeInt(data.length);
        
        // Write chunk type
        dos.write(type.getBytes());
        
        // Write data
        dos.write(data);
        
        // Calculate and write CRC
        CRC32 crc = new CRC32();
        crc.update(type.getBytes());
        crc.update(data);
        dos.writeInt((int) crc.getValue());
    }
}

