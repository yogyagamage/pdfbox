        PDDocument destinationDoc = Mockito.mock(PDDocument.class);
        
        PDDocumentCatalog srcCatalog = Mockito.mock(PDDocumentCatalog.class);
        PDDocumentCatalog destCatalog = Mockito.mock(PDDocumentCatalog.class);
        
        COSDictionary srcLabels = Mockito.mock(COSDictionary.class);
        COSDictionary destLabels = Mockito.mock(COSDictionary.class);
        
        COSArray srcNums = Mockito.mock(COSArray.class);
        COSArray destNums = Mockito.mock(COSArray.class);
        
        Mockito.when(sourceDoc.getDocumentCatalog()).thenReturn(srcCatalog);
        Mockito.when(destinationDoc.getDocumentCatalog()).thenReturn(destCatalog);
        Mockito.when(destinationDoc.getNumberOfPages()).thenReturn(5);
        
        Mockito.when(srcCatalog.getCOSObject()).thenReturn(Mockito.mock(COSDictionary.class));
        Mockito.when(destCatalog.getCOSObject()).thenReturn(Mockito.mock(COSDictionary.class));
        
