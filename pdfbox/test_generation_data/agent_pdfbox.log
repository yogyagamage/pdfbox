package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.graphics.image.PDInlineImage;
import org.junit.jupiter.api.Test;

import java.awt.Color;
import java.awt.Paint;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDInlineImage_SampledImageReadermethod_LogFactorygetLogFikaTest4 {

    @Test
    public void testGetStencilImageTriggersLogFactoryGetLog() throws IOException {
        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);
            
            byte[] imageData = new byte[] {
                // Minimal valid inline image data for a stencil
                0x42, 0x4D, // BM signature
                0x1E, 0x00, 0x00, 0x00, // File size
                0x00, 0x00, 0x00, 0x00, // Reserved
                0x1A, 0x00, 0x00, 0x00, // Offset to pixel data
                0x0C, 0x00, 0x00, 0x00, // DIB header size
                0x01, 0x00, 0x01, 0x00, // Width=1, Height=1
                0x01, 0x00, // Planes=1
                0x01, 0x00, // Bits per pixel=1
                0x00, 0x00, 0x00, 0x00, // Compression=BI_RGB
                0x04, 0x00, 0x00, 0x00, // Image size=4
                0x13, 0x0B, 0x00, 0x00, // Horizontal resolution
                0x13, 0x0B, 0x00, 0x00, // Vertical resolution
                0x00, 0x00, 0x00, 0x00, // Colors in palette
                0x00, 0x00, 0x00, 0x00, // Important colors
                0x00, 0x00, // Palette entry 0: black
                0xFF, 0xFF, // Palette entry 1: white
                0x00 // Pixel data (1-bit black pixel)
            };
            
            PDInlineImage inlineImage = new PDInlineImage(
                new ByteArrayInputStream(imageData),
                document,
                1, // bits per component
                1, // width
                1, // height
                new byte[] {0x00}, // decode array
                true, // stencil
                null // color space
            );
            
            Paint paint = Color.BLACK;
            inlineImage.getStencilImage(paint);
        }
    }
}

