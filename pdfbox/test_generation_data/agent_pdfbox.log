package org.apache.pdfbox.contentstream;

import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.font.PDFont;
import org.apache.pdfbox.pdmodel.font.PDType1Font;
import org.apache.pdfbox.pdmodel.PDResources;
import org.apache.pdfbox.pdmodel.graphics.state.PDGraphicsState;
import org.apache.pdfbox.pdmodel.graphics.state.PDTextState;
import org.apache.pdfbox.util.Matrix;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.InputStream;

public class PDFStreamEngineshowText_LogwarnFikaTest {

    @Test
    public void testShowTextStringTriggersLogWarn() throws IOException {
        // Create a concrete subclass to test the protected method
        PDFStreamEngine engine = new PDFStreamEngine() {
            // We need to override getGraphicsState to return a state with null font
            @Override
            public PDGraphicsState getGraphicsState() {
                PDGraphicsState state = Mockito.mock(PDGraphicsState.class);
                PDTextState textState = Mockito.mock(PDTextState.class);
                
                // Configure textState to return null font
                Mockito.when(textState.getFont()).thenReturn(null);
                Mockito.when(textState.getFontSize()).thenReturn(12.0f);
                Mockito.when(textState.getHorizontalScaling()).thenReturn(100.0f);
                Mockito.when(textState.getCharacterSpacing()).thenReturn(0.0f);
                Mockito.when(textState.getRise()).thenReturn(0.0f);
                Mockito.when(textState.getWordSpacing()).thenReturn(0.0f);
                
                Mockito.when(state.getTextState()).thenReturn(textState);
                Mockito.when(state.getTextMatrix()).thenReturn(new Matrix());
                Mockito.when(state.getCurrentTransformationMatrix()).thenReturn(new Matrix());
                
                return state;
            }
            
            @Override
            protected PDFont getDefaultFont() {
                // Return a real font to avoid NPE
                return PDType1Font.HELVETICA;
            }
        };
        
        // Initialize the engine with a page
        PDPage page = new PDPage();
        engine.processStream(page, page.getResources(), page.getContents());
        
        // Call the entry point method
        byte[] textBytes = "test".getBytes();
        engine.showTextString(textBytes);
    }
}

