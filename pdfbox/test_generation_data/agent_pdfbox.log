import javax.imageio.metadata.IIOMetadata;
import javax.imageio.metadata.IIOMetadataNode;
import javax.imageio.stream.ImageInputStream;

import org.junit.jupiter.api.Test;

class DCTFiltergetAdobeTransform_LogwarnFikaTest {

    @Test
    void testGetAdobeTransformReachesLogWarn() throws Exception {
        BufferedImage image = new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB);
        ByteArrayOutputStream original = new ByteArrayOutputStream();
        ImageIO.write(image, "jpeg", original);
        byte[] jpeg = original.toByteArray();

        Class<?> clazz = Class.forName("org.apache.pdfbox.filter.DCTFilter");
        Constructor<?> constructor = clazz.getDeclaredConstructor();
        constructor.setAccessible(true);
        Object filter = constructor.newInstance();

        Method method = clazz.getDeclaredMethod("getAdobeTransform", IIOMetadata.class);
        method.setAccessible(true);

        if (jpeg.length >= 2) {
            ByteArrayOutputStream modified = new ByteArrayOutputStream();
            int copyLength = 2;

            if (jpeg.length > 6 && (jpeg[2] & 0xFF) == 0xFF) {
                int length = ((jpeg[4] & 0xFF) << 8) | (jpeg[5] & 0xFF);
                int end = 2 + 2 + length;
                if (end > 2 && end <= jpeg.length) {
                    copyLength = end;
                }
            }

            modified.write(jpeg, 0, copyLength);
            modified.write(adobeMarker(1));
            modified.write(adobeMarker(2));
            modified.write(jpeg, copyLength, jpeg.length - copyLength);

            ImageInputStream iis = ImageIO.createImageInputStream(new ByteArrayInputStream(modified.toByteArray()));
            if (iis != null) {
                try {
                    Iterator<ImageReader> readers = ImageIO.getImageReadersByFormatName("jpeg");
                    if (readers.hasNext()) {
                        ImageReader reader = readers.next();
                        try {
                            reader.setInput(iis);

                            IIOMetadata streamMetadata = reader.getStreamMetadata();
                            try {
                                method.invoke(filter, streamMetadata);
                            } catch (Exception ignored) {
                            }

                            IIOMetadata imageMetadata = reader.getImageMetadata(0);
                            try {
                                method.invoke(filter, imageMetadata);
                            } catch (Exception ignored) {
                            }
                        } finally {
                            reader.dispose();
                        }
                    }
                } finally {
                    iis.close();
                }
            }
        }

        Iterator<ImageWriter> writers = ImageIO.getImageWritersByFormatName("jpeg");
        if (writers.hasNext()) {
            ImageWriter writer = writers.next();
            try {
                ImageWriteParam param = writer.getDefaultWriteParam();
                IIOMetadata metadata = writer.getDefaultStreamMetadata(param);

                IIOMetadataNode root = new IIOMetadataNode("javax_imageio_jpeg_image_1.0");

                IIOMetadataNode variety = new IIOMetadataNode("JPEGvariety");
                variety.setAttribute("appletype", "Adobe");
                root.appendChild(variety);

                IIOMetadataNode markerSequence = new IIOMetadataNode("markerSequence");
                root.appendChild(markerSequence);

                IIOMetadataNode adobe1 = new IIOMetadataNode("app14Adobe");
                adobe1.setAttribute("appVersion", "100");
                adobe1.setAttribute("appFlags0", "0");
                adobe1.setAttribute("appFlags1", "0");
                adobe1.setAttribute("appFlags2", "0");
                adobe1.setAttribute("transform", "1");
                markerSequence.appendChild(adobe1);

                IIOMetadataNode adobe2 = new IIOMetadataNode("app14Adobe");
                adobe2.setAttribute("appVersion", "100");
                adobe2.setAttribute("appFlags0", "0");
                adobe2.setAttribute("appFlags1", "0");
                adobe2.setAttribute("appFlags2", "0");
                adobe2.setAttribute("transform", "2");
                markerSequence.appendChild(adobe2);

                metadata.setFromTree("javax_imageio_jpeg_image_1.0", root);

                try {
                    method.invoke(filter, metadata);
                } catch (Exception ignored) {
                }
            } catch (Exception ignored) {
            } finally {
                writer.dispose();
            }
        }
    }

