                log.warn(("Cannot add XRef entry for '" + objKey.getNumber()) + 
                        "' because XRef start was not signalled.");
                return;
            }
            // Rest of implementation omitted for brevity
        }
    }
    
    private static class XrefTrailerObj {
        public HashMap<COSObjectKey, Long> xrefTable = new HashMap<>();
    }
}

