            COSNumber mockNumber = Mockito.mock(COSNumber.class);
            Mockito.when(mockNumber.floatValue()).thenReturn(1.0f);
            operands.add(mockNumber);
        }

        curveTo.process(mockOperator, operands);
    }
}

