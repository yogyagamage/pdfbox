import static org.mockito.Mockito.when;

public class SampledImageReaderfromAny_LogwarnFikaTest {

    @Test
    public void testFromAnyTriggersLogWarn() throws Exception {
        // Create PDImage mock
        PDImage pdImage = Mockito.mock(PDImage.class);
        
        // Create color space mock
        PDColorSpace colorSpace = Mockito.mock(PDColorSpace.class);
        when(pdImage.getColorSpace()).thenReturn(colorSpace);
        when(colorSpace.getNumberOfComponents()).thenReturn(3);
        
        // Create indexed color space to trigger the indexed path
        PDIndexed indexedColorSpace = Mockito.mock(PDIndexed.class);
        when(pdImage.getColorSpace()).thenReturn(indexedColorSpace);
        when(indexedColorSpace.getNumberOfComponents()).thenReturn(3);
        
        // Set bits per component
        when(pdImage.getBitsPerComponent()).thenReturn(8);
        
        // Set width and height
        when(pdImage.getWidth()).thenReturn(100);
        
        // Create a color key array with insufficient size (less than numComponents * 2)
        COSArray colorKey = new COSArray();
        colorKey.addFloat(0.5f); // Only 1 element, needs 6 for 3 components
        
        // Create raster
        WritableRaster raster = Mockito.mock(WritableRaster.class);
        
        // Create clipped rectangle
        Rectangle clipped = new Rectangle(0, 0, 50, 50);
        
        // Create input stream that will be read
        byte[] imageData = new byte[100 * 100 * 3]; // Enough data for reading
        InputStream imageStream = new ByteArrayInputStream(imageData);
        
        // Mock the createInputStream method to return our test stream
        when(pdImage.createInputStream(Mockito.any())).thenReturn(imageStream);
        
        // Call the private method using reflection
        java.lang.reflect.Method method = SampledImageReader.class.getDeclaredMethod(
            "fromAny", 
            PDImage.class, 
            WritableRaster.class, 
            COSArray.class, 
            Rectangle.class, 
            int.class, 
            int.class, 
            int.class
        );
        method.setAccessible(true);
        
        // Execute the method with parameters that will trigger the Log.warn call
        // The colorKey has size 1, which is less than numComponents*2 (6), triggering the warning
        method.invoke(
            null, 
            pdImage, 
            raster, 
            colorKey, 
            clipped, 
            1,  // subsampling
            50, // width
            50  // height
        );
    }
}

