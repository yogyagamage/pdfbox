        encryptData(objNum, genNum, data, outputStream, true);
        string.setValue(outputStream.toByteArray());
    } catch (IOException ex) // PATH: Test should invoke the next Log.error(...) [step in execution path]
    {
        LOG.error((((("Failed to decrypt COSString of length " + string.getBytes().length) + " in object ") + objNum) + ": ") + ex.getMessage(), ex);
    }
}

