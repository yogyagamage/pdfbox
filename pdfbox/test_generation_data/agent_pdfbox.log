@Override
public void createAppearanceDictionary(PDFormXObject holderForm, PDSignatureField signatureField) throws IOException // PATH: Test should invoke the next Log.info(...) [step in execution path]
{
    PDAppearanceDictionary appearance = new PDAppearanceDictionary();
    appearance.getCOSObject().setDirect(true);
    PDAppearanceStream appearanceStream = new PDAppearanceStream(holderForm.getCOSObject());
    appearance.setNormalAppearance(appearanceStream);
    signatureField.getWidgets().get(0).setAppearance(appearance);
    pdfStructure.setAppearanceDictionary(appearance);
    LOG.info("PDF appearance dictionary has been created");
}

