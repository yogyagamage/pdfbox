package org.apache.pdfbox.pdmodel.graphics.shading;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.graphics.shading.Type6ShadingPaint;
import org.apache.pdfbox.pdmodel.graphics.shading.PDShadingType6;
import org.apache.pdfbox.pdmodel.graphics.color.PDDeviceRGB;
import java.awt.geom.AffineTransform;
import java.awt.Rectangle;
import java.io.ByteArrayOutputStream;

class PDShadingType6_Type6ShadingPaintmethod_LogFactorygetLogFikaTest {

    @Test
    void testLogFactoryGetLogInvocation() throws Exception {
        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);
            
            PDShadingType6 shading = new PDShadingType6(document);
            shading.setColorSpace(PDDeviceRGB.INSTANCE);
            shading.setBBox(new PDRectangle(0, 0, 100, 100));
            
            float[] coords = {0, 0, 100, 0, 0, 100, 100, 100};
            shading.setCoords(coords);
            
            float[] domain = {0, 1};
            shading.setDomain(domain);
            
            shading.setFunction(null);
            
            try (PDPageContentStream contentStream = new PDPageContentStream(document, page)) {
                Type6ShadingPaint paint = new Type6ShadingPaint(shading, new AffineTransform());
                paint.createContext(null, new Rectangle(0, 0, 100, 100), 
                                   new Rectangle(0, 0, 100, 100), new AffineTransform(), null);
            }
            
            ByteArrayOutputStream baos = new ByteArrayOutputStream();
            document.save(baos);
        }
    }
}

