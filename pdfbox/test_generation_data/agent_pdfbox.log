        Path pdfPath = tempDir.resolve("test.pdf");
        File pdfFile = pdfPath.toFile();
        
        try (OutputStream os = Files.newOutputStream(pdfPath)) {
            // PDF header
            os.write("%PDF-1.4\n".getBytes());
            
