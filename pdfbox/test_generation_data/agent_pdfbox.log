/**
 * Create a new PDPage content stream. This constructor overwrites all existing content streams
 * of this page.
 *
 * @param document
 * 		The document the page is part of.
 * @param sourcePage
 * 		The page to write the contents to.
 * @throws IOException
 * 		If there is an error writing to the page contents.
 */
public (PDDocument document, PDPage sourcePage) throws IOException {
    this(document, sourcePage, AppendMode.OVERWRITE, true, false);
    if (sourcePageHadContents) // PATH: Test should invoke the next Log.warn(...) [step in execution path]
    {
        LOG.warn("You are overwriting an existing content, you should use the append mode");
    }
}

