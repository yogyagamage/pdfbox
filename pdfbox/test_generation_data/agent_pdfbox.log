        // Set an encoding name that doesn't exist in Encoding.getInstance()
        encodingDict.setItem(COSName.BASE_ENCODING, COSName.getPDFName("UnknownEncodingXYZ"));
        fontDict.setItem(COSName.ENCODING, encodingDict);
        
        // Create the PDTrueTypeFont - this will call readEncoding() in its constructor
        // and trigger the LOG.warn when the encoding is unknown
        PDTrueTypeFont font = new PDTrueTypeFont(fontDict);
    }
}

