    private java.security.cert.Certificate createSelfSignedCertificate(java.security.KeyPair keyPair) throws Exception {
        String dn = "CN=Test, OU=Test, O=Test, L=Test, ST=Test, C=US";
        javax.security.auth.x500.X500Principal issuer = new javax.security.auth.x500.X500Principal(dn);
        
        java.util.Date from = new java.util.Date();
        java.util.Date to = new java.util.Date(from.getTime() + 365L * 24 * 60 * 60 * 1000);
        
        java.math.BigInteger serialNumber = java.math.BigInteger.valueOf(System.currentTimeMillis());
        
        java.security.cert.X509Certificate cert = java.security.cert.CertificateFactory.getInstance("X.509")
            .generateCertificate(new java.io.ByteArrayInputStream(
