    @Test
    public void testShowTextStringsTriggersLogWarn() throws IOException {
        // Create a PageDrawer instance
        PDPage page = new PDPage();
        PDResources resources = new PDResources();
        page.setResources(resources);
        
        PageDrawerParameters params = mock(PageDrawerParameters.class);
        when(params.getPage()).thenReturn(page);
        when(params.getRenderer()).thenReturn(null);
        when(params.getSubsamplingAllowed()).thenReturn(false);
        when(params.getImageCache()).thenReturn(null);
        
        PageDrawer pageDrawer = new PageDrawer(params) {
            // Override getStroke to ensure it's called
            @Override
            protected java.awt.Stroke getStroke() {
                return super.getStroke();
            }
        };
        
        // Set up graphics state with miter limit < 1 to trigger the warning
        pageDrawer.getGraphicsState().setMiterLimit(0.5f);
        pageDrawer.getGraphicsState().setLineWidth(1.0f);
        
        // Create a COSArray with a COSString to trigger the call chain
        COSArray array = new COSArray();
        COSString text = new COSString("Test".getBytes());
        array.add(text);
        
        // Set up a simple font
        PDFont font = PDType1Font.HELVETICA;
        pageDrawer.getGraphicsState().getTextState().setFont(font);
        pageDrawer.getGraphicsState().getTextState().setFontSize(12);
        
        // Create text matrix and transformation matrix
        pageDrawer.getGraphicsState().setTextMatrix(new org.apache.pdfbox.util.Matrix());
        pageDrawer.getGraphicsState().setCurrentTransformationMatrix(
            new org.apache.pdfbox.util.Matrix());
        
        // Enable stroke rendering mode
        pageDrawer.getGraphicsState().getTextState().setRenderingMode(
            org.apache.pdfbox.rendering.RenderingMode.STROKE);
        
        // Call the entry point method
        pageDrawer.showTextStrings(array);
    }
}

