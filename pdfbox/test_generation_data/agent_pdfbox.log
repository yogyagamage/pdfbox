class FSFontInfogetTrueTypeFont_LogisDebugEnabledFikaTest {

    @Test
    void testGetTrueTypeFont(@TempDir Path tempDir) throws Exception {
        File fontFile = tempDir.resolve("test.ttf").toFile();
        fontFile.createNewFile();
        
        FSFontInfo fontInfo = new FSFontInfo();
        java.lang.reflect.Method method = FSFontInfo.class.getDeclaredMethod(
            "getTrueTypeFont", String.class, File.class);
