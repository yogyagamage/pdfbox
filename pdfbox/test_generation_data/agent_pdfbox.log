        java.lang.reflect.Field derefField = COSObject.class.getDeclaredField("isDereferenced");
        derefField.setAccessible(true);
        derefField.set(cosObject, false);
        
        // This should trigger the IOException and call Log.error(...)
        cosObject.getObject();
    }
}

