public class FontMapperImpl_FileSystemFontProviderloadDiskCache_LogwarnFikaTest {

    @TempDir
    Path tempDir;

    @Test
    public void testGetProviderTriggersLogWarn() throws IOException {
        // Create a fake font file to ensure loadDiskCache is called
        Path fontFile = tempDir.resolve("test.ttf");
        Files.createFile(fontFile);
        
        // Create a disk cache file with malformed content to trigger LOG.warn
        Path cacheDir = tempDir.resolve(".pdfbox.cache");
        Files.createDirectories(cacheDir);
        Path cacheFile = cacheDir.resolve("font.cache");
        
        // Write a malformed line with less than 10 parts to trigger the warning
        Files.writeString(cacheFile, "PostScriptName|TTF||||||||\n");
        
        // Set system property to point to our temp cache directory
        System.setProperty("pdfbox.fontcache", tempDir.toAbsolutePath().toString());
        
        // Create instance and call entry point
        FontMapperImpl fontMapper = new FontMapperImpl();
        fontMapper.getProvider();
        
        // Clean up system property
        System.clearProperty("pdfbox.fontcache");
    }
}

