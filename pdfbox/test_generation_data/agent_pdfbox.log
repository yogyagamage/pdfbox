    private PDInlineImage createInlineImageWithInvalidDecodeArray() throws IOException {
        // Create a minimal COSStream for the image data
        COSStream cosStream = new COSStream();
        cosStream.setInt(COSName.WIDTH, 10);
        cosStream.setInt(COSName.HEIGHT, 10);
        cosStream.setInt(COSName.BITS_PER_COMPONENT, 8);
        cosStream.setItem(COSName.COLORSPACE, COSName.DEVICERGB);
        
        // Create a decode array with wrong size (3 entries instead of 6 for RGB)
        COSArray decodeArray = new COSArray();
        decodeArray.add(COSInteger.ONE);
        decodeArray.add(COSInteger.ZERO);
        decodeArray.add(COSInteger.ONE); // Only 3 entries, should be 6
        cosStream.setItem(COSName.DECODE, decodeArray);
        
        // Add minimal image data (1 pixel)
        byte[] imageData = new byte[] { 100 };
        cosStream.createUnfilteredStream().write(imageData);
        
        // Create PDInlineImage
        PDInlineImage pdImage = new PDInlineImage(cosStream, null);
        
