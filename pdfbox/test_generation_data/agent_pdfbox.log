            COSNumber firstCode = ((COSNumber) (firstCodeBase));
            COSBase next = wArray.getObject(counter++);
            if (next instanceof COSArray) {
                COSArray array = ((COSArray) (next));
                int startRange = firstCode.intValue();
                int arraySize = array.size();
