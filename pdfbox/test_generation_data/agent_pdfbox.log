            PDCIDSystemInfo cidSystemInfo = descendantFont.getCIDSystemInfo();
            if (cidSystemInfo != null) {
                strName = (((cidSystemInfo.getRegistry() + "-") + cidSystemInfo.getOrdering()) + "-") + cidSystemInfo.getSupplement();
