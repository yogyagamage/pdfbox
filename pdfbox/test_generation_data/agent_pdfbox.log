import java.io.IOException;

class PDFStreamParser_BaseParserparseCOSDictionaryNameValuePair_LogwarnFikaTest {

    @Test
    void testParseNextTokenTriggersLogWarn() throws IOException {
        // Create a stream that will trigger parseCOSDictionary -> parseCOSDictionaryNameValuePair -> LOG.warn
        // We need a stream that starts with "<<" to enter parseCOSDictionary,
        // then contains "/" to enter parseCOSDictionaryNameValuePair,
        // then contains an empty name to trigger the warn.
        String streamContent = "<< / >>";
        RandomAccessRead source = new RandomAccessReadBuffer(new ByteArrayInputStream(streamContent.getBytes()));

        PDFStreamParser parser = new PDFStreamParser(source);
        
        // This should trigger the call chain:
        // parseNextToken() -> parseCOSDictionary(true) -> parseCOSDictionaryNameValuePair(obj) -> LOG.warn(...)
        parser.parseNextToken();
    }

    // Helper class to provide a simple RandomAccessRead implementation
    private static class RandomAccessReadBuffer implements RandomAccessRead {
        private final byte[] data;
        private int position;
        
        RandomAccessReadBuffer(ByteArrayInputStream stream) {
            this.data = stream.readAllBytes();
            this.position = 0;
        }
        
        @Override
        public int read() throws IOException {
            if (position >= data.length) {
                return -1;
            }
            return data[position++] & 0xFF;
        }
        
        @Override
        public int read(byte[] b, int off, int len) throws IOException {
            if (position >= data.length) {
                return -1;
            }
            int bytesToRead = Math.min(len, data.length - position);
            System.arraycopy(data, position, b, off, bytesToRead);
            position += bytesToRead;
            return bytesToRead;
        }
        
        @Override
        public long getPosition() throws IOException {
            return position;
        }
        
        @Override
        public void seek(long position) throws IOException {
            this.position = (int) position;
        }
        
        @Override
        public long length() throws IOException {
            return data.length;
        }
        
        @Override
        public boolean isClosed() {
            return false;
        }
        
        @Override
        public void close() throws IOException {
            // No-op
        }
        
        @Override
        public int peek() throws IOException {
            if (position >= data.length) {
                return -1;
            }
            return data[position] & 0xFF;
        }
        
        @Override
        public void rewind(int bytes) throws IOException {
            position = Math.max(0, position - bytes);
        }
        
        @Override
        public boolean isEOF() throws IOException {
            return position >= data.length;
        }
        
        @Override
        public int available() throws IOException {
            return Math.max(0, data.length - position);
        }
    }
}

