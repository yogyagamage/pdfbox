    @Test
    public void testCreateFromByteArrayInvokesLogDebug() throws Exception {
        // Create a PDDocument instance
        PDDocument document = new PDDocument();
        
        // Create PNG data that will trigger the path to Log.debug in buildImageObject
        // We need a PNG with a gAMA chunk where gamma != 1/2.2
        byte[] pngData = createTestPngDataWithGamma();
        
        // Call the entry point method
        PDImageXObject.createFromByteArray(document, pngData, "test.png", null);
        
        document.close();
