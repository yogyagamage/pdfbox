package org.apache.pdfbox.pdmodel.graphics.image;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import javax.imageio.ImageIO;
import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

public class PDImageXObject_JPEGFactoryretrieveDimensions_LoginfoFikaTest {

    @Test
    public void testCreateFromFileByContentInvokesLogInfo() throws IOException {
        // Create a minimal valid JPEG file in memory
        byte[] jpegData = createMinimalJPEG();
        Path tempFile = Files.createTempFile("test", ".jpg");
        Files.write(tempFile, jpegData);
        
        try (PDDocument document = new PDDocument()) {
            // This will traverse the call chain:
            // PDImageXObject.createFromFileByContent -> JPEGFactory.createFromStream -> 
            // JPEGFactory.createFromByteArray -> JPEGFactory.retrieveDimensions -> Log.info
            PDImageXObject.createFromFileByContent(tempFile.toFile(), document);
        } finally {
            Files.deleteIfExists(tempFile);
        }
    }
    
    private byte[] createMinimalJPEG() {
        // Minimal valid JPEG with SOI and EOI markers
        return new byte[] {
            (byte) 0xFF, (byte) 0xD8, // SOI (Start of Image)
            (byte) 0xFF, (byte) 0xE0, // APP0 marker
            0x00, 0x10,               // Length (16 bytes)
            'J', 'F', 'I', 'F', 0x00, // JFIF identifier
            0x01, 0x01,               // Version
            0x00,                     // Density units
            0x00, 0x01, 0x00, 0x01,   // X/Y density
            0x00, 0x00,               // Thumbnail width/height
            (byte) 0xFF, (byte) 0xC0, // SOF0 (Start of Frame)
            0x00, 0x11,               // Length (17 bytes)
            0x08,                     // Precision (8 bits)
            0x00, 0x01,               // Height (1 pixel)
            0x00, 0x01,               // Width (1 pixel)
            0x03,                     // Number of components
            0x01, 0x11, 0x00,         // Component 1
            0x02, 0x11, 0x00,         // Component 2
            0x03, 0x11, 0x00,         // Component 3
            (byte) 0xFF, (byte) 0xC4, // DHT (Define Huffman Table)
            0x00, 0x14,               // Length (20 bytes)
            0x00,                     // Table class (0 = DC)
            0x00, 0x01, 0x05, 0x01,   // Huffman codes
            0x01, 0x01, 0x01, 0x01,
            0x01, 0x01, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00,
            (byte) 0xFF, (byte) 0xDA, // SOS (Start of Scan)
            0x00, 0x0C,               // Length (12 bytes)
            0x03,                     // Number of components
            0x01, 0x00,               // Component 1
            0x02, 0x11,               // Component 2
            0x03, 0x11,               // Component 3
            0x00, 0x3F, 0x00,         // Spectral selection
            (byte) 0x00,              // Encoded data (minimal)
            (byte) 0xFF, (byte) 0xD9  // EOI (End of Image)
        };
    }
}

