import java.awt.print.PageFormat;
import java.awt.print.Paper;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

class PDFPrintableprint_LogdebugFikaTest {

    @Test
    void testPrintInvokesLogDebug() throws Exception {
        // Create a minimal PDDocument with at least one page
        PDDocument document = new PDDocument();
        PDPage page = new PDPage();
        document.addPage(page);
        
        // Create PDFPrintable with RASTERIZE_DPI_AUTO to trigger the debug log
        PDFPrintable printable = new PDFPrintable(
                document,
                PDFPrintable.Scaling.SHRINK_TO_FIT,
                false,
                PDFPrintable.RASTERIZE_DPI_AUTO,
                true
        );
        
        // Create a Graphics object that can be cast to Graphics2D
        BufferedImage image = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics2D = image.createGraphics();
        
        // Create a PageFormat with imageable area
        PageFormat pageFormat = new PageFormat();
        Paper paper = new Paper();
        paper.setSize(200, 200);
        paper.setImageableArea(10, 10, 180, 180);
        pageFormat.setPaper(paper);
        
        // Call the entry point method
        printable.print(graphics2D, pageFormat, 0);
        
        // Clean up
        graphics2D.dispose();
        document.close();
    }
}

