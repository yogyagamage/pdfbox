package org.apache.pdfbox.pdfparser;

import org.apache.pdfbox.cos.COSDocument;
import org.apache.pdfbox.pdfparser.COSParser;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.lang.reflect.Method;

class COSParserinit_LogwarnFikaTest {

    @Test
    void testInitInvokesLogWarn() throws Exception {
        // Create a real COSParser instance
        COSParser parser = new COSParser();
        
        // Create a mock StreamCacheCreateFunction
        StreamCacheCreateFunction mockFunction = Mockito.mock(StreamCacheCreateFunction.class);
        
        // Set system property to trigger the NumberFormatException path
        System.setProperty(COSParser.SYSPROP_EOFLOOKUPRANGE, "notAnInteger");
        
        try {
            // Use reflection to access the private init method
            Method initMethod = COSParser.class.getDeclaredMethod(
                "init", 
                StreamCacheCreateFunction.class
            );
            initMethod.setAccessible(true);
            
            // Invoke the method - this should trigger the Log.warn() call
            initMethod.invoke(parser, mockFunction);
        } finally {
            // Clean up system property
            System.clearProperty(COSParser.SYSPROP_EOFLOOKUPRANGE);
        }
    }
}

