import org.apache.pdfbox.rendering.PageDrawer;
import org.apache.pdfbox.rendering.PageDrawerParameters;
import org.apache.pdfbox.rendering.TilingPaintFactory;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.awt.geom.AffineTransform;
import java.io.IOException;
import java.lang.reflect.Field;

class PageDrawer_TilingPaintgetAnchorRect_LogwarnFikaTest {

    @Test
    void testStrokePathTriggersLogWarn() throws Exception {
        // Create mocks for required dependencies
        PageDrawerParameters params = Mockito.mock(PageDrawerParameters.class);
        PDPage page = Mockito.mock(PDPage.class);
        Mockito.when(params.getPage()).thenReturn(page);
        Mockito.when(page.getCropBox()).thenReturn(new PDRectangle(0, 0, 100, 100));
        
        // Create PageDrawer instance
        PageDrawer drawer = new PageDrawer(params);
        
        // Create a PDTilingPattern with XStep = 0 to trigger the warning log
        PDTilingPattern pattern = Mockito.mock(PDTilingPattern.class);
        Mockito.when(pattern.getXStep()).thenReturn(0f);
        Mockito.when(pattern.getYStep()).thenReturn(10f);
        Mockito.when(pattern.getBBox()).thenReturn(new PDRectangle(0, 0, 50, 50));
        Mockito.when(pattern.getPaintType()).thenReturn(PDTilingPattern.PAINT_COLORED);
        Mockito.when(pattern.getMatrix()).thenReturn(new org.apache.pdfbox.util.Matrix());
        
        // Create a PDColor that uses the pattern
        PDColor color = Mockito.mock(PDColor.class);
        PDPattern patternSpace = Mockito.mock(PDPattern.class);
        Mockito.when(color.getColorSpace()).thenReturn(patternSpace);
        Mockito.when(patternSpace.getPattern(color)).thenReturn(pattern);
        
        // Use reflection to set up the graphics state to return our pattern color
        setGraphicsStateStrokingColor(drawer, color);
        
        // Use reflection to ensure isContentRendered() returns true
        setContentRendered(drawer, true);
        
        // Invoke the entry point method
        drawer.strokePath();
    }
    
    private void setGraphicsStateStrokingColor(PageDrawer drawer, PDColor color) throws Exception {
        Field gsField = PageDrawer.class.getDeclaredField("graphicsState");
        gsField.setAccessible(true);
        org.apache.pdfbox.pdmodel.graphics.state.PDGraphicsState gs = 
            (org.apache.pdfbox.pdmodel.graphics.state.PDGraphicsState) gsField.get(drawer);
        
        if (gs == null) {
            gs = new org.apache.pdfbox.pdmodel.graphics.state.PDGraphicsState();
            gsField.set(drawer, gs);
        }
        
        gs.setStrokingColor(color);
    }
    
    private void setContentRendered(PageDrawer drawer, boolean rendered) throws Exception {
        Field renderedField = PageDrawer.class.getDeclaredField("contentRendered");
        renderedField.setAccessible(true);
        renderedField.set(drawer, rendered);
    }
}

