    void testEntryPointToThirdPartyMethod() throws IOException {
        // Create minimal COSArray structure required by PDDeviceN constructor
        COSArray deviceNArray = new COSArray();
        
        // Add required elements to avoid IndexOutOfBoundsException
        // Index 0: ALTERNATE_CS - needs a valid color space dictionary
        COSDictionary alternateDict = new COSDictionary();
        alternateDict.setItem(COSName.TYPE, COSName.COLORSPACE);
        alternateDict.setItem(COSName.SUBTYPE, COSName.DEVICERGB);
        deviceNArray.add(alternateDict);
        
        // Index 1: TINT_TRANSFORM - needs a valid function dictionary
        COSDictionary functionDict = new COSDictionary();
        functionDict.setItem(COSName.TYPE, COSName.FUNCTION);
