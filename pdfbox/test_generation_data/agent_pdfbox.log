import java.io.IOException;
import java.nio.file.Path;

public class FontMapperImpl_FileSystemFontProvideraddTrueTypeFontImpl_LogwarnFikaTest {

    @TempDir
    private Path tempDir;

    @Test
    public void testGetProviderTriggersLogWarn() throws IOException {
        // Create a TTF file with a pipe character in its name to trigger the warning
        File ttfFile = tempDir.resolve("testFont.ttf").toFile();
        
        // Write minimal TTF header that will be parsed correctly but have a pipe in the name
        try (FileOutputStream fos = new FileOutputStream(ttfFile)) {
            // TTF header: version 0x00010000 (TrueType), numTables=1
            // We need enough structure for FontHeaders parsing
            byte[] header = new byte[] {
                0x00, 0x01, 0x00, 0x00, // version 1.0
                0x00, 0x01, 0x00, 0x00, // numTables = 1
                0x00, 0x10, 0x00, 0x00, // searchRange
                0x00, 0x01, 0x00, 0x00, // entrySelector
                0x00, 0x00, 0x00, 0x00  // rangeShift
            };
            fos.write(header);
            
            // Table directory entry for "name" table
            byte[] nameEntry = new byte[] {
                0x6E, 0x61, 0x6D, 0x65, // tag = "name"
                0x00, 0x00, 0x00, 0x00, // checksum (ignored)
                0x00, 0x00, 0x00, 0x20, // offset = 32
                0x00, 0x00, 0x00, 0x20  // length = 32
            };
            fos.write(nameEntry);
            
            // Pad to offset 32
            fos.write(new byte[12]);
            
            // "name" table structure
            // format = 0, count = 1, stringOffset = 6
            byte[] nameTable = new byte[] {
                0x00, 0x00, // format = 0
                0x00, 0x01, // count = 1
                0x00, 0x06  // stringOffset = 6
            };
            fos.write(nameTable);
            
            // Name record: platformID=1 (Mac), encodingID=0, languageID=0, 
            // nameID=6 (PostScript name), length=8, offset=0
            byte[] nameRecord = new byte[] {
                0x00, 0x01, // platformID = 1 (Mac)
                0x00, 0x00, // encodingID = 0
                0x00, 0x00, // languageID = 0
                0x00, 0x06, // nameID = 6 (PostScript name)
                0x00, 0x08, // length = 8
                0x00, 0x00  // offset = 0 (relative to stringOffset)
            };
            fos.write(nameRecord);
            
            // String data: "Test|Font" (8 bytes) - contains pipe character
            byte[] nameString = "Test|Font".getBytes("UTF-16BE");
            fos.write(nameString);
