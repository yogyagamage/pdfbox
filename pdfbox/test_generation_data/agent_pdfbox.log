            0x08, // bitDepth
            0x03, // colorType (indexed)
            0x00, // compression
            0x00, // filter
            0x00  // interlace
        };
        byte[] ihdrChunk = createChunk("IHDR", ihdrData);
        
        // PLTE chunk: 3 colors (RGB triplets)
