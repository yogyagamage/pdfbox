        cosDict.setInt(COSName.LENGTH, 40);
        COSObject cosObject = new COSObject(cosDict);
        Mockito.when(encryption.getCOSObject()).thenReturn(cosObject);
        
        // Create document ID array
        COSArray documentIDArray = new COSArray();
        documentIDArray.add(COSName.ID);
        
        // Create decryption material
        StandardDecryptionMaterial material = new StandardDecryptionMaterial("");
        
        // Create security handler
        StandardSecurityHandler handler = new StandardSecurityHandler();
        
        // Execute the method - should trigger LOG.warn when newLength < dicLength
        handler.prepareForDecryption(encryption, documentIDArray, material);
    }
}

