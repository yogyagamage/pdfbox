    @Test
    public void testShowTextLineProcessTriggersLogWarn() throws IOException {
        // Create necessary PDF objects
        PDDocument document = new PDDocument();
        PDFStreamEngine engine = new PDFStreamEngine() {
            // Override to provide resources with ExtGState containing FONT key
            @Override
            public PDResources getResources() {
                PDResources resources = new PDResources();
                
                // Create a font dictionary that will lead to PDCIDFontType0
                COSDictionary fontDict = new COSDictionary();
                fontDict.setItem(COSName.TYPE, COSName.FONT);
                fontDict.setItem(COSName.SUBTYPE, COSName.TYPE0);
                
                // Create descendant font array with CIDFontType0
                COSArray descendantFonts = new COSArray();
                COSDictionary cidFontDict = new COSDictionary();
                cidFontDict.setItem(COSName.TYPE, COSName.FONT);
                cidFontDict.setItem(COSName.SUBTYPE, COSName.CID_FONT_TYPE0);
                
                // Add W array with invalid first element to trigger Log.warn
                COSArray wArray = new COSArray();
                wArray.add(COSName.getPDFName("Invalid")); // Non-number to trigger warning
                wArray.add(new COSArray()); // Empty array
                cidFontDict.setItem(COSName.W, wArray);
                
                descendantFonts.add(cidFontDict);
                fontDict.setItem(COSName.DESCENDANT_FONTS, descendantFonts);
                
                // Create encoding
                fontDict.setItem(COSName.ENCODING, COSName.IDENTITY_H);
                
                try {
                    // Create the Type0 font
                    PDType0Font type0Font = new PDType0Font(fontDict);
                    
                    // Create font setting
                    PDFontSetting fontSetting = new PDFontSetting(type0Font, 12.0f);
                    
                    // Create ExtGState dictionary with FONT entry
                    COSDictionary gsDict = new COSDictionary();
                    COSArray fontArray = new COSArray();
                    fontArray.add(fontSetting.getCOSObject());
                    gsDict.setItem(COSName.FONT, fontArray);
                    
                    PDExtendedGraphicsState extGState = new PDExtendedGraphicsState(gsDict);
                    resources.putExtGState(COSName.getPDFName("GS1"), extGState);
                    
                } catch (IOException e) {
                    // Ignore for test purposes
                }
                
                return resources;
            }
            
            @Override
            public PDGraphicsState getGraphicsState() {
                return new PDGraphicsState();
            }
        };
        
        // Create ShowTextLine instance
        ShowTextLine showTextLine = new ShowTextLine(engine);
        
        // Create operator and arguments that will trigger the FONT path
        Operator operator = Operator.getOperator(OperatorName.SHOW_TEXT_LINE);
        List<COSBase> arguments = new ArrayList<>();
        
        // Add the graphics state name as argument
        arguments.add(COSName.getPDFName("GS1"));
        
        // Call the entry point method
        try {
            showTextLine.process(operator, arguments);
        } catch (IOException e) {
            // Expected in some paths, ignore for test
        }
        
        document.close();
    }
}

