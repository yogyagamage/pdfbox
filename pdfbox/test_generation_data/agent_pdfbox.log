package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject;
import org.apache.pdfbox.pdmodel.graphics.image.CustomFactory;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

public class PDImageXObject_PNGConvertercreateCOSStreamwithIccProfile_LogerrorFikaTest {

    @Test
    public void testCreateFromByteArrayTriggersLogError() throws IOException {
        // Create a minimal valid PNG that will trigger the error path in createCOSStreamwithIccProfile
        byte[] pngBytes = createPNGWithInvalidICCPChunk();
        
        // Create required objects
        try (PDDocument document = new PDDocument()) {
            // Call the entry point method
            PDImageXObject.createFromByteArray(document, pngBytes, "test.png", null);
        }
    }

    private byte[] createPNGWithInvalidICCPChunk() {
        // Build a PNG that will be parsed and reach the error log in createCOSStreamwithIccProfile
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        
        // PNG signature
        baos.write(new byte[]{(byte)0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A});
        
        // IHDR chunk (13 bytes data)
        writeChunk(baos, "IHDR", new byte[]{
            0x00, 0x00, 0x00, 0x01, // width = 1
            0x00, 0x00, 0x00, 0x01, // height = 1
            0x08, // bit depth = 8
            0x02, // color type = 2 (truecolor)
            0x00, // compression method = 0
            0x00, // filter method = 0
            0x00  // interlace method = 0
        });
        
        // iCCP chunk with invalid data (too few bytes after name)
        // Chunk data: name "test" + null terminator + compression method + no profile data
        writeChunk(baos, "iCCP", new byte[]{
            't', 'e', 's', 't', 0x00, // name + null terminator
            0x00 // compression method = 0
            // No profile data - this makes iccProfileDataStart >= state.iCCP.length
            // which triggers the LOG.error("Invalid iCCP chunk, to few bytes")
        });
        
        // IDAT chunk (minimal valid data for 1x1 RGB image)
        writeChunk(baos, "IDAT", new byte[]{
            0x00, // filter type = 0
            0x00, 0x00, 0x00 // RGB pixel (black)
        });
        
        // IEND chunk
        writeChunk(baos, "IEND", new byte[0]);
        
        return baos.toByteArray();
    }

    private void writeChunk(ByteArrayOutputStream baos, String type, byte[] data) {
        // Write length (big-endian)
        int length = data.length;
        baos.write((length >> 24) & 0xFF);
        baos.write((length >> 16) & 0xFF);
        baos.write((length >> 8) & 0xFF);
        baos.write(length & 0xFF);
        
        // Write type
        try {
            baos.write(type.getBytes("ASCII"));
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Write data
        baos.write(data, 0, data.length);
        
        // Calculate and write CRC (simplified - using dummy CRC for test)
        // In reality we should calculate proper CRC, but for test purposes
        // we'll use a dummy value that won't cause parsing to fail immediately
        baos.write(0x00);
        baos.write(0x00);
        baos.write(0x00);
        baos.write(0x00);
    }
}

