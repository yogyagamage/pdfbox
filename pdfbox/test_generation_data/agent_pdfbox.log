    void testCreateFontTriggersDictionaryEncodingStaticInitializer() throws Exception {
        // Create a font dictionary with TrueType subtype to trigger PDTrueTypeFont path
        COSDictionary fontDict = new COSDictionary();
        fontDict.setItem(COSName.TYPE, COSName.FONT);
