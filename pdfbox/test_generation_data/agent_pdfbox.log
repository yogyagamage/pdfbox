package org.apache.pdfbox.rendering;

import org.apache.pdfbox.rendering.PageDrawer;
import org.apache.pdfbox.rendering.PageDrawerParameters;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;

public class PageDrawer_SetFontAndSizemethod_LogFactorygetLogFikaTest {

    @Test
    public void testLogFactoryGetLogInvoked() throws IOException {
        // Create real PDPage
        PDDocument document = new PDDocument();
        PDPage page = new PDPage();
        document.addPage(page);
        
        // Create mock PageDrawerParameters with minimal required behavior
        PageDrawerParameters parameters = Mockito.mock(PageDrawerParameters.class);
        Mockito.when(parameters.getPage()).thenReturn(page);
        Mockito.when(parameters.getRenderer()).thenReturn(null);
        Mockito.when(parameters.isSubsamplingAllowed()).thenReturn(false);
        Mockito.when(parameters.getDestination()).thenReturn(null);
        Mockito.when(parameters.getRenderingHints()).thenReturn(null);
        Mockito.when(parameters.getImageDownscalingOptimizationThreshold()).thenReturn(0.0f);
        
        // Instantiate PageDrawer - this will trigger the static initialization
        // of SetFontAndSize which calls LogFactory.getLog()
        new PageDrawer(parameters);
        
        document.close();
    }
}

