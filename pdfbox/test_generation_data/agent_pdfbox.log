        Mockito.when(cryptFilterDict.getCOSObject()).thenReturn(cryptFilterCosDict);
        Mockito.when(cryptFilterDict.getCryptFilterMethod()).thenReturn(COSName.AESV2);
        
        // Create recipients array with at least one recipient
        COSArray recipientsArray = new COSArray();
        
