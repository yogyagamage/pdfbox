package org.apache.pdfbox.multipdf;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDDocumentCatalog;
import org.apache.pdfbox.pdmodel.PDDocumentInformation;
import org.junit.jupiter.api.Test;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.cos.COSBase;
import java.io.IOException;
import java.util.List;

public class Splitter_PDDocumentgetVersion_LogerrorFikaTest {

    @Test
    public void testSplitTriggersLogError() throws IOException {
        // Create a source PDDocument with a catalog version that will cause NumberFormatException
        PDDocument sourceDocument = new PDDocument();
        
        // Create a document catalog with a non-numeric version string to trigger NumberFormatException
        PDDocumentCatalog catalog = sourceDocument.getDocumentCatalog();
        COSDictionary catalogDict = catalog.getCOSObject();
        // Set a non-numeric version in the catalog to trigger the error
        catalogDict.setString(COSName.VERSION, "not-a-float");
        
        // Ensure header version is >= 1.4 to enter the branch where catalog version is checked
        sourceDocument.getDocument().setVersion(1.4f);
        
        // Create Splitter instance using default constructor
        Splitter splitter = new Splitter();
        
        // Configure splitter to process at least one page
        splitter.setStartPage(1);
        splitter.setEndPage(1);
        splitter.setSplitAtPage(1);
        
        // Execute the entry point method
        List<PDDocument> result = splitter.split(sourceDocument);
        
        // Close all documents to avoid resource leaks
        for (PDDocument doc : result) {
            doc.close();
        }
        sourceDocument.close();
    }
}

