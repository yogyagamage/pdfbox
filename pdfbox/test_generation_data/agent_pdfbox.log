public class PDFParser_COSParserparseXrefTable_LogwarnFikaTest {

    @Test
    public void testParsePathToLogWarn() throws IOException {
        // Create a minimal PDF content that will trigger the path to parseXrefTable
        // The content is designed to have an xref table that starts with "trailer"
        // which will trigger the LOG.warn("skipping empty xref table") call
        String pdfContent = "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<< /Type /Catalog /Pages 2 0 R >>\n" +
                "endobj\n" +
                "2 0 obj\n" +
                "<< /Type /Pages /Kids [] /Count 0 >>\n" +
                "endobj\n" +
                "xref\n" +
                "trailer\n" +
                "<< /Size 3 /Root 1 0 R >>\n" +
                "startxref\n" +
                "0\n" +
                "%%EOF";
        
        byte[] pdfBytes = pdfContent.getBytes();
        RandomAccessRead source = new RandomAccessRead() {
            private int position = 0;
            
            @Override
            public int read() throws IOException {
                if (position >= pdfBytes.length) {
                    return -1;
                }
                return pdfBytes[position++] & 0xFF;
            }
            
            @Override
            public int read(byte[] b, int off, int len) throws IOException {
                if (position >= pdfBytes.length) {
                    return -1;
                }
                int bytesToRead = Math.min(len, pdfBytes.length - position);
                System.arraycopy(pdfBytes, position, b, off, bytesToRead);
                position += bytesToRead;
                return bytesToRead;
            }
            
            @Override
            public long getPosition() throws IOException {
                return position;
            }
            
            @Override
            public void seek(long pos) throws IOException {
                if (pos < 0 || pos > pdfBytes.length) {
                    throw new IOException("Position out of bounds");
                }
                position = (int) pos;
            }
            
            @Override
            public long length() throws IOException {
                return pdfBytes.length;
            }
            
            @Override
            public void close() throws IOException {
                // Nothing to close
            }
            
            @Override
            public boolean isClosed() {
                return false;
            }
            
            @Override
            public int peek() throws IOException {
                if (position >= pdfBytes.length) {
                    return -1;
                }
                return pdfBytes[position] & 0xFF;
            }
            
            @Override
            public void rewind(int bytes) throws IOException {
                position = Math.max(0, position - bytes);
            }
            
            @Override
            public byte[] readFully(int length) throws IOException {
                byte[] result = new byte[length];
                int bytesRead = read(result, 0, length);
                if (bytesRead < length) {
                    byte[] trimmed = new byte[bytesRead];
                    System.arraycopy(result, 0, trimmed, 0, bytesRead);
                    return trimmed;
                }
                return result;
            }
            
            @Override
            public boolean isEOF() throws IOException {
                return position >= pdfBytes.length;
            }
            
            @Override
            public RandomAccessReadView createView(long startPosition, long streamLength) throws IOException {
                throw new UnsupportedOperationException();
            }
        };
        
        // Use the simplest constructor
        PDFParser parser = new PDFParser(source);
        
        // Call the entry point method with lenient=true to ensure we take the path
        // that calls initialParse() and eventually reaches parseXrefTable
        parser.parse(true);
    }
}

