            fos.write(2);    // Binary segment type
            fos.write(new byte[]{4, 0, 0, 0}); // Length = 4
            fos.write(new byte[]{0, 0, 0, 0}); // Binary data
            
            // End marker
            fos.write(0x80);
            fos.write(3);    // End marker type
            fos.write(new byte[]{0, 0, 0, 0}); // Zero length
        }
        
