package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDImageXObject_JBIG2FilterlogLevigoDonated_LoginfoFikaTest {

    @Test
    public void testLogLevigoDonated() throws IOException {
        // Create a PDDocument instance
        PDDocument document = new PDDocument();
        
        // Create a PNG file header that will be detected as PNG
        // and trigger the indexed color path with transparency
        byte[] pngBytes = createIndexedPngWithTransparency();
        
        // Call the entry point method
        PDImageXObject.createFromByteArray(document, pngBytes, "test.png");
        
        // Close the document
        document.close();
    }
    
    private byte[] createIndexedPngWithTransparency() {
        // PNG signature
        byte[] signature = new byte[] {
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk (13 bytes data + 4 bytes length + 4 bytes type + 4 bytes CRC)
        // Width: 1, Height: 1, Bit depth: 8, Color type: 3 (indexed), 
        // Compression: 0, Filter: 0, Interlace: 0
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x01, // width = 1
            0x00, 0x00, 0x00, 0x01, // height = 1
            0x08,                   // bit depth = 8
            0x03,                   // color type = 3 (indexed)
            0x00,                   // compression method = 0
            0x00,                   // filter method = 0
            0x00                    // interlace method = 0
        };
        
        // PLTE chunk (3 colors: RGB triplets)
        byte[] plteData = new byte[] {
            0x00, 0x00, 0x00,       // color 0: black
            0xFF, 0x00, 0x00,       // color 1: red
            0x00, 0xFF, 0x00        // color 2: green
        };
        
        // tRNS chunk (transparency for indexed: 3 bytes for 3 palette entries)
        byte[] trnsData = new byte[] {
            0x00,                   // palette index 0: fully transparent
            0x80,                   // palette index 1: half transparent
            0xFF                    // palette index 2: fully opaque
        };
        
        // IDAT chunk - contains the actual image data
        // For a 1x1 indexed image with bit depth 8, we need 1 byte
        byte[] idatData = new byte[] {
            0x00                    // pixel using palette index 0
        };
        
        // IEND chunk (no data)
        
        // Build the complete PNG
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        
        // Write signature
        baos.write(signature, 0, signature.length);
        
        // Write IHDR chunk
        writeChunk(baos, "IHDR".getBytes(), ihdrData);
        
        // Write PLTE chunk
        writeChunk(baos, "PLTE".getBytes(), plteData);
        
        // Write tRNS chunk
        writeChunk(baos, "tRNS".getBytes(), trnsData);
        
        // Write IDAT chunk
        writeChunk(baos, "IDAT".getBytes(), idatData);
        
        // Write IEND chunk
        writeChunk(baos, "IEND".getBytes(), new byte[0]);
        
        return baos.toByteArray();
    }
    
    private void writeChunk(ByteArrayOutputStream baos, byte[] chunkType, byte[] data) {
        // Write length (4 bytes, big-endian)
        int length = data.length;
        baos.write((length >> 24) & 0xFF);
        baos.write((length >> 16) & 0xFF);
        baos.write((length >> 8) & 0xFF);
        baos.write(length & 0xFF);
        
        // Write chunk type
        baos.write(chunkType, 0, 4);
        
        // Write data
        baos.write(data, 0, data.length);
        
        // Calculate and write CRC (simplified - using dummy CRC for test)
        // In a real test, we would calculate actual CRC
        int crc = 0x12345678; // Dummy CRC
        baos.write((crc >> 24) & 0xFF);
        baos.write((crc >> 16) & 0xFF);
        baos.write((crc >> 8) & 0xFF);
        baos.write(crc & 0xFF);
    }
    
    // Helper class since we can't use anonymous inner classes
    private static class ByteArrayOutputStream extends java.io.ByteArrayOutputStream {
        // Using the standard ByteArrayOutputStream
    }
}

