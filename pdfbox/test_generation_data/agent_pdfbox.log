package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayOutputStream;
import java.io.DataOutputStream;
import java.io.IOException;
import java.util.zip.CRC32;

class PDImageXObject_PNGConverterbuildImageObject_LogdebugFikaTest {

    @Test
    void testCreateFromByteArrayTriggersLogDebug() throws IOException {
        // Create a minimal valid PNG that will follow the desired path
        byte[] pngBytes = createPNGWithGamma();
        
        try (PDDocument document = new PDDocument()) {
            // Call the entry point method
            PDImageXObject.createFromByteArray(
                document,
                pngBytes,
                "test.png",
                null
            );
        }
    }

    private byte[] createPNGWithGamma() throws IOException {
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        DataOutputStream dos = new DataOutputStream(baos);
        
        // PNG signature
        dos.write(new byte[]{(byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A});
        
        // IHDR chunk
        writeChunk(dos, "IHDR", createIHDR());
        
        // gAMA chunk with gamma != 1/2.2 (0.45455) to trigger the debug log
        // Using gamma = 1.0 (stored as 1/1.0 = 1.0 in fixed-point 32-bit)
        writeChunk(dos, "gAMA", createGammaChunk(1.0f));
        
        // IDAT chunk (minimal valid data for PNG with color type 2, bit depth 8)
        writeChunk(dos, "IDAT", createIDAT());
        
        // IEND chunk
        writeChunk(dos, "IEND", new byte[0]);
        
        dos.flush();
        return baos.toByteArray();
    }

    private byte[] createIHDR() {
        byte[] ihdr = new byte[13];
        // Width: 2 pixels
        ihdr[0] = 0; ihdr[1] = 0; ihdr[2] = 0; ihdr[3] = 2;
        // Height: 2 pixels
        ihdr[4] = 0; ihdr[5] = 0; ihdr[6] = 0; ihdr[7] = 2;
        // Bit depth: 8
        ihdr[8] = 8;
        // Color type: 2 (Truecolor)
        ihdr[9] = 2;
        // Compression method: 0
        ihdr[10] = 0;
        // Filter method: 0
        ihdr[11] = 0;
        // Interlace method: 0
        ihdr[12] = 0;
        return ihdr;
    }

    private byte[] createGammaChunk(float gamma) {
        byte[] data = new byte[4];
        int gammaInt = (int) (1.0f / gamma * 100000);
        data[0] = (byte) ((gammaInt >> 24) & 0xFF);
        data[1] = (byte) ((gammaInt >> 16) & 0xFF);
        data[2] = (byte) ((gammaInt >> 8) & 0xFF);
        data[3] = (byte) (gammaInt & 0xFF);
        return data;
    }

    private byte[] createIDAT() throws IOException {
        // Minimal valid IDAT for 2x2 RGB image (color type 2, bit depth 8)
        // Each row: filter byte (0) + 2 pixels * 3 bytes = 7 bytes
        ByteArrayOutputStream rowData = new ByteArrayOutputStream();
        rowData.write(0); // Filter type 0 for first row
        rowData.write(new byte[]{255, 0, 0, 0, 255, 0}); // 2 RGB pixels
        
        rowData.write(0); // Filter type 0 for second row
        rowData.write(new byte[]{0, 0, 255, 255, 255, 255}); // 2 RGB pixels
        
        // Compress the data (using deflate)
        java.util.zip.Deflater deflater = new java.util.zip.Deflater();
        deflater.setInput(rowData.toByteArray());
        deflater.finish();
        
        ByteArrayOutputStream compressed = new ByteArrayOutputStream();
        byte[] buffer = new byte[1024];
        while (!deflater.finished()) {
            int count = deflater.deflate(buffer);
            compressed.write(buffer, 0, count);
        }
        deflater.end();
        
        return compressed.toByteArray();
    }

    private void writeChunk(DataOutputStream dos, String type, byte[] data) throws IOException {
        // Write length
        dos.writeInt(data.length);
        
        // Write type
        dos.writeBytes(type);
        
        // Write data
        dos.write(data);
        
        // Calculate and write CRC
        CRC32 crc = new CRC32();
        crc.update(type.getBytes());
        crc.update(data);
        dos.writeInt((int) crc.getValue());
    }
}

