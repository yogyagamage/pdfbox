package org.apache.pdfbox.pdmodel;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.digitalsignature.PDSignature;
import org.apache.pdfbox.pdmodel.interactive.digitalsignature.SignatureInterface;
import org.apache.pdfbox.pdmodel.interactive.digitalsignature.SignatureOptions;
import org.apache.pdfbox.pdmodel.interactive.form.PDAcroForm;
import org.apache.pdfbox.pdmodel.interactive.form.PDSignatureField;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDDocument_PDSignatureFieldmethod_LogFactorygetLogFikaTest {

    @Test
    public void testAddSignatureTriggersStaticInitializer() throws IOException {
        // Create a real PDDocument instance
        PDDocument document = new PDDocument();
        
        // Create a mock SignatureInterface
        SignatureInterface signatureInterface = Mockito.mock(SignatureInterface.class);
        
        // Create a real SignatureOptions
        SignatureOptions options = new SignatureOptions();
        
        // Create a real PDSignature
        PDSignature signature = new PDSignature();
        
        // Add a page to the document to avoid "Cannot sign an empty document" exception
        document.addPage(new org.apache.pdfbox.pdmodel.PDPage());
        
        // Create a mock PDAcroForm to avoid NPE when getting field iterator
        PDAcroForm acroForm = Mockito.mock(PDAcroForm.class);
        Mockito.when(acroForm.getFieldIterator()).thenReturn(java.util.Collections.emptyIterator());
        Mockito.when(acroForm.getFields()).thenReturn(new java.util.ArrayList<>());
        Mockito.when(acroForm.getCOSObject()).thenReturn(new org.apache.pdfbox.cos.COSDictionary());
        
        // Set the acroform in the document catalog
        org.apache.pdfbox.pdmodel.PDDocumentCatalog catalog = document.getDocumentCatalog();
        catalog.setAcroForm(acroForm);
        
        // This call will trigger the static initializer of PDSignatureField
        // which calls LogFactory.getLog(PDSignatureField.class)
        document.addSignature(signature, signatureInterface, options);
        
        // Close the document
        document.close();
    }
}

