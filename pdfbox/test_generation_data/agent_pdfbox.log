package org.apache.pdfbox.pdmodel.interactive.annotation.handlers;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationFreeText;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAppearanceStream;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAppearanceDictionary;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

class PDFreeTextAppearanceHandler_BaseParsermethod_LogwarnFikaTest {

    @Test
    void testGenerateNormalAppearanceTriggersBaseParserStaticInitializer() throws IOException {
        PDDocument document = new PDDocument();
        PDPage page = new PDPage();
        document.addPage(page);
        
        PDAnnotationFreeText annotation = new PDAnnotationFreeText();
        annotation.setRectangle(new PDRectangle(100, 100, 200, 50));
        annotation.setContents("Test annotation");
        
        COSDictionary appearanceDict = new COSDictionary();
        PDAppearanceStream appearanceStream = new PDAppearanceStream(document);
        appearanceDict.setItem(COSName.N, appearanceStream);
        PDAppearanceDictionary appearance = new PDAppearanceDictionary(appearanceDict);
        annotation.setAppearance(appearance);
        
        annotation.setDefaultAppearance("/Helv 10 Tf 0 g");
        
        PDFreeTextAppearanceHandler handler = new PDFreeTextAppearanceHandler(annotation, document);
        handler.generateNormalAppearance();
        
        document.close();
    }
}

