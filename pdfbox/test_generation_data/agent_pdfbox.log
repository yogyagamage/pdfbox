    private byte[] createTestPngDataWithGamma() throws Exception {
        // PNG signature
        byte[] pngSignature = new byte[] {
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk - 13 bytes data
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x01,  // width = 1
            0x00, 0x00, 0x00, 0x01,  // height = 1
            0x08,                     // bit depth = 8
            0x02,                     // color type = 2 (Truecolor)
            0x00,                     // compression method = 0
            0x00,                     // filter method = 0
            0x00                      // interlace method = 0
        };
        
        // gAMA chunk - 4 bytes data with gamma != 1/2.2
        // gamma = 1.0 (stored as 1/gamma = 1.0 = 0x0000803F in IEEE 754)
        byte[] gamaData = new byte[] {
            0x00, 0x00, (byte) 0x80, 0x3F  // 1.0f in IEEE 754
        };
        
        // IDAT chunk - minimal valid zlib data for 1x1 RGB pixel
        byte[] idatData = new byte[] {
            0x78, 0x01,  // zlib header
            0x63, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0xFF, 0xFF, 0xFF,  // compressed data
            0x03, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01  // adler32 checksum
        };
        
        // IEND chunk
        byte[] iendData = new byte[0];
        
        // Calculate CRC for IHDR (using a simple placeholder)
        byte[] ihdrCrc = new byte[] {0x00, 0x00, 0x00, 0x00};
        byte[] gamaCrc = new byte[] {0x00, 0x00, 0x00, 0x00};
        byte[] idatCrc = new byte[] {0x00, 0x00, 0x00, 0x00};
        byte[] iendCrc = new byte[] {0x00, 0x00, 0x00, 0x00};
        
        // Build complete PNG
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        
        // PNG signature
        baos.write(pngSignature);
        
        // IHDR chunk
        baos.write(intToBytes(13));  // length
        baos.write("IHDR".getBytes());
        baos.write(ihdrData);
        baos.write(ihdrCrc);
        
        // gAMA chunk
        baos.write(intToBytes(4));  // length
        baos.write("gAMA".getBytes());
        baos.write(gamaData);
        baos.write(gamaCrc);
        
        // IDAT chunk
        baos.write(intToBytes(idatData.length));  // length
        baos.write("IDAT".getBytes());
        baos.write(idatData);
        baos.write(idatCrc);
        
        // IEND chunk
        baos.write(intToBytes(0));  // length
        baos.write("IEND".getBytes());
        baos.write(iendCrc);
        
        return baos.toByteArray();
    }
    
    private byte[] intToBytes(int value) {
        return new byte[] {
            (byte) (value >> 24),
            (byte) (value >> 16),
            (byte) (value >> 8),
            (byte) value
        };
    }
    
    // Helper class since we can't use java.io.ByteArrayOutputStream directly
    private static class ByteArrayOutputStream {
        private byte[] buffer = new byte[1024];
        private int count = 0;
        
        public void write(int b) {
            if (count == buffer.length) {
                byte[] newBuffer = new byte[buffer.length * 2];
                System.arraycopy(buffer, 0, newBuffer, 0, count);
                buffer = newBuffer;
            }
            buffer[count++] = (byte) b;
        }
        
        public void write(byte[] b) {
            write(b, 0, b.length);
        }
        
        public void write(byte[] b, int off, int len) {
            if (len == 0) return;
            
            if (count + len > buffer.length) {
                byte[] newBuffer = new byte[Math.max(buffer.length * 2, count + len)];
                System.arraycopy(buffer, 0, newBuffer, 0, count);
                buffer = newBuffer;
            }
            
            System.arraycopy(b, off, buffer, count, len);
            count += len;
        }
        
        public byte[] toByteArray() {
            byte[] result = new byte[count];
            System.arraycopy(buffer, 0, result, 0, count);
            return result;
        }
    }
}

