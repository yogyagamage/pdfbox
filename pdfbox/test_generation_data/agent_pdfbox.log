        Mockito.when(destNums.size()).thenReturn(0);
        
        COSBase nonNumberBase = Mockito.mock(COSBase.class);
        Mockito.when(srcNums.getObject(0)).thenReturn(nonNumberBase);
        
        mergerUtility.appendDocument(destinationDoc, sourceDoc);
    }
}

