                dictionary.setItem(child.getAttribute("KEY"), parseStreamElement(child));
                LOG.debug((parentAttrKey + " => Set ") + child.getAttribute("KEY"));
            } else {
                LOG.warn((parentAttrKey + " => Not handling element: ") + childTagName);
            }
        }
    }
    return dictionary;
}

