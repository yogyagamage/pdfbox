package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.cos.COSArray;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.pdmodel.ResourceCache;
import org.junit.jupiter.api.Test;
import java.io.IOException;

class PDFontFactory_PDType0FontfetchCMapUCS2_LogwarnFikaTest {

    @Test
    void testCreateFontTriggersLogWarn() throws IOException {
        // Create a font dictionary with TYPE0 subtype to trigger PDType0Font path
        COSDictionary fontDict = new COSDictionary();
        fontDict.setItem(COSName.TYPE, COSName.FONT);
        fontDict.setItem(COSName.SUBTYPE, COSName.TYPE0);
        
        // Create descendant font array with a CIDFontType2 to make isDescendantCJK true
        COSDictionary descendantFont = new COSDictionary();
        descendantFont.setItem(COSName.TYPE, COSName.FONT);
        descendantFont.setItem(COSName.SUBTYPE, COSName.CID_FONT_TYPE2);
        
        // Add CIDSystemInfo to descendant font to trigger CJK path
        COSDictionary cidSystemInfo = new COSDictionary();
        cidSystemInfo.setString(COSName.REGISTRY, "Adobe");
        cidSystemInfo.setString(COSName.ORDERING, "Japan1");
        cidSystemInfo.setInt(COSName.SUPPLEMENT, 6);
        descendantFont.setItem(COSName.CIDSYSTEMINFO, cidSystemInfo);
        
        COSArray descendantFonts = new COSArray();
        descendantFonts.add(descendantFont);
        fontDict.setItem(COSName.DESCENDANT_FONTS, descendantFonts);
        
        // Set encoding to trigger predefined CMap path
        fontDict.setItem(COSName.ENCODING, COSName.create("90ms-RKSJ"));
        
        // Create font descriptor to avoid NPE
        COSDictionary fontDescriptor = new COSDictionary();
        fontDescriptor.setItem(COSName.FONT_NAME, COSName.create("TestFont"));
        fontDict.setItem(COSName.FONT_DESC, fontDescriptor);
        
        // Execute the entry point - this should trigger the Log.warn call
        PDFontFactory.createFont(fontDict, null);
    }
}

