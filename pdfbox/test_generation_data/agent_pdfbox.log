package org.apache.pdfbox.pdmodel.interactive.digitalsignature.visible;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.form.PDAcroForm;
import org.apache.pdfbox.pdmodel.interactive.form.PDSignatureField;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.awt.geom.AffineTransform;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.InputStream;

import static org.mockito.Mockito.when;

public class PDFTemplateCreatormethod_LogFactorygetLogFikaTest {

    @Test
    public void testBuildPDFTriggersLogFactoryGetLog() throws IOException {
        PDFTemplateBuilder pdfBuilder = Mockito.mock(PDFTemplateBuilder.class);
        PDFTemplateStructure pdfStructure = Mockito.mock(PDFTemplateStructure.class);
        PDDocument mockTemplate = Mockito.mock(PDDocument.class);
        PDAcroForm mockAcroForm = Mockito.mock(PDAcroForm.class);
        PDSignatureField mockSignatureField = Mockito.mock(PDSignatureField.class);
        PDVisibleSignDesigner designer = Mockito.mock(PDVisibleSignDesigner.class);

        when(pdfBuilder.getStructure()).thenReturn(pdfStructure);
        when(pdfStructure.getTemplate()).thenReturn(mockTemplate);
        when(pdfStructure.getAcroForm()).thenReturn(mockAcroForm);
        when(pdfStructure.getSignatureField()).thenReturn(mockSignatureField);
        when(pdfStructure.getPage()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.PDPage.class));
        when(pdfStructure.getAffineTransform()).thenReturn(new AffineTransform());
        when(pdfStructure.getFormatterRectangle()).thenReturn(new org.apache.pdfbox.pdmodel.common.PDRectangle());
        when(pdfStructure.getHolderFormStream()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.common.PDStream.class));
        when(pdfStructure.getHolderFormResources()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.PDResources.class));
        when(pdfStructure.getHolderForm()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.graphics.form.PDFormXObject.class));
        when(pdfStructure.getInnerFormResources()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.PDResources.class));
        when(pdfStructure.getInnerFormStream()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.common.PDStream.class));
        when(pdfStructure.getInnerForm()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.graphics.form.PDFormXObject.class));
        when(pdfStructure.getProcSet()).thenReturn(new org.apache.pdfbox.cos.COSArray());
        when(pdfStructure.getImageFormStream()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.common.PDStream.class));
        when(pdfStructure.getImageFormResources()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.PDResources.class));
        when(pdfStructure.getImage()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject.class));
        when(pdfStructure.getImageFormName()).thenReturn(org.apache.pdfbox.cos.COSName.getPDFName("n2"));
        when(pdfStructure.getImageName()).thenReturn(org.apache.pdfbox.cos.COSName.getPDFName("n0"));
        when(pdfStructure.getInnerFormName()).thenReturn(org.apache.pdfbox.cos.COSName.getPDFName("FRM"));
        when(pdfStructure.getVisualSignature()).thenReturn(new byte[]{37, 80, 68, 70});

        when(designer.getTransform()).thenReturn(new AffineTransform());
        when(designer.getImage()).thenReturn(new byte[]{});
        when(designer.getFormatterRectangleParameters()).thenReturn(new float[]{0, 0, 100, 100});

        PDFTemplateCreator creator = new PDFTemplateCreator(pdfBuilder);
        creator.buildPDF(designer);
    }
}

