class PDChoice_BaseParsermethod_LogwarnFikaTest2 {

    @Test
    void testSetValueTriggersLogWarn() throws IOException {
        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // Create a real COSDictionary for the field
        COSDictionary fieldDict = new COSDictionary();
        fieldDict.setItem(COSName.FT, COSName.Ch);
        fieldDict.setBoolean(COSName.FF, PDChoice.FLAG_MULTI_SELECT, true);
        
        // Create DA string that will trigger charset fallback in BaseParser static initializer
        COSString daString = new COSString("0 g /Helv 12 Tf");
        fieldDict.setItem(COSName.DA, daString);
        
        // Create DR dictionary
        COSDictionary drDict = new COSDictionary();
        fieldDict.setItem(COSName.DR, drDict);
        
        // Create AcroForm dictionary
        COSDictionary acroFormDict = new COSDictionary();
        acroFormDict.setItem(COSName.DR, drDict);
        document.getDocumentCatalog().getCOSObject().setItem(COSName.ACRO_FORM, acroFormDict);
        
        // Create options array
        COSArray optionsArray = new COSArray();
        optionsArray.add(COSString.parseLiteral("Option1"));
        optionsArray.add(COSString.parseLiteral("Option2"));
        fieldDict.setItem(COSName.OPT, optionsArray);
        
        // Create PDComboBox (subclass of PDChoice)
        PDComboBox comboBox = new PDComboBox(document.getDocumentCatalog().getAcroForm(), fieldDict);
        
        // Set values that will trigger appearance construction
        List<String> values = Arrays.asList("Option1");
        comboBox.setValue(values);
        
        // Close document
        document.close();
    }
}

