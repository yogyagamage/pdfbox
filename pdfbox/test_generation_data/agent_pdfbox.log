    private byte[] createMinimalCMSEnvelopedData() {
        // Create a minimal valid CMS EnvelopedData structure
        // This is a simplified version that should parse without errors
        // but won't actually match any certificate
        
        // CMS EnvelopedData structure:
        // SEQUENCE {
        //   INTEGER 0 (version)
        //   SET OF RecipientInfo
        //   EncryptedContentInfo
        // }
        
        // For simplicity, we'll create a structure that BouncyCastle can parse
        // but with empty recipient info
        byte[] cmsData = new byte[] {
            0x30, 0x2A, // SEQUENCE (42 bytes)
            0x02, 0x01, 0x00, // INTEGER version = 0
            0x31, 0x0B, // SET (11 bytes) of RecipientInfo
            0x30, 0x09, // SEQUENCE (9 bytes) - KeyTransRecipientInfo
            0x06, 0x09, 0x2A, (byte)0x86, 0x48, (byte)0x86, (byte)0xF7, 0x0D, 0x01, 0x01, 0x01, // OID rsaEncryption
            0x30, 0x18, // SEQUENCE (24 bytes) - EncryptedContentInfo
            0x06, 0x09, 0x2A, (byte)0x86, 0x48, (byte)0x86, (byte)0xF7, 0x0D, 0x01, 0x01, 0x07, // OID data
            0x04, 0x0B // OCTET STRING (11 bytes) - encrypted content
        };
        
        // Add some dummy encrypted content
        byte[] encryptedContent = new byte[]{0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B};
        System.arraycopy(encryptedContent, 0, cmsData, cmsData.length - 11, 11);
        
        return cmsData;
    }
}

