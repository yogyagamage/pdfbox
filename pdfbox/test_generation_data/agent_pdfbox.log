import org.apache.pdfbox.pdmodel.interactive.digitalsignature.SignatureOptions;
import org.apache.pdfbox.pdmodel.PDPage;
import org.junit.jupiter.api.Test;

import java.io.IOException;

public class PDDocument_PDSignatureFieldconstructAppearances_LogwarnFikaTest {

    @Test
    public void testAddSignatureTriggersLogWarn() throws IOException {
        // Create a PDDocument using the simplest constructor
        PDDocument document = new PDDocument();
        
        // Add at least one page to avoid "Cannot sign an empty document" exception
        PDPage page = new PDPage();
        document.addPage(page);
        
        // Create required signature objects
        PDSignature signature = new PDSignature();
        SignatureOptions options = new SignatureOptions();
        
        // Set page to 0 to ensure a valid page index
        options.setPage(0);
        
        // Call the entry point method - this should traverse the entire chain
        // and eventually trigger the third-party Log.warn() method
        document.addSignature(signature, options);
        
        // Clean up
        document.close();
    }
}

