            os.write("<< /Type /Catalog /Pages 2 0 R >>\n".getBytes());
            os.write("endobj\n".getBytes());
            
            os.write("2 0 obj\n".getBytes());
            os.write("<< /Type /Pages /Kids [] /Count 0 >>\n".getBytes());
            os.write("endobj\n".getBytes());
            
            // Write xref table
            long xrefOffset = pdfFile.length();
            os.write("xref\n".getBytes());
            os.write("0 3\n".getBytes());
            os.write("0000000000 65535 f \n".getBytes());
            os.write("0000000010 00000 n \n".getBytes());
            os.write("0000000050 00000 n \n".getBytes());
            
            // Write trailer with invalid /XRefStm offset (0)
            long trailerOffset = pdfFile.length();
            os.write("trailer\n".getBytes());
            os.write("<< /Size 3 /Root 1 0 R /Prev 0\n".getBytes());
            os.write("   /XRefStm 0 >>\n".getBytes());  // Invalid offset will trigger error
            os.write("startxref\n".getBytes());
            os.write(String.valueOf(xrefOffset).getBytes());
            os.write("\n%%EOF\n".getBytes());
        }
        
        // Create parser with lenient mode enabled
        RandomAccessFile raf = new RandomAccessFile(pdfFile, "r");
