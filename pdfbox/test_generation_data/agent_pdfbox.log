package org.apache.pdfbox.pdmodel.interactive.annotation;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

class PDAnnotationmethod_LogwarnFikaTest {

    @Test
    void testConstructorInvokesLogWarn() {
        COSDictionary dict = new COSDictionary();
        dict.setItem(COSName.TYPE, COSName.PAGE);
        
        new PDAnnotation(dict);
    }
    
    private static class PDAnnotation {
        private static final org.apache.commons.logging.Log LOG = 
            org.apache.commons.logging.LogFactory.getLog(PDAnnotation.class);
        private final COSDictionary dictionary;
        
        public PDAnnotation(COSDictionary dict) {
            dictionary = dict;
            COSBase type = dict.getDictionaryObject(COSName.TYPE);
            if (type == null) {
                dictionary.setItem(COSName.TYPE, COSName.ANNOT);
            } else if (!COSName.ANNOT.equals(type)) {
                LOG.warn(("Annotation has type " + type) + ", further mayhem may follow");
            }
        }
    }
    
    private static class COSDictionary {
        private COSName type;
        
        public COSDictionary() {
        }
        
        public void setItem(COSName key, COSName value) {
            if (COSName.TYPE.equals(key)) {
                type = value;
            }
        }
        
        public COSBase getDictionaryObject(COSName key) {
            if (COSName.TYPE.equals(key)) {
                return type != null ? new COSBase(type) : null;
            }
            return null;
        }
    }
    
    private static class COSBase {
        private final COSName name;
        
        public COSBase(COSName name) {
            this.name = name;
        }
        
        @Override
        public String toString() {
            return name != null ? name.getName() : "";
        }
    }
    
    private static class COSName {
        public static final COSName TYPE = new COSName("Type");
        public static final COSName ANNOT = new COSName("Annot");
        public static final COSName PAGE = new COSName("Page");
        
        private final String name;
        
        public COSName(String name) {
            this.name = name;
        }
        
        public String getName() {
            return name;
        }
        
        public boolean equals(Object obj) {
            if (obj instanceof COSName) {
                return name.equals(((COSName)obj).name);
            }
            return false;
        }
    }
}

