package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.pdmodel.ResourceCache;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;

class PDFontFactory_PDSimpleFontreadEncoding_LogwarnFikaTest {

    @Test
    void testCreateFontTriggersLogWarn() throws IOException {
        // Create a COSDictionary with MM_TYPE1 subtype to trigger PDMMType1Font path
        COSDictionary fontDict = new COSDictionary();
        fontDict.setItem(COSName.TYPE, COSName.FONT);
        fontDict.setItem(COSName.SUBTYPE, COSName.MM_TYPE1);
        
        // Add an encoding that will cause readEncoding() to trigger the warning
        COSDictionary encodingDict = new COSDictionary();
        // Use an unknown encoding name to trigger the warning path
        encodingDict.setItem(COSName.BASE_ENCODING, COSName.getPDFName("UnknownEncoding"));
        fontDict.setItem(COSName.ENCODING, encodingDict);
        
        // Add font descriptor without FONT_FILE3 to avoid PDType1CFont path
        COSDictionary fontDescriptor = new COSDictionary();
        fontDict.setItem(COSName.FONT_DESC, fontDescriptor);
        
        // Mock ResourceCache (not needed for MM_TYPE1 but required by method signature)
        ResourceCache resourceCache = Mockito.mock(ResourceCache.class);
        
        // Call the entry point - this should trigger the chain ending in Log.warn()
        PDFontFactory.createFont(fontDict, resourceCache);
    }
}

