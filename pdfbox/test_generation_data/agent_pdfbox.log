package org.apache.pdfbox.pdmodel.interactive.digitalsignature.visible;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;

class PDVisibleSigBuildercreateVisualSignature_LoginfoFikaTest {

    @Test
    void testCreateVisualSignature() throws IOException {
        // Create a real PDDocument
        byte[] pdfData = "%PDF-1.4\n1 0 obj\n<<>>\nendobj\ntrailer\n<<>>\n%%EOF".getBytes();
        PDDocument document = PDDocument.load(new ByteArrayInputStream(pdfData));
        
        // Create the builder with mocked dependencies
        PDFTemplateBuilder templateBuilder = Mockito.mock(PDFTemplateBuilder.class);
        PDVisibleSignDesigner designer = Mockito.mock(PDVisibleSignDesigner.class);
        SignatureOptions options = Mockito.mock(SignatureOptions.class);
        
        PDVisibleSigBuilder builder = new PDVisibleSigBuilder(templateBuilder, designer, options);
        
        // Execute the entry point method
        builder.createVisualSignature(document);
        
        // Clean up
        document.close();
    }
}

