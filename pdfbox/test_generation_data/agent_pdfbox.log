    @Test
    void testParseNextTokenTriggersLogWarn() throws IOException {
        // Setup source to trigger the path to hasNoFollowingBinData()
        when(source.isClosed()).thenReturn(false);
        when(source.isEOF()).thenReturn(false);
        
        // First peek returns 'I' to enter the ID operator case
        when(source.peek()).thenReturn((int) 'I');
        
        // First read returns 'I'
        when(source.read()).thenReturn((int) 'I');
        
        // Second read returns 'D' to complete "ID"
        when(source.read()).thenReturn((int) 'D');
        
        // Position for error message
        when(source.getPosition()).thenReturn(100L);
        
        // skipLinebreak returns false, isWhitespace returns true
        when(source.read()).thenReturn((int) ' ');
        
        // Setup the loop in the ID case
        // First iteration: lastByte='E', currentByte='I'
        when(source.read()).thenReturn(
            (int) 'E',  // lastByte
            (int) 'I',  // currentByte
            (int) ' ',  // next byte for hasNextSpaceOrReturn
            -1          // EOF
        );
        
        // hasNextSpaceOrReturn returns true
        // hasNoFollowingBinData needs to return false to trigger the warn log
        // To make hasNoFollowingBinData return false, we need to mock its internal source.read() calls
        
        // Create the parser with mocked source
        PDFStreamParser parser = new PDFStreamParser(source);
        
        // Invoke the entry point
        parser.parseNextToken();
    }
}

