    Map<Integer, COSObjectable> indices = null;
    COSArray numbersArray = node.getCOSArray(COSName.NUMS);
    if (numbersArray != null) {
        int size = numbersArray.size();
        indices = new HashMap<>();
        if ((size % 2) != 0) {
            LOG.warn("Numbers array has odd size: " + size);
