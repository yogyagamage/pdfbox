package org.apache.pdfbox.rendering;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationLine;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationLink;
import org.apache.pdfbox.rendering.RenderDestination;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

public class PDFRenderer_PDLineAppearanceHandlergenerateNormalAppearance_LogerrorFikaTest {

    @Test
    public void testRenderPageToGraphicsTriggersLogError() throws IOException {
        // Create a minimal PDF document with one page
        PDDocument document = new PDDocument();
        PDPage page = new PDPage(PDRectangle.A4);
        document.addPage(page);
        
        // Create a line annotation with problematic content that will trigger the error log
        PDAnnotationLine lineAnnotation = new PDAnnotationLine();
        lineAnnotation.setRectangle(new PDRectangle(50, 50, 200, 100));
        lineAnnotation.setLine(new float[]{50, 50, 250, 150});
        lineAnnotation.setColor(new org.apache.pdfbox.pdmodel.graphics.color.PDColor(
            new float[]{0, 0, 0}, 
            org.apache.pdfbox.pdmodel.graphics.color.PDDeviceRGB.INSTANCE
        ));
        lineAnnotation.setContents("Invalid\u0000Text"); // Text with null character that causes IllegalArgumentException
        lineAnnotation.setCaption(true);
        
        // Wrap in PDAnnotationLink to match the call chain
        PDAnnotationLink linkAnnotation = new PDAnnotationLink();
        linkAnnotation.setRectangle(lineAnnotation.getRectangle());
        linkAnnotation.setColor(lineAnnotation.getColor());
        linkAnnotation.setContents(lineAnnotation.getContents());
        linkAnnotation.setLine(lineAnnotation.getLine());
        linkAnnotation.setCaption(lineAnnotation.hasCaption());
        
        // Add annotation to page
        page.getAnnotations().add(linkAnnotation);
        
        // Create PDFRenderer instance
        PDFRenderer renderer = new PDFRenderer(document);
        
        // Create a Graphics2D context to render to
        BufferedImage image = new BufferedImage(300, 300, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = image.createGraphics();
        
        try {
            // Invoke the entry point method
            renderer.renderPageToGraphics(0, graphics, 1.0f, 1.0f, RenderDestination.VIEW);
        } finally {
            graphics.dispose();
            document.close();
        }
    }
}

