package org.apache.pdfbox.pdmodel.graphics.color;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.cos.COSStream;
import org.apache.pdfbox.pdmodel.common.PDStream;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDICCBasedgetNumberOfComponents_LogwarnFikaTest {

    @Test
    public void testGetNumberOfComponentsTriggersLogWarn() throws IOException {
        // Create a real COSStream with a /N entry
        COSDictionary dict = new COSDictionary();
        dict.setInt(COSName.N, 5); // Wrong value that will trigger the warning
        COSStream cosStream = new COSStream(dict);
        
        // Create PDStream wrapper
        PDStream stream = new PDStream(cosStream);
        
        // Create ICC profile with different number of components
        byte[] iccData = new byte[128];
        // Set header to indicate 3 components (typical for RGB)
        iccData[8] = 'R'; iccData[9] = 'G'; iccData[10] = 'B'; // Profile description
        iccData[15] = 3; // Number of components
        
        // Create real PDICCBased instance
        PDICCBased iccBased = new PDICCBased(stream);
        
        // Set the ICC profile using reflection since it's package-private
        try {
            java.lang.reflect.Field iccProfileField = PDICCBased.class.getDeclaredField("iccProfile");
            iccProfileField.setAccessible(true);
            PDColorSpace iccProfile = new PDICCBased.ICCProfileWrapper(new ByteArrayInputStream(iccData));
            iccProfileField.set(iccBased, iccProfile);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Reset numberOfComponents to force the warning path
        try {
            java.lang.reflect.Field numComponentsField = PDICCBased.class.getDeclaredField("numberOfComponents");
            numComponentsField.setAccessible(true);
            numComponentsField.set(iccBased, -1);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Invoke entry point - this should trigger LOG.warn()
        iccBased.getNumberOfComponents();
    }
}

