        appearanceStream.setResources(widgetResources);
        widget.setNormalAppearance(appearanceStream);
        
        // Set up AcroForm with default resources but without the font
        PDResources acroFormResources = new PDResources();
        acroForm.setDefaultResources(acroFormResources);
        
