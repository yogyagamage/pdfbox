package org.apache.pdfbox.pdfparser;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.cos.COSStream;
import org.apache.pdfbox.io.RandomAccessReadBuffer;
import org.apache.pdfbox.io.ScratchFile;
import java.io.ByteArrayInputStream;
import java.io.IOException;

class PDFObjectStreamParser_BaseParsermethod_LogwarnFikaTest3 {

    @Test
    void testWarnLogInvocation() throws IOException {
        // Create a minimal PDF stream that will trigger the warning in static initializer
        byte[] pdfData = "%PDF-1.4\n".getBytes();
        RandomAccessReadBuffer randomAccessReadBuffer = new RandomAccessReadBuffer(pdfData);
        
        // Create necessary objects to instantiate BaseParser
        ScratchFile scratchFile = new ScratchFile();
        COSDictionary dict = new COSDictionary();
        dict.setItem(COSName.TYPE, COSName.OBJ_STM);
        dict.setInt(COSName.N, 0);
        dict.setInt(COSName.FIRST, 0);
        
        COSStream stream = new COSStream(dict, scratchFile);
        stream.createUnfilteredStream().write(pdfData);
        stream.close();
        
        // This will trigger the static initializer which contains the warn log call
        // when the charset "Windows-1252" is not available
        PDFObjectStreamParser parser = new PDFObjectStreamParser(
            stream, 
            randomAccessReadBuffer, 
            scratchFile
        );
        
        // Clean up
        parser.close();
        scratchFile.close();
    }
}

