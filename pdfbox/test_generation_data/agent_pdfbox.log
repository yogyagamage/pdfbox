        // Create PNG data that will be detected as PNG and will follow the indexed color path
        // PNG signature + IHDR chunk + PLTE chunk + IDAT chunk + IEND chunk
        byte[] pngData = new byte[] {
            // PNG signature (8 bytes)
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
            // IHDR chunk (length: 13, type: IHDR, data, CRC)
            0x00, 0x00, 0x00, 0x0D, // length: 13
            0x49, 0x48, 0x44, 0x52, // type: IHDR
            0x00, 0x00, 0x00, 0x01, // width: 1
            0x00, 0x00, 0x00, 0x01, // height: 1
            0x10, // bit depth: 16 (bitsPerComponent > 8 to trigger the debug log)
            0x03, // color type: 3 (indexed)
            0x00, // compression method: 0
            0x00, // filter method: 0
            0x00, // interlace method: 0
            (byte) 0x9A, (byte) 0x78, (byte) 0xDA, (byte) 0x33, // CRC (dummy)
            // PLTE chunk (length: 6, type: PLTE, data: 2 RGB entries, CRC)
            0x00, 0x00, 0x00, 0x06, // length: 6
            0x50, 0x4C, 0x54, 0x45, // type: PLTE
            0x00, 0x00, 0x00, // color 0: black
            0xFF, 0xFF, 0xFF, // color 1: white
            (byte) 0x82, (byte) 0x6B, (byte) 0x5B, (byte) 0x5C, // CRC (dummy)
