        Mockito.when(mockImageXObject.getSoftMask()).thenReturn(mockSoftMask);
        
        // Configure the resources to return our mock PDImageXObject
        Mockito.when(mockResources.getXObject(Mockito.any(COSName.class))).thenReturn(mockImageXObject);
        
        // Configure context to process color operators
