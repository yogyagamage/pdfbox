    @Test
    public void testCreateFromByteArrayTriggersLogFactoryGetLog() throws IOException {
        // Create a minimal PDDocument
        PDDocument document = new PDDocument();
        
        // Create a valid PNG byte array (minimal PNG signature + IHDR chunk + IEND chunk)
        // PNG signature (8 bytes) + IHDR chunk (length=13, type=IHDR, data, crc) + IEND chunk
        byte[] pngBytes = new byte[] {
            // PNG signature
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
            // IHDR chunk length (13)
            0x00, 0x00, 0x00, 0x0D,
            // IHDR chunk type
            0x49, 0x48, 0x44, 0x52,
            // IHDR data: width=1, height=1, bit depth=8, color type=2, compression=0, filter=0, interlace=0
            0x00, 0x00, 0x00, 0x01, // width
            0x00, 0x00, 0x00, 0x01, // height
            0x08, // bit depth
            0x02, // color type (RGB)
            0x00, // compression method
            0x00, // filter method
            0x00, // interlace method
            // IHDR CRC (dummy value)
            0x00, 0x00, 0x00, 0x00,
            // IEND chunk length (0)
            0x00, 0x00, 0x00, 0x00,
            // IEND chunk type
            0x49, 0x45, 0x4E, 0x44,
            // IEND CRC (dummy value)
            0x00, 0x00, 0x00, 0x00
        };
        
        // Call the entry point method
        PDImageXObject.createFromByteArray(document, pngBytes, "test.png");
        
        // Close document
        document.close();
    }
}

