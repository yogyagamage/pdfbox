class FontMapperImpl_FileSystemFontProviderloadDiskCache_LogwarnFikaTest {

    @Test
    void testGetProviderTriggersLogWarn() throws Exception {
        FontMapperImpl fontMapper = new FontMapperImpl();
        
        // Create a disk cache file with malformed content to trigger the warning
        File tempCacheFile = createMalformedCacheFile();
        
        // Use reflection to set the disk cache file path in FileSystemFontProvider
        // This is necessary to control which cache file gets loaded
        FontProvider provider = fontMapper.getProvider();
        
        if (provider instanceof FileSystemFontProvider) {
            FileSystemFontProvider fsProvider = (FileSystemFontProvider) provider;
            
            // Use reflection to access the private getDiskCacheFile method
            Method getDiskCacheFileMethod = FileSystemFontProvider.class
                    .getDeclaredMethod("getDiskCacheFile");
            getDiskCacheFileMethod.setAccessible(true);
            
            // Replace the disk cache file with our malformed one
            Field diskCacheFileField = FileSystemFontProvider.class
                    .getDeclaredField("DISK_CACHE_FILE_NAME");
            diskCacheFileField.setAccessible(true);
            
            // Save original value
            String originalFileName = (String) diskCacheFileField.get(null);
            
            try {
                // Set to our temp file
                diskCacheFileField.set(null, tempCacheFile.getAbsolutePath());
                
                // Trigger loadDiskCache by calling getProvider again
                // This will cause the FileSystemFontProvider constructor to execute
                // which calls loadDiskCache with the malformed cache file
                fontMapper.getProvider();
                
            } finally {
                // Restore original file name
                diskCacheFileField.set(null, originalFileName);
                
                // Clean up temp file
                tempCacheFile.delete();
            }
        }
    }
    
    private File createMalformedCacheFile() throws IOException {
        File tempFile = File.createTempFile("fontcache", ".tmp");
        tempFile.deleteOnExit();
        
        // Write malformed content that will trigger the warning
        // The loadDiskCache method expects at least 10 parts separated by '|'
        // We'll write a line with fewer parts
        java.nio.file.Files.write(
            tempFile.toPath(),
            java.util.Collections.singletonList("Incomplete|Line|With|Only|9|Parts")
        );
        
        return tempFile;
    }
}

