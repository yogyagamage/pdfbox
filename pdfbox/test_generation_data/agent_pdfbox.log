        // Create the DrawObject instance using the provided constructor
        DrawObject drawObject = new DrawObject(mockContext);
        
        // Create a mock PDResources that will return a PDImageXObject
        PDResources mockResources = Mockito.mock(PDResources.class);
        Mockito.when(mockContext.getResources()).thenReturn(mockResources);
        
        // Create a real PDImageXObject (subclass) that will trigger the path
        PDImageXObject mockImageXObject = Mockito.mock(
            PDImageXObject.class,
            Mockito.withSettings()
                .useConstructor()  // Use default constructor
                .defaultAnswer(Mockito.CALLS_REAL_METHODS)
        );
        
        // Configure the mock to return false for isStencil() to avoid early return
        Mockito.when(mockImageXObject.isStencil()).thenReturn(false);
        
        // Configure the mock to return true for getInterpolate() to take the desired path
        Mockito.when(mockImageXObject.getInterpolate()).thenReturn(true);
        
        // Create a mock BufferedImage for getImage() calls
        BufferedImage mockBufferedImage = new BufferedImage(10, 10, BufferedImage.TYPE_INT_ARGB);
        
        // Configure getImage() to return the mock image and trigger the call chain
        Mockito.when(mockImageXObject.getImage()).thenReturn(mockBufferedImage);
        Mockito.when(mockImageXObject.getImage(Mockito.any(), Mockito.anyInt())).thenReturn(mockBufferedImage);
        
        // Configure getSoftMask() to return a PDImageXObject that will trigger applyMask
        PDImageXObject mockSoftMask = Mockito.mock(PDImageXObject.class);
