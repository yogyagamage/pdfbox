        Path dummyFont = tempDir.resolve("dummy.ttf");
        Files.createFile(dummyFont);
        
        // Set system property to point to temp directory for font scanning
        String originalFontDir = System.getProperty("sun.java2d.fontpath");
        System.setProperty("sun.java2d.fontpath", tempDir.toString());
        
