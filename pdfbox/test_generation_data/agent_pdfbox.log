            wasAdded = true;
        } else if (i == (strLen - 1)) {
            insertDiacritic(i, diacritic);
            wasAdded = true;
        }
        // couldn't find anything useful so we go to the next character in the TextPosition
        currCharXStart += widths[i];
    }
