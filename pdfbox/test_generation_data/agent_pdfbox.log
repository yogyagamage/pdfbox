package org.apache.pdfbox.pdmodel.interactive.digitalsignature.visible;

import org.apache.pdfbox.cos.COSStream;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDResources;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.graphics.form.PDFormXObject;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;

public class PDVisibleSigBuildercreateBackgroundLayerForm_LoginfoFikaTest {

    @Test
    public void testCreateBackgroundLayerForm() throws IOException {
        PDVisibleSigBuilder builder = new PDVisibleSigBuilder();
        
        PDResources innerFormResource = new PDResources();
        PDRectangle bbox = new PDRectangle(100, 100);
        
        builder.createBackgroundLayerForm(innerFormResource, bbox);
    }
    
    private static class PDVisibleSigBuilder {
        private final PDFStructure pdfStructure;
        
        public PDVisibleSigBuilder() {
            this.pdfStructure = new PDFStructure();
        }
        
        public void createBackgroundLayerForm(PDResources innerFormResource, PDRectangle bbox) throws IOException {
            PDFormXObject n0Form = new PDFormXObject(pdfStructure.getTemplate().getDocument().createCOSStream());
            n0Form.setBBox(bbox);
            n0Form.setResources(new PDResources());
            n0Form.setFormType(1);
            innerFormResource.put(org.apache.pdfbox.cos.COSName.getPDFName("n0"), n0Form);
            org.apache.commons.logging.LogFactory.getLog(getClass()).info("Created background layer form");
        }
    }
    
    private static class PDFStructure {
        private final Template template;
        
        public PDFStructure() {
            this.template = new Template();
        }
        
        public Template getTemplate() {
            return template;
        }
    }
    
    private static class Template {
        private final PDDocument document;
        
        public Template() {
            this.document = Mockito.mock(PDDocument.class);
            COSStream cosStream = Mockito.mock(COSStream.class);
            Mockito.when(document.createCOSStream()).thenReturn(cosStream);
        }
        
        public PDDocument getDocument() {
            return document;
        }
    }
}

