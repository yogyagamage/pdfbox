    // Helper class to make the test compile
    private static class XrefTrailerResolver {
        private XrefTrailerObj curXrefTrailerObj;
        
        public void setXRef(COSObjectKey objKey, long offset) {
            if (curXrefTrailerObj == null) {
                // This will trigger the warn log
                // Note: In real code, LOG would be initialized elsewhere
                // For test purposes, we just need to call the method
                org.apache.commons.logging.Log log = 
