            Mockito.when(mockBruteForceParser.bfSearchTriggered()).thenReturn(true);
            
            // Create a custom BruteForceParser that overrides bfSearchForObjStreams
            // to trigger parseCOSDictionary with empty COSName
            BruteForceParser customParser = new BruteForceParser(inputStream) {
                @Override
