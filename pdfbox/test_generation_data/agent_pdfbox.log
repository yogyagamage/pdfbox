/**
 * Parses a PDF.
 *
 * @param randomAccessRead
 * 		random access read representing the pdf to be loaded. To pass an
 * 		InputStream, wrap it into a {@link RandomAccessReadBuffer}.
 * @param password
 * 		password to be used for decryption
 * @param keyStore
 * 		key store to be used for decryption when using public key security
 * @param alias
 * 		alias to be used for decryption when using public key security
 * @param streamCacheCreateFunction
 * 		a function to create an instance of a stream cache to be used for buffering
 * 		new/altered PDF streams
 * @return loaded document
 * @throws IOException
 * 		in case of a file reading or parsing error
 */
public static PDDocument loadPDF(RandomAccessRead randomAccessRead, String password, InputStream keyStore, String alias, StreamCacheCreateFunction streamCacheCreateFunction) throws IOException {
    PDFParser parser = new PDFParser(randomAccessRead, password, keyStore, alias, streamCacheCreateFunction);
    return parser.parse();
}

