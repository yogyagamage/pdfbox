    @Test
    public void testChainToLogFactoryGetLog() throws IOException {
        // Create instance using provided constructor
        PDFMergerUtility mergerUtility = new PDFMergerUtility();
        
        // Set required fields using setters to ensure execution path
        mergerUtility.setDocumentMergeMode(PDFMergerUtility.DocumentMergeMode.PDFBOX_LEGACY_MODE);
        
        // Create a source document to merge
        // Create a minimal PDF in memory to avoid file dependencies
        byte[] minimalPdf = createMinimalPdf();
        RandomAccessRead source = new org.apache.pdfbox.io.RandomAccessReadBuffer(
            new ByteArrayInputStream(minimalPdf)
        );
        mergerUtility.addSource(source);
        
        // Set destination file name to avoid NPE during save
        mergerUtility.setDestinationFileName("test_output.pdf");
        
        // Call entry point method with null stream cache (uses memory cache)
        mergerUtility.mergeDocuments((RandomAccessStreamCache.StreamCacheCreateFunction) null);
    }
    
    private byte[] createMinimalPdf() {
        // Create a minimal valid PDF document
        String pdfContent = "%PDF-1.4\n" +
            "1 0 obj\n" +
            "<< /Type /Catalog /Pages 2 0 R >>\n" +
            "endobj\n" +
            "2 0 obj\n" +
            "<< /Type /Pages /Kids [] /Count 0 >>\n" +
            "endobj\n" +
            "xref\n" +
            "0 3\n" +
            "0000000000 65535 f \n" +
            "0000000010 00000 n \n" +
            "0000000053 00000 n \n" +
            "trailer\n" +
            "<< /Size 3 /Root 1 0 R >>\n" +
            "startxref\n" +
            "110\n" +
            "%%EOF";
        return pdfContent.getBytes();
    }
}

