        PDDocument document = new PDDocument();
        
        // Create a real PDAcroForm with real resources
        PDAcroForm acroForm = new PDAcroForm(document);
        PDResources resources = new PDResources();
        acroForm.setDefaultResources(resources);
        
        // Create a real COSDictionary for the button
        COSDictionary buttonDict = new COSDictionary();
        buttonDict.setItem(COSName.TYPE, COSName.ANNOT);
        buttonDict.setItem(COSName.SUBTYPE, COSName.WIDGET);
        buttonDict.setItem(COSName.FT, COSName.BTN);
        
