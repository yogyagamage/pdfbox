    @Test
    public void testGetProviderTriggersLogTrace() throws IOException {
        // Create a minimal valid TTF file to trigger the font scanning path
        File fakeTtf = tempDir.resolve("testfont.ttf").toFile();
        
        // Write minimal TTF header (just enough to pass initial parsing)
        try (FileOutputStream fos = new FileOutputStream(fakeTtf)) {
            // TTF header: version 0x00010000, numTables=0, searchRange=0, entrySelector=0, rangeShift=0
            fos.write(new byte[] {
                0x00, 0x01, 0x00, 0x00,  // version 1.0
                0x00, 0x00,              // numTables = 0 (simplest case)
                0x00, 0x00,              // searchRange
                0x00, 0x00,              // entrySelector
