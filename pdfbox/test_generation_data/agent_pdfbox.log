        fontType0Dict.setItem(COSName.SUBTYPE, COSName.TYPE0);
        fontType0Dict.setItem(COSName.BASE_FONT, COSName.HELV);
        fontType0Dict.setItem(COSName.ENCODING, COSName.WIN_ANSI_ENCODING);
        fontDict.setItem(COSName.HELV, fontType0Dict);
        
