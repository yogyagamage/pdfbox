package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

class PDInlineImage_DCTFiltermethod_LogFactorygetLogFikaTest {

    @Test
    void testCreateInputStreamTriggersLogFactoryGetLog() throws IOException {
        // Create a mock COSDictionary for parameters
        COSDictionary mockParams = Mockito.mock(COSDictionary.class);
        
        // Create raw data that will trigger DCTFilter initialization
        byte[] rawData = new byte[] {
            // Minimal JPEG header to be recognized as DCT
            (byte)0xFF, (byte)0xD8, // SOI marker
            (byte)0xFF, (byte)0xE0, // APP0 marker
            0x00, 0x10, // Length 16
            'J', 'F', 'I', 'F', 0x00 // JFIF identifier
        };
        
        // Create PDInlineImage instance
        PDInlineImage image = new PDInlineImage(
            mockParams,
            rawData,
            new COSDictionary()
        );
        
        // Set up filters to include DCT_DECODE which will trigger DCTFilter class initialization
        List<String> filters = new ArrayList<>();
        filters.add(COSName.DCT_DECODE.getName());
        image.setFilters(filters);
        
        // Create stop filters list that doesn't contain DCT_DECODE
        List<String> stopFilters = new ArrayList<>();
        
        // This call will trigger:
        // 1. PDInlineImage.createInputStream()
        // 2. FilterFactory.INSTANCE.getFilter() -> triggers FilterFactory static initialization
        // 3. DCTFilter instantiation -> triggers DCTFilter static initialization
        // 4. LogFactory.getLog(DCTFilter.class) during DCTFilter static initialization
        image.createInputStream(stopFilters);
    }
}

