        // Configure mock to return the sequence of characters
        when(mockSource.read()).thenAnswer(invocation -> {
            int next = inputStream.read();
            return next != -1 ? next : -1;
        });
        
        when(mockSource.peek()).thenAnswer(invocation -> {
            inputStream.mark(0);
            int next = inputStream.read();
            inputStream.reset();
            return next != -1 ? next : -1;
        });
        
        when(mockSource.isEOF()).thenAnswer(invocation -> inputStream.available() == 0);
        when(mockSource.isClosed()).thenReturn(false);
        when(mockSource.getPosition()).thenReturn(0L);
        
        // Mock rewind to reset the stream position
        Mockito.doAnswer(invocation -> {
            int rewindBy = invocation.getArgument(0);
            inputStream.reset();
            byte[] buffer = new byte[rewindBy];
            inputStream.read(buffer);
            return null;
        }).when(mockSource).rewind(any(Integer.class));
        
        // Create the parser with the mocked source
        PDFStreamParser parser = new PDFStreamParser(mockSource);
        
        // This should trigger the full chain ending with Log.warn for invalid object number
        parser.parseNextToken();
    }
}

