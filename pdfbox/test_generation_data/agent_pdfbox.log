            Mockito.when(cosNumber.floatValue()).thenReturn(1.0f);
            operands.add(cosNumber);
        }

        // Create a mock operator
        Operator mockOperator = Mockito.mock(Operator.class);

        // Execute the entry point method
        curveTo.process(mockOperator, operands);
    }
}

