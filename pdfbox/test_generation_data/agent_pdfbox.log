package org.apache.pdfbox.rendering;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.rendering.PageDrawerParameters;
import org.apache.pdfbox.rendering.PDFRenderer;
import org.junit.jupiter.api.Test;

import java.awt.*;
import java.awt.geom.AffineTransform;
import java.awt.geom.GeneralPath;
import java.io.IOException;
import java.util.HashMap;
import java.util.Map;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

class PageDrawergetStroke_LogwarnFikaTest {

    @Test
    void testStrokePathTriggersLogWarn() throws IOException {
        // Create mocks for required dependencies
        PDDocument document = mock(PDDocument.class);
        PDPage page = mock(PDPage.class);
        PDFRenderer renderer = mock(PDFRenderer.class);
        
        // Setup page mock
        when(page.getMediaBox()).thenReturn(new PDRectangle(0, 0, 595, 842));
        when(page.getCropBox()).thenReturn(new PDRectangle(0, 0, 595, 842));
        when(page.getResources()).thenReturn(null);
        when(page.getAnnotations()).thenReturn(new java.util.ArrayList<>());
        
        // Setup renderer mock
        when(renderer.getPageImage()).thenReturn(null);
        when(renderer.document).thenReturn(document);
        
        // Create PageDrawerParameters
        PageDrawerParameters parameters = mock(PageDrawerParameters.class);
        when(parameters.getPage()).thenReturn(page);
        when(parameters.getRenderer()).thenReturn(renderer);
        when(parameters.isSubsamplingAllowed()).thenReturn(false);
        when(parameters.getDestination()).thenReturn(null);
        
        // Setup rendering hints
        Map<RenderingHints.Key, Object> hintsMap = new HashMap<>();
        hintsMap.put(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        hintsMap.put(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);
        hintsMap.put(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BICUBIC);
        RenderingHints renderingHints = new RenderingHints(hintsMap);
        
        when(parameters.getRenderingHints()).thenReturn(renderingHints);
        when(parameters.getImageDownscalingOptimizationThreshold()).thenReturn(0.5f);
        
        // Create PageDrawer instance
        PageDrawer pageDrawer = new PageDrawer(parameters);
        
        // Setup graphics context
        BufferedImage image = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = image.createGraphics();
        graphics.setTransform(new AffineTransform());
        
        // Initialize the drawer with a page
        pageDrawer.drawPage(graphics, new PDRectangle(0, 0, 595, 842));
        
        // Create a line path to stroke
        pageDrawer.moveTo(10, 10);
        pageDrawer.lineTo(50, 50);
        
        // Call strokePath() which should trigger getStroke() and eventually Log.warn()
        // when miterLimit < 1
        pageDrawer.strokePath();
        
        // Cleanup
        graphics.dispose();
