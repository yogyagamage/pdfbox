public class Loader_COSParserparseTrailer_LogwarnFikaTest {

    @Test
    public void testLoadFDFTriggersLogWarn() throws IOException {
        // Create a minimal FDF-like input stream that will trigger the warning path
        // The content is designed to make parseTrailer() encounter digits before 't'
        // This will trigger the lenient parsing warning in parseTrailer()
        String fdfContent = "%FDF-1.2\n" +
                "1 0 obj\n" +
                "<<\n" +
                "/FDF << /F (test.fdf) >>\n" +
                ">>\n" +
                "endobj\n" +
                "xref\n" +
                "0 2\n" +
                "0000000000 65535 f \n" +
                "0000000010 00000 n \n" +
                "12345\n" +  // This will be interpreted as extra xref entry in lenient mode
                "trailer\n" +
                "<<\n" +
                "/Size 2\n" +
                "/Root 1 0 R\n" +
                ">>\n" +
                "startxref\n" +
                "0\n" +
                "%%EOF\n";
        
        byte[] fdfBytes = fdfContent.getBytes();
        ByteArrayInputStream inputStream = new ByteArrayInputStream(fdfBytes);
        
        // Execute the entry point method
        FDFDocument document = Loader.loadFDF(inputStream);
        
        // No assertions or verifications - just ensure the method chain executes
        // The warning in parseTrailer() should be triggered during execution
    }
}

