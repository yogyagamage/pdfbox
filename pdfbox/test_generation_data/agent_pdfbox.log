                COSDictionary encodingDict = dict.getCOSDictionary(COSName.ENCODING);
                if ((encodingDict == null) || (!encodingDict.containsKey(COSName.DIFFERENCES))) {
                    // assume that if encoding is identity, then the reverse is also true
