class COSObjectgetObject_LogerrorFikaTest {

    @Test
    void testGetObject() throws Exception {
        // Create a real COSObject instance
        COSObject cosObject = new COSObject();
        
        // Use reflection to set private fields to trigger the IOException path
        java.lang.reflect.Field parserField = COSObject.class.getDeclaredField("parser");
