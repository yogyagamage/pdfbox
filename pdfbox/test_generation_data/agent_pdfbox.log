                } else {
                    pixelOutput[3] = Math.round(pixelOutput[3] * (g / 255.0F));
                }
            } else {
                pixelOutput[3] = Math.round(pixelOutput[3] * (bc / 255.0F));
            }
            output.setPixel(x, y, pixelOutput);
        }
    }
    return output;
}

