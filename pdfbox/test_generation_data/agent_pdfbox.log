class COSObjectgetObject_LogerrorFikaTest {

    @Test
    void testGetObjectTriggersLogError() throws Exception {
        // Create a mock parser that throws IOException when dereferenceCOSObject is called
        BaseParser mockParser = Mockito.mock(BaseParser.class);
        Mockito.when(mockParser.dereferenceCOSObject(Mockito.any(COSObject.class)))
                .thenThrow(new IOException("Test exception"));
        
        // Create a COSObject with the mock parser
