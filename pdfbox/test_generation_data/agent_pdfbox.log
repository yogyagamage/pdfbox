        List<COSBase> arguments = new ArrayList<>();
        arguments.add(COSName.getPDFName("MissingFont"));
        arguments.add(COSNumber.get(12));

        // Set up the operator map to use SetFontAndSize
        engine.operators.put("Tf", setFontAndSize);

        // Trigger the call chain
        engine.showTextString(new byte[]{65});
    }
}

