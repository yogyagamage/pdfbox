package org.apache.pdfbox.util;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import java.io.BufferedInputStream;
import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.util.Properties;

public class VersiongetVersion_LogdebugFikaTest {

    @TempDir
    File tempDir;

    @Test
    public void testGetVersionTriggersLogDebug() throws Exception {
        // Create a properties file that will cause an IOException when read
        File propertiesFile = new File(tempDir, "pdfbox-version.properties");
        try (FileOutputStream fos = new FileOutputStream(propertiesFile)) {
            // Write a file that will cause an IOException when read as properties
            fos.write("invalid properties content".getBytes());
        }

        // Use reflection to set the PDFBOX_VERSION_PROPERTIES field to our problematic file path
        java.lang.reflect.Field field = Version.class.getDeclaredField("PDFBOX_VERSION_PROPERTIES");
        field.setAccessible(true);
        String originalPath = (String) field.get(null);
        
        try {
            // Set to a path that will cause an IOException when loaded
            field.set(null, "/non-existent-path.properties");
            
            // This call should trigger the IOException and invoke Log.debug()
            Version.getVersion();
        } finally {
            // Restore original path
            field.set(null, originalPath);
        }
    }
}

