        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // PNG header bytes followed by IHDR chunk with invalid bit depth (e.g., 3)
        // PNG signature + IHDR chunk with bitDepth = 3 (invalid)
        byte[] pngBytes = new byte[] {
            // PNG signature (8 bytes)
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
            // IHDR chunk length (13 bytes)
            0x00, 0x00, 0x00, 0x0D,
            // Chunk type "IHDR"
            0x49, 0x48, 0x44, 0x52,
            // Width: 1 pixel
            0x00, 0x00, 0x00, 0x01,
            // Height: 1 pixel
            0x00, 0x00, 0x00, 0x01,
            // Bit depth: 3 (invalid)
            0x03,
            // Color type: 2 (Truecolor)
            0x02,
            // Compression method: 0
            0x00,
            // Filter method: 0
            0x00,
            // Interlace method: 0
            0x00,
            // CRC for IHDR (dummy value)
            0x00, 0x00, 0x00, 0x00,
