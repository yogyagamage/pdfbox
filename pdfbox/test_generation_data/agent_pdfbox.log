package org.apache.pdfbox.pdmodel.interactive.annotation.handlers;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationStrikeout;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotation;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAppearanceStream;
import org.apache.pdfbox.pdmodel.interactive.annotation.handlers.PDStrikeoutAppearanceHandler;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.graphics.color.PDColor;
import org.apache.pdfbox.pdmodel.graphics.color.PDDeviceRGB;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;
import java.lang.reflect.Field;

public class PDStrikeoutAppearanceHandlergenerateNormalAppearance_LogerrorFikaTest {

    @Test
    public void testGenerateNormalAppearance() throws Exception {
        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // Create a real PDPage
        PDPage page = new PDPage();
        document.addPage(page);
        
        // Create a real PDAnnotationStrikeout
        PDAnnotationStrikeout annotation = new PDAnnotationStrikeout();
        
        // Set required properties on the annotation
        annotation.setRectangle(new PDRectangle(100, 100, 200, 50));
        
        // Create a valid color
        PDColor color = new PDColor(new float[]{0, 0, 0}, PDDeviceRGB.INSTANCE);
        annotation.setColor(color);
        
        // Set quad points - need at least 8 values for the loop to execute
        annotation.setQuadPoints(new float[]{110, 110, 190, 110, 110, 140, 190, 140});
        
        // Create a mock PDAnnotationBorder to avoid null pointer
        // We need to set border style to avoid NPE in AnnotationBorder.getAnnotationBorder
        annotation.setBorderStyle(PDAnnotationBorderStyle.createSolidBorderStyle());
        
        // Create the handler with the annotation
        PDStrikeoutAppearanceHandler handler = new PDStrikeoutAppearanceHandler(annotation, document);
        
        // Use reflection to inject a mock LOG that will throw IOException
        // This ensures we reach the catch block where LOG.error is called
        Field logField = PDStrikeoutAppearanceHandler.class.getDeclaredField("LOG");
        logField.setAccessible(true);
        
        // Create a mock Log that will do nothing when error is called
        org.apache.commons.logging.Log mockLog = Mockito.mock(org.apache.commons.logging.Log.class);
        logField.set(handler, mockLog);
        
        // Now we need to make getNormalAppearanceAsContentStream() throw IOException
        // We'll create a subclass that overrides this method
        PDStrikeoutAppearanceHandler throwingHandler = new PDStrikeoutAppearanceHandler(annotation, document) {
            @Override
            protected PDAppearanceStream getNormalAppearanceAsContentStream() throws IOException {
                throw new IOException("Test exception to trigger LOG.error");
            }
        };
        
        // Inject the same mock LOG into the throwing handler
        logField.set(throwingHandler, mockLog);
        
        // This should trigger the IOException and call LOG.error
        throwingHandler.generateNormalAppearance();
        
        // Clean up
        document.close();
    }
}

