                // Return an InputStream that will trigger the debug log
                return new InputStream() {
                    private int bytesRead = 0;
                    private final int totalBytes = 100; // Less than expected

                    @Override
                    public int read() {
                        if (bytesRead >= totalBytes) {
                            return -1;
                        }
                        bytesRead++;
                        return 0;
