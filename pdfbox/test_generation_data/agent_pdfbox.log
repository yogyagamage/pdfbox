package org.apache.pdfbox.rendering;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationStrikeout;
import org.apache.pdfbox.rendering.PageDrawer;
import org.apache.pdfbox.rendering.PageDrawerParameters;
import org.apache.pdfbox.rendering.PDFRenderer;
import org.junit.jupiter.api.Test;

import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

public class PageDrawer_PDStrikeoutAppearanceHandlermethod_LogFactorygetLogFikaTest {

    @Test
    public void testDrawPageTriggersLogFactoryGetLog() throws IOException {
        // Create minimal PDDocument with a page
        PDDocument document = new PDDocument();
        PDPage page = new PDPage();
        document.addPage(page);
        
        // Create PDFRenderer (required for PageDrawerParameters)
        PDFRenderer renderer = new PDFRenderer(document);
        
        // Create PageDrawerParameters with minimal setup
        PageDrawerParameters parameters = new PageDrawerParameters(page, renderer);
        
        // Create PageDrawer instance using the provided constructor
        PageDrawer pageDrawer = new PageDrawer(parameters);
        
        // Create a strikeout annotation and add it to the page
        PDAnnotationStrikeout strikeout = new PDAnnotationStrikeout();
        strikeout.setRectangle(new PDRectangle(100, 100, 50, 50));
        
        // Get annotations list and add our strikeout annotation
        List<PDAnnotationStrikeout> annotations = new ArrayList<>();
        annotations.add(strikeout);
        
        // Use reflection to set the annotations on the page since PDPage.getAnnotations() 
        // would normally read from the COSDictionary
        try {
            java.lang.reflect.Field annotationsField = PDPage.class.getDeclaredField("annotations");
            annotationsField.setAccessible(true);
            annotationsField.set(page, annotations);
        } catch (Exception e) {
            // If reflection fails, we'll work with what we have
        }
        
        // Create a minimal Graphics2D context
        BufferedImage image = new BufferedImage(300, 300, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = image.createGraphics();
        
        // Call the entry point method - this should trigger the call chain
        // that eventually calls LogFactory.getLog()
        pageDrawer.drawPage(graphics, new PDRectangle(300, 300));
        
        // Cleanup
        graphics.dispose();
        document.close();
    }
}

