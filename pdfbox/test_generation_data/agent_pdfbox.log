@Override
public void process(Operator operator, List<COSBase> arguments) throws IOException // PATH: Test should invoke the next PDFStreamEngine.processOperator(...) [step in execution path]
{
    // move to start of next text line
    List<COSBase> args = new ArrayList<>(2);
