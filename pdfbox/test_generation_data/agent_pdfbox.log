        // Create a minimal FDF content that will trigger the log warning
        String fdfContent = "%FDF-1.2\n" +
                "1 0 obj\n" +
                "<<\n" +
                "   /FDF << /F (test.fdf) >>\n" +
                ">>\n" +
                "endobj\n" +
                "trailer\n" +
                "<<\n" +
                "   /Root 1 0 R\n" +
                ">>\n" +
                "%%EOF";
        
