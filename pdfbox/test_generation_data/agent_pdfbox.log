public class PageExtractor_PDNameTreeNodegetNames_LogwarnFikaTest {

    @Test
    public void testExtractTriggersLogWarn() throws IOException {
        // Create a minimal PDDocument with necessary structure
        PDDocument sourceDocument = new PDDocument();
        
        // Add a page to the document
        PDPage page = new PDPage();
        sourceDocument.addPage(page);
        
        // Create a PDAnnotationLink with a PDNamedDestination
        PDAnnotationLink link = new PDAnnotationLink();
        PDNamedDestination namedDest = new PDNamedDestination("testDest");
        link.setDestination(namedDest);
        
        // Add the link annotation to the page
        List<PDAnnotationLink> annotations = new ArrayList<>();
        annotations.add(link);
        page.setAnnotations(annotations);
        
        // Create a COSArray with odd size to trigger the warning in PDNameTreeNode.getNames()
        COSArray oddNamesArray = new COSArray();
        oddNamesArray.add(COSString.fromString("key1"));
        oddNamesArray.add(new COSDictionary());
        oddNamesArray.add(COSString.fromString("key2")); // Odd size: 3 elements
        
        // Create a PDNameTreeNode that will return the odd-sized array
        PDNameTreeNode<?> nameTreeNode = Mockito.mock(PDNameTreeNode.class, Mockito.CALLS_REAL_METHODS);
        COSDictionary nodeDict = new COSDictionary();
        nodeDict.setItem(COSName.NAMES, oddNamesArray);
        Mockito.when(nameTreeNode.getCOSObject()).thenReturn(nodeDict);
        
        // Create a PDDocumentCatalog that will use our mocked name tree
        PDDocumentCatalog catalog = Mockito.mock(PDDocumentCatalog.class);
        PDDocumentNameDictionary namesDict = Mockito.mock(PDDocumentNameDictionary.class);
        PDDestinationNameTreeNode destsTree = Mockito.mock(PDDestinationNameTreeNode.class);
        
        Mockito.when(catalog.getNames()).thenReturn(namesDict);
        Mockito.when(namesDict.getDests()).thenReturn(destsTree);
        Mockito.when(destsTree.getValue(Mockito.anyString())).thenAnswer(invocation -> {
            // This triggers PDNameTreeNode.getValue() -> getNames() -> Log.warn()
