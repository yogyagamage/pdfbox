    @Test
    void testBuildSignatureTriggersLogFactoryGetLog() throws IOException {
        PDVisibleSigProperties properties = new PDVisibleSigProperties();
        
        // Set required properties to avoid NPEs during execution
        properties.setPdVisibleSignature(Mockito.mock(PDVisibleSignature.class));
        properties.setImageData(new byte[]{1, 2, 3});
        properties.setImageParameters(Mockito.mock(PDVisibleSignDesigner.class));
        properties.setSignatureFieldPosition(100, 200, 300, 400);
        
        // This will trigger the static initialization of PDFTemplateCreator
        // which calls LogFactory.getLog(PDFTemplateCreator.class)
        properties.buildSignature();
    }
