import java.util.Map;

@ExtendWith(MockitoExtension.class)
class PDFObjectStreamParser_BaseParserdecodeBuffer_LogdebugFikaTest {

    @Mock
    private RandomAccessRead mockSource;

    @Test
    void testParseObjectTriggersLogDebug() throws IOException {
        // Create a minimal PDF stream that will trigger the parseCOSName -> decodeBuffer path
        // Stream format: object numbers and offsets followed by objects
        // We'll create a stream with one object that is a name with invalid UTF-8 bytes
        
        // First, create object number to offset mapping
        Map<Long, Integer> objectOffsets = new HashMap<>();
        objectOffsets.put(1L, 0); // First object starts at offset 0 in the object data
        
        // Create object stream data that will trigger the decodeBuffer exception path
        // The object data needs to contain a name with bytes that cause UTF-8 decoding to fail
        // but are valid for the alternative charset (ISO-8859-1)
        
        // Object stream format: 
        // 1 0 obj << /Type /ObjStm ... >> stream
        // [1 0]  % object numbers and offsets
        // (actual object data)
        // endstream endobj
        
        // We'll create a simple object that is just a name with special bytes
        // The name "/Test#FF" where #FF is hex for byte 255 which is invalid in UTF-8
        String objectData = "/Test#FF"; // This will be parsed as a name with byte 255
        
        // Convert to bytes using ISO-8859-1 to include byte 255
        byte[] objectDataBytes = objectData.getBytes(java.nio.charset.StandardCharsets.ISO_8859_1);
        
        // Create a RandomAccessRead that provides the object stream data
        RandomAccessRead testSource = new org.apache.pdfbox.io.RandomAccessReadBuffer(
            new ByteArrayInputStream(objectDataBytes)
        );
        
        // Create a COSDictionary for the object stream
        COSDictionary streamDict = new COSDictionary();
        streamDict.setInt(COSName.N, 1); // 1 object in the stream
        streamDict.setInt(COSName.FIRST, 8); // First object starts at byte 8 (after "[1 0]")
        
        // Create the parser - we need to use reflection to set up the internal state
        PDFObjectStreamParser parser = new PDFObjectStreamParser(
            testSource, 
            streamDict, 
            null // document can be null
        );
        
        // Use reflection to set the object offsets map
        try {
            java.lang.reflect.Field privateReadObjectNumbersField = 
                PDFObjectStreamParser.class.getDeclaredField("privateReadObjectNumbers");
            privateReadObjectNumbersField.setAccessible(true);
            privateReadObjectNumbersField.set(parser, objectOffsets);
            
            // Also set the firstObject field to 0
            java.lang.reflect.Field firstObjectField = 
                PDFObjectStreamParser.class.getDeclaredField("firstObject");
            firstObjectField.setAccessible(true);
            firstObjectField.set(parser, 0L);
        } catch (Exception e) {
            throw new RuntimeException("Failed to set up parser via reflection", e);
        }
        
        // Now parse object number 1 - this should trigger the path to decodeBuffer
        // which will fail UTF-8 decoding and call LOG.debug()
        parser.parseObject(1L);
    }
}

