package org.apache.pdfbox.pdmodel.interactive.digitalsignature;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.io.RandomAccessReadBuffer;
import java.io.ByteArrayInputStream;
import java.io.InputStream;

public class SignatureOptions_BaseParsermethod_LogwarnFikaTest2 {

    @Test
    public void testSetVisualSignatureTriggersBaseParserStaticInitializer() throws Exception {
        // Create a minimal PDF-like input stream to trigger parser initialization
        // PDF header followed by minimal valid structure to avoid early parsing errors
        String minimalPDF = "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<< /Type /Catalog /Pages 2 0 R >>\n" +
                "endobj\n" +
                "2 0 obj\n" +
                "<< /Type /Pages /Kids [] /Count 0 >>\n" +
                "endobj\n" +
                "xref\n" +
                "0 3\n" +
                "0000000000 65535 f \n" +
                "0000000010 00000 n \n" +
                "0000000050 00000 n \n" +
                "trailer\n" +
                "<< /Size 3 /Root 1 0 R >>\n" +
                "startxref\n" +
                "100\n" +
                "%%EOF";
        
        InputStream pdfStream = new ByteArrayInputStream(minimalPDF.getBytes());
        SignatureOptions options = new SignatureOptions();
        
        // This call should trigger the static initializer in BaseParser
        // which will invoke Log.warn() when charset loading fails
        options.setVisualSignature(pdfStream);
    }
}

