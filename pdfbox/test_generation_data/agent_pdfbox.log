        // Create a minimal PDF document with a free text annotation
        byte[] pdfBytes = createMinimalPdfWithFreeTextAnnotation();
        PDDocument document = PDDocument.load(new ByteArrayInputStream(pdfBytes));
        
        // Create PDFRenderer instance using provided constructor
        PDFRenderer renderer = new PDFRenderer(document);
        
        // Set up renderer to ensure annotations are processed
        renderer.setAnnotationsFilter(annotation -> true);
        renderer.setSubsamplingAllowed(false);
        
