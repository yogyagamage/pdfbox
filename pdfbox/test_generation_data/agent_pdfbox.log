    @Test
    public void testParseTriggersLogWarn() throws IOException {
        // Create a minimal PDF content that will trigger the warning in parseCOSDictionary
        // The content needs to cause the parser to reach the LOG.warn call when encountering
        // an invalid dictionary structure (not starting with '/')
        String pdfContent = "%PDF-1.4\n" +
                "1 0 obj\n" +
                "<<\n" +
                "invalidKey  % This will trigger the warning - not starting with '/'\n" +
                ">>\n" +
                "endobj\n" +
                "trailer\n" +
                "<<\n" +
                "/Size 1\n" +
                "/Root 1 0 R\n" +
                ">>\n" +
                "startxref\n" +
                "0\n" +
                "%%EOF";
        
        byte[] pdfBytes = pdfContent.getBytes();
        RandomAccessRead randomAccessRead = new RandomAccessReadBuffer(new ByteArrayInputStream(pdfBytes));
        
        // Create PDFParser with lenient mode to allow parsing to continue despite errors
        PDFParser parser = new PDFParser(randomAccessRead);
        
        // Execute the entry point method
        parser.parse(true);
    }
}

