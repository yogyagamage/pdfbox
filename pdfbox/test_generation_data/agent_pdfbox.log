        // Width = 1
        ihdrData[8] = 0; ihdrData[9] = 0; ihdrData[10] = 0; ihdrData[11] = 1;
        // Height = 1
        ihdrData[12] = 0; ihdrData[13] = 0; ihdrData[14] = 0; ihdrData[15] = 1;
        // Bit depth = 8
        ihdrData[16] = 8;
        // Color type = 2 (Truecolor)
        ihdrData[17] = 2;
        // Compression method = 0, Filter method = 0, Interlace method = 0
        ihdrData[18] = 0; ihdrData[19] = 0; ihdrData[20] = 0;
        // CRC placeholder
        System.arraycopy(new byte[]{0, 0, 0, 0}, 0, ihdrData, 21, 4);
        baos.write(ihdrData, 0, ihdrData.length);
        
