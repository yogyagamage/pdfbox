package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.pdmodel.font.FileSystemFontProvider;
import org.apache.pdfbox.pdmodel.font.FontFormat;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

class FSFontInfogetType1Font_LogdebugFikaTest {

    @TempDir
    Path tempDir;

    @Test
    void testGetFontTriggersLogDebug() throws IOException {
        // Create a minimal PFB file (Type1 font format)
        File pfbFile = tempDir.resolve("test.pfb").toFile();
        // PFB files start with %!PS and have specific binary sections
        // We'll create a minimal valid PFB that Type1Font.createWithPFB can parse
        byte[] pfbContent = new byte[] {
            0x80, 0x01, // PFB segment type 1 (ASCII)
            0x00, 0x00, 0x00, 0x06, // Length 6
            '%', '!', 'P', 'S', '-', 'A',
            0x80, 0x03, // PFB segment type 3 (EOF)
            0x00, 0x00, 0x00, 0x00  // Length 0
        };
        Files.write(pfbFile.toPath(), pfbContent);

        // Create a FileSystemFontProvider with a cache
        FileSystemFontProvider provider = new FileSystemFontProvider();
        
        // Create FSFontInfo instance with PFB format
        FileSystemFontProvider.FSFontInfo fontInfo = 
            new FileSystemFontProvider.FSFontInfo(
                provider,
                pfbFile,
                "TestFont",
                FontFormat.PFB,
                "TestFont",
                null
            );

        // This should trigger the call chain:
        // getFont() -> getType1Font() -> LOG.debug()
        fontInfo.getFont();
    }
}

