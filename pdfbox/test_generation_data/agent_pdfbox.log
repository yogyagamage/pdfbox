/**
 * Creates an MMType1Font from a Font dictionary in a PDF.
 *
 * @param fontDictionary
 * 		font dictionary
 * @throws IOException
 * 		if the font could not be read
 */
public (COSDictionary fontDictionary) throws IOException // PATH: Test should invoke the next new PDType1Font(...) [step in execution path]
{
    this(fontDictionary);
