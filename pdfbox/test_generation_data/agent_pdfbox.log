import java.util.List;

public class PageExtractor_PDDocumentmethod_LogdebugFikaTest {

    @Test
    public void testExtractTriggersLogDebug() throws IOException {
        // Create a minimal PDDocument with at least one page
        PDDocument sourceDocument = new PDDocument();
        PDPage page = new PDPage();
        sourceDocument.addPage(page);
        
        // Create PageExtractor with valid page range
        PageExtractor extractor = new PageExtractor(sourceDocument, 1, 1);
        
        // Execute the entry point method
        extractor.extract();
        
        // Close documents to avoid resource leaks
        sourceDocument.close();
    }
}

