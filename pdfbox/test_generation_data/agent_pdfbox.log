    private byte[] createTestJPEGData() {
        // Create minimal JPEG data that will be recognized as JPEG by ImageIO
        // and will have 4 components when decoded
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        
        // JPEG Start of Image marker
        baos.write(0xFF);
        baos.write(0xD8); // SOI
        
        // APP14 marker with Adobe color transform for YCCK (value 2)
        baos.write(0xFF);
        baos.write(0xEE); // APP14
        baos.write(0x00);
        baos.write(0x0E); // Length (14 bytes)
        baos.write("Adobe".getBytes(), 0, 5); // Identifier
        baos.write(0x00); // Version
        baos.write(0x00); // Flags0
        baos.write(0x00); // Flags1
        baos.write(0x00); // Color transform (0=Unknown, 1=YCbCr, 2=YCCK)
        baos.write(0x02); // Set to 2 for YCCK
        
        // Start of Frame (SOF) marker for CMYK
        baos.write(0xFF);
        baos.write(0xC0); // SOF0
        baos.write(0x00);
        baos.write(0x11); // Length (17 bytes)
        baos.write(0x08); // Precision (8 bits)
        baos.write(0x00);
        baos.write(0x64); // Height (100)
        baos.write(0x00);
        baos.write(0x64); // Width (100)
        baos.write(0x04); // Number of components (4 for CMYK)
        
        // Component 1
        baos.write(0x01); // Component ID
        baos.write(0x22); // Sampling factors (2x2)
        baos.write(0x00); // Quantization table selector
        
        // Component 2
        baos.write(0x02); // Component ID
        baos.write(0x11); // Sampling factors (1x1)
        baos.write(0x01); // Quantization table selector
        
        // Component 3
        baos.write(0x03); // Component ID
        baos.write(0x11); // Sampling factors (1x1)
        baos.write(0x01); // Quantization table selector
        
        // Component 4
        baos.write(0x04); // Component ID
        baos.write(0x11); // Sampling factors (1x1)
        baos.write(0x01); // Quantization table selector
        
        // Start of Scan (SOS) marker
        baos.write(0xFF);
        baos.write(0xDA); // SOS
        baos.write(0x00);
        baos.write(0x0C); // Length (12 bytes)
        baos.write(0x04); // Number of components in scan (4)
        
        // Scan component 1
        baos.write(0x01); // Component ID
        baos.write(0x00); // DC/AC selector
        
        // Scan component 2
        baos.write(0x02); // Component ID
        baos.write(0x11); // DC/AC selector
        
        // Scan component 3
        baos.write(0x03); // Component ID
        baos.write(0x11); // DC/AC selector
        
        // Scan component 4
        baos.write(0x04); // Component ID
        baos.write(0x11); // DC/AC selector
        
        baos.write(0x00); // Spectral selection start
        baos.write(0x3F); // Spectral selection end
        baos.write(0x00); // Successive approximation
        
        // Add some dummy scan data
        for (int i = 0; i < 100; i++) {
            baos.write(0x00);
        }
        
        // End of Image marker
        baos.write(0xFF);
        baos.write(0xD9); // EOI
        
        return baos.toByteArray();
    }
}

