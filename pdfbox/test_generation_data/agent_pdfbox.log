public class PDImageXObject_PNGConverterbuildImageObject_LogerrorFikaTest {

    @Test
    public void testCreateFromByteArrayTriggersLogError() throws Exception {
        // Create a PDDocument instance
        PDDocument document = new PDDocument();
        
        // Create PNG data that will cause the gAMA chunk length check to fail
        // PNG signature + IHDR chunk + gAMA chunk with wrong length
        byte[] pngData = createInvalidPNGWithBadGAMAChunk();
        
        // Create a custom factory that does nothing (will not be used for PNG)
        CustomFactory customFactory = new CustomFactory() {
            @Override
            public PDImageXObject createFromByteArray(PDDocument doc, byte[] bytes) throws IOException {
                return null;
            }
        };
        
        try {
            // This should trigger the execution path that leads to Log.error()
            PDImageXObject.createFromByteArray(document, pngData, "test.png", customFactory);
        } catch (Exception e) {
            // Ignore all exceptions - we only care about execution reaching the target method
        } finally {
            document.close();
        }
    }
    
    private byte[] createInvalidPNGWithBadGAMAChunk() throws Exception {
        // PNG signature
        byte[] signature = new byte[] {
            (byte)0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk (13 bytes data)
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x01,  // width = 1
            0x00, 0x00, 0x00, 0x01,  // height = 1
            0x08,                     // bit depth = 8
            0x02,                     // color type = 2 (truecolor)
            0x00,                     // compression method = 0
            0x00,                     // filter method = 0
            0x00                      // interlace method = 0
        };
        
        // gAMA chunk with wrong length (not 4 bytes)
        byte[] gamaData = new byte[] {
            0x00, 0x00, 0x00, 0x01,  // gamma value (wrong length - should be 4 total)
            0x00                     // extra byte to make length 5
        };
        
        // Calculate CRC (using dummy values for simplicity)
        int ihdrCrc = 0x12345678;
        int gamaCrc = 0x87654321;
        
        // Build the PNG byte array
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        
        // Write signature
        baos.write(signature);
        
        // Write IHDR chunk
        baos.write(intToBytes(13));           // Length
        baos.write("IHDR".getBytes("ASCII")); // Chunk type
        baos.write(ihdrData);                 // Chunk data
        baos.write(intToBytes(ihdrCrc));      // CRC
        
        // Write gAMA chunk with wrong length (5 instead of 4)
        baos.write(intToBytes(5));            // Length = 5 (wrong!)
        baos.write("gAMA".getBytes("ASCII")); // Chunk type
        baos.write(gamaData);                 // Chunk data (5 bytes)
        baos.write(intToBytes(gamaCrc));      // CRC
        
        // Write IEND chunk
        baos.write(intToBytes(0));            // Length = 0
        baos.write("IEND".getBytes("ASCII")); // Chunk type
        baos.write(intToBytes(0xAE426082));   // CRC for IEND
        
        return baos.toByteArray();
    }
    
    private byte[] intToBytes(int value) {
        return new byte[] {
            (byte)(value >>> 24),
            (byte)(value >>> 16),
            (byte)(value >>> 8),
            (byte)value
        };
    }
    
    // Helper class to mimic ByteArrayOutputStream
    private static class ByteArrayOutputStream {
        private java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        
        public void write(byte[] bytes) throws IOException {
            baos.write(bytes);
        }
        
        public void write(int b) {
            baos.write(b);
        }
        
        public byte[] toByteArray() {
            return baos.toByteArray();
        }
    }
}

