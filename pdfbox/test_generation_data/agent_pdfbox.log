        Mockito.when(encryptionCosDict.getCOSArray(COSName.RECIPIENTS)).thenReturn(recipientsArray);
        Mockito.when(cryptFilterCosDict.getCOSArray(COSName.RECIPIENTS)).thenReturn(null);
        
