    // see 9.7.4.3, "Glyph Metrics in CIDFonts"
    widths = new HashMap<>();
    COSArray wArray = dict.getCOSArray(COSName.W);
    if (wArray != null) {
        int size = wArray.size();
        int counter = 0;
        while (counter < (size - 1)) {
            COSBase firstCodeBase = wArray.getObject(counter++);
