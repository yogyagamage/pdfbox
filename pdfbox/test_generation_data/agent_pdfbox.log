package org.apache.pdfbox.pdmodel.interactive.form;

import org.apache.pdfbox.cos.COSArray;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.form.PDAcroForm;
import org.apache.pdfbox.pdmodel.interactive.form.PDField;
import org.apache.pdfbox.pdmodel.interactive.form.PDNonTerminalField;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

public class PDAcroForm_PDNonTerminalFieldgetChildren_LogwarnFikaTest {

    @Test
    public void testExportFDFTriggersLogWarn() throws IOException {
        // Create a mock PDDocument required for PDAcroForm constructor
        PDDocument mockDocument = Mockito.mock(PDDocument.class);
        
        // Create a COSDictionary with a KIDS array that contains a self-reference
        COSDictionary formDictionary = new COSDictionary();
        COSArray kidsArray = new COSArray();
        
        // Create a COSDictionary that will represent a child field
        COSDictionary childDict = new COSDictionary();
        kidsArray.add(childDict);
        
        // Add the kids array to the form dictionary
        formDictionary.setItem(COSName.KIDS, kidsArray);
        
        // Create PDAcroForm using the constructor that accepts both document and dictionary
        PDAcroForm acroForm = new PDAcroForm(mockDocument, formDictionary);
        
        // Create a PDNonTerminalField that will have a child referencing itself
        PDNonTerminalField nonTerminalField = new PDNonTerminalField(acroForm, childDict, null);
        
        // Modify the child dictionary to reference itself (creating the self-reference condition)
        // This will trigger the LOG.warn in getChildren() when kid.getCOSObject() == this.getCOSObject()
        COSArray selfReferencingKids = new COSArray();
        selfReferencingKids.add(childDict); // Add the field's own dictionary as a child
        childDict.setItem(COSName.KIDS, selfReferencingKids);
        
        // Create a list of fields for the acroForm
        List<PDField> fields = new ArrayList<>();
        fields.add(nonTerminalField);
        
        // Set the fields on the acroForm
        acroForm.setFields(fields);
        
        // Call the entry point method - this should traverse through the call chain
        // and eventually trigger the LOG.warn in PDNonTerminalField.getChildren()
        acroForm.exportFDF();
    }
}

