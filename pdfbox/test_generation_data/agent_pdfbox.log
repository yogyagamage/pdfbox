            0x00, 0x00, 0x00, // color 0
            0x7F, 0x7F, 0x7F, // color 1
            0xFF, 0xFF, 0xFF  // color 2
        };
        byte[] plteChunk = createChunk("PLTE", plteData);
        
        // iCCP chunk: ICC profile with compression method 0 (deflate)
        // Create a minimal ICC profile (sRGB)
