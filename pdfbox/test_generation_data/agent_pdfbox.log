    @Test
    public void testLogWarnInvocation() throws IOException {
        // Create a minimal PDDocument
        PDDocument document = new PDDocument();
        
        // Create a PNG byte array that will trigger the indexed color path
        // This PNG must be recognized as PNG and have colorType 3 (indexed)
        // and contain an ICC profile to reach PDICCBased.loadICCProfile()
        byte[] pngBytes = createIndexedPngWithICCProfile();
        
        // Call the entry point method
        PDImageXObject.createFromByteArray(document, pngBytes, "test.png");
        
        document.close();
    }
    
    private byte[] createIndexedPngWithICCProfile() throws IOException {
