class PDFontFactoryfixType0Subtype_LogwarnFikaTest {

    @Test
    void testCreateFontTriggersFixType0SubtypeAndLogWarn() throws IOException {
        // Create a Type 0 font dictionary with mismatched descendant font type
        COSDictionary fontDict = new COSDictionary();
        fontDict.setItem(COSName.TYPE, COSName.FONT);
        fontDict.setItem(COSName.SUBTYPE, COSName.TYPE0);
        
        // Create descendant font with wrong subtype
        COSDictionary descendantFont = new COSDictionary();
        descendantFont.setItem(COSName.SUBTYPE, COSName.CID_FONT_TYPE2); // Wrong for Type 1 font
        
        // Create font descriptor with Type 1 characteristics
        COSDictionary fontDescriptor = new COSDictionary();
        fontDescriptor.setItem(COSName.FONT_NAME, COSName.getPDFName("TestFont"));
        fontDescriptor.setItem(COSName.FONT_FILE3, new COSDictionary()); // Type 1 font file
        
        // Build the font structure
        fontDict.setItem(COSName.DESCENDANT_FONTS, new COSDictionary());
        fontDict.getCOSDictionary(COSName.DESCENDANT_FONTS).setItem(COSName.FONT, descendantFont);
        fontDict.setItem(COSName.FONT_DESC, fontDescriptor);
        
        // Execute the entry point - should trigger fixType0Subtype which calls Log.warn()
        PDFontFactory.createFont(fontDict, null);
    }
}

