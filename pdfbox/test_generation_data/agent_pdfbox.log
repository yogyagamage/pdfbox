package org.apache.pdfbox.contentstream;

import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDResources;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.font.PDFont;
import org.apache.pdfbox.pdmodel.font.PDType1Font;
import org.apache.pdfbox.pdmodel.graphics.state.PDGraphicsState;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;

public class PDFStreamEnginedecreaseLevel_LogerrorFikaTest {

    @Test
    public void testDecreaseLevelTriggersLogError() throws IOException {
        // Create a real PDFStreamEngine instance
        PDFStreamEngine engine = new PDFStreamEngine();
        
        // Set up a real page with resources to avoid NPE during engine initialization
        PDPage page = new PDPage(PDRectangle.A4);
        PDResources resources = new PDResources();
        page.setResources(resources);
        
        // Add a font to resources to avoid NPE when processing text
        PDFont font = PDType1Font.HELVETICA;
        resources.put(PDType1Font.HELVETICA.getBaseFont(), font);
        
        // Initialize the engine with the page
        engine.processPage(page);
        
        // Set level to 0 so that decreaseLevel() will make it -1 and trigger the log error
        // We need to access the level field which is protected in the parent class
        // Since we can't extend the class, we'll use reflection
        try {
            java.lang.reflect.Field levelField = PDFStreamEngine.class.getDeclaredField("level");
            levelField.setAccessible(true);
            levelField.set(engine, 0);
        } catch (Exception e) {
            throw new RuntimeException("Failed to set level field", e);
        }
        
        // Call the entry point method - this should trigger the third-party method
        engine.decreaseLevel();
    }
}

