import org.junit.jupiter.api.Test;

import java.awt.geom.AffineTransform;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDFRenderer_PageDrawermethod_LogFactorygetLogFikaTest {

    @Test
    public void testPageDrawerInitializationTriggersLogFactoryGetLog() throws IOException {
        // Create minimal PDF document with one page
        byte[] pdfData = "%PDF-1.4\n1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] >>\nendobj\nxref\n0 4\n0000000000 65535 f \n0000000010 00000 n \n0000000053 00000 n \n0000000102 00000 n \ntrailer\n<< /Size 4 /Root 1 0 R >>\nstartxref\n149\n%%EOF".getBytes();
        
        try (PDDocument document = PDDocument.load(new ByteArrayInputStream(pdfData))) {
            PDPage page = new PDPage(PDRectangle.A4);
            
            // Create PageDrawerParameters with real objects
            PageDrawerParameters params = new PageDrawerParameters(
                document.getPage(0),
                new AffineTransform(),
                72, // DPI
                0,  // subsampling
                null, // imageListener
                null, // annotations
                null  // destination
            );
            
            // Instantiate PageDrawer - this triggers static initialization
            // which calls LogFactory.getLog(PageDrawer.class)
            new PageDrawer(params);
        }
    }
}

