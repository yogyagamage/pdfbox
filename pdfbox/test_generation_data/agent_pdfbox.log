        if ((cmap != null) && (!cmap.hasUnicodeMappings())) {
            String name = getName();
            LOG.warn("Invalid ToUnicode CMap in font " + name);
            String cmapName = (cmap.getName() != null) ? cmap.getName() : "";
            String ordering = (cmap.getOrdering() != null) ? cmap.getOrdering() : "";
