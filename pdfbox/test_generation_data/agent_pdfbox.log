class COSParser_BaseParserparseCOSName_LogerrorFikaTest {

    @Test
    void testDereferenceCOSObjectTriggersLogError() throws IOException {
        // Create a minimal PDF content that will trigger the error path in parseCOSName
        // The content needs to be structured so that:
