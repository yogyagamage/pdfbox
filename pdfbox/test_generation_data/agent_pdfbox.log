    @Test
    void testSaveIncrementalTriggersLogDebug() throws Exception {
        // Create a COSDocument with a source to allow incremental save
        COSDocument cosDoc = new COSDocument();
        RandomAccessRead source = Mockito.mock(RandomAccessRead.class);
        
        // Create PDDocument with source to satisfy saveIncremental requirements
