public class PDFRenderer_PDTextAppearanceHandlergenerateNormalAppearance_LogerrorFikaTest {

    @Test
    public void testRenderImageWithDPI() throws IOException {
        // Create a minimal PDF document with one page
        PDDocument document = new PDDocument();
        PDPage page = new PDPage(PDRectangle.A4);
        document.addPage(page);
        
        // Add a PDAnnotationText annotation that will trigger the error log
        PDAnnotationText annotationText = new PDAnnotationText();
        annotationText.setRectangle(new PDRectangle(100, 100, 50, 50));
        annotationText.setName(PDAnnotationText.NAME_NOTE);
        page.getAnnotations().add(annotationText);
        
        // Create PDFRenderer instance
        PDFRenderer renderer = new PDFRenderer(document);
        
        // Set annotation filter to include all annotations
        renderer.setAnnotationsFilter(annotation -> true);
        
        // Set default destination to ensure annotation processing
        renderer.setDefaultDestination(RenderDestination.VIEW);
        
        // Trigger the call chain that should eventually invoke Log.error()
        try {
            BufferedImage image = renderer.renderImageWithDPI(0, 72.0f);
        } catch (IOException e) {
            // Expected - the annotation processing will fail but Log.error() should be called
        }
        
        document.close();
    }
}

