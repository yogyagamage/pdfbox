        engine.addOperator(setFontAndSize);

        // Create a Type3 font and char proc to trigger the path
        PDType3Font type3Font = mock(PDType3Font.class);
        PDType3CharProc charProc = mock(PDType3CharProc.class);
        when(charProc.getMatrix()).thenReturn(new Matrix());
        when(type3Font.getCharProc(anyInt())).thenReturn(charProc);
        when(type3Font.isVertical()).thenReturn(false);
        when(type3Font.readCode(any(InputStream.class))).thenReturn(65); // 'A'
        when(type3Font.getDisplacement(anyInt())).thenReturn(new Vector(100, 0));
        when(type3Font.getPositionVector(anyInt())).thenReturn(new Vector(0, 0));

        // Set up graphics state with Type3 font
        PDGraphicsState graphicsState = engine.getGraphicsState();
        PDTextState textState = graphicsState.getTextState();
        textState.setFont(type3Font);
        textState.setFontSize(12);
        textState.setHorizontalScaling(100);
        textState.setCharacterSpacing(0);
        textState.setWordSpacing(0);
        textState.setRise(0);

        // Create operator and arguments that will trigger SetFontAndSize.process
