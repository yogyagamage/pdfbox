package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.io.RandomAccessRead;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;

class PDType0Font_PDCIDFontType2EmbedderbuildVerticalHeader_LogwarnFikaTest3 {

    @Test
    void testLoadTriggersLogWarn() throws IOException {
        // Create a minimal PDDocument mock
        PDDocument document = Mockito.mock(PDDocument.class);
        
        // Create a RandomAccessRead that will cause the font to have no 'vhea' table
        // We'll use a simple byte array that represents a minimal TTF without vertical header
        byte[] minimalTTF = createMinimalTTFWithoutVhea();
        RandomAccessRead randomAccessRead = new org.apache.pdfbox.io.RandomAccessReadBuffer(
            new ByteArrayInputStream(minimalTTF)
        );
        
        // Call the entry point method with vertical=true to trigger the vertical metrics path
        PDType0Font.load(document, randomAccessRead, false, true);
    }
    
    private byte[] createMinimalTTFWithoutVhea() {
        // Create a minimal TTF that will be parsed but won't have a vhea table
        // This is a simplified representation - in reality we'd need proper TTF structure
        // For testing purposes, we'll create a basic structure that PDFBox can parse
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        try (java.io.DataOutputStream dos = new java.io.DataOutputStream(baos)) {
            // TTF header
            dos.writeInt(0x00010000); // version 1.0
            dos.writeShort(1); // numTables
            
            // Table directory entry for required 'cmap' table only
            dos.writeInt(0x636D6170); // 'cmap' tag
            dos.writeInt(0); // checksum (simplified)
            dos.writeInt(64); // offset
            dos.writeInt(12); // length
            
            // Search range, entry selector, range shift
            dos.writeShort(16);
            dos.writeShort(4);
            dos.writeShort(0);
            
            // 'cmap' table
            dos.writeShort(0); // version
            dos.writeShort(1); // numTables
            
            // Encoding record
            dos.writeShort(0); // platformID (Unicode)
            dos.writeShort(3); // encodingID (UTF-16)
            dos.writeInt(12); // subtable offset
            
            // Format 4 subtable
            dos.writeShort(4); // format
            dos.writeShort(0); // length (will be calculated)
            dos.writeShort(0); // language
            dos.writeShort(256); // segCountX2
            dos.writeShort(2); // searchRange
            dos.writeShort(1); // entrySelector
            dos.writeShort(0); // rangeShift
            
            // Fill remaining space
            for (int i = 0; i < 100; i++) {
                dos.writeByte(0);
            }
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
        return baos.toByteArray();
    }
}

