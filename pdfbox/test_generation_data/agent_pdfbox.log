package org.apache.pdfbox.pdmodel.graphics.image;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.junit.jupiter.api.Test;
import java.io.IOException;

class PDImageXObject_PNGConverterbuildIndexImage_LogerrorFikaTest {

    @Test
    void testCreateFromByteArrayTriggersLogError() throws IOException {
        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // Create PNG data that will trigger the Log.error call in buildIndexImage
        // We need a PNG with indexed color type (3) but without PLTE chunk
        byte[] pngData = createIndexedPngWithoutPlte();
        
        // Call the entry point with null customFactory to follow the PNG path
        PDImageXObject.createFromByteArray(document, pngData, "test.png", null);
        
        document.close();
    }
    
    private byte[] createIndexedPngWithoutPlte() {
        // PNG signature
        byte[] pngSignature = new byte[] {
            (byte) 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
        };
        
        // IHDR chunk: width=1, height=1, bitDepth=8, colorType=3 (indexed),
        // compression=0, filter=0, interlace=0
        byte[] ihdrData = new byte[] {
            0x00, 0x00, 0x00, 0x0D, // Length: 13
            0x49, 0x48, 0x44, 0x52, // Type: IHDR
            0x00, 0x00, 0x00, 0x01, // Width: 1
            0x00, 0x00, 0x00, 0x01, // Height: 1
            0x08, // Bit depth: 8
            0x03, // Color type: 3 (indexed)
            0x00, // Compression: 0
            0x00, // Filter: 0
            0x00, // Interlace: 0
            (byte) 0xAE, 0x42, 0x60, (byte) 0x82 // CRC (pre-calculated for this data)
        };
        
        // IDAT chunk with minimal data (1 pixel)
        byte[] idatData = new byte[] {
            0x00, 0x00, 0x00, 0x05, // Length: 5
            0x49, 0x44, 0x41, 0x54, // Type: IDAT
            0x78, 0x01, // zlib header
            0x63, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, // compressed data
            (byte) 0x9D, (byte) 0x9B, (byte) 0xC2, 0x31 // CRC
        };
        
        // IEND chunk
        byte[] iendData = new byte[] {
            0x00, 0x00, 0x00, 0x00, // Length: 0
            0x49, 0x45, 0x4E, 0x44, // Type: IEND
            (byte) 0xAE, 0x42, 0x60, (byte) 0x82 // CRC
        };
        
        // Combine all chunks
        byte[] pngData = new byte[pngSignature.length + ihdrData.length + idatData.length + iendData.length];
        int offset = 0;
        
        System.arraycopy(pngSignature, 0, pngData, offset, pngSignature.length);
        offset += pngSignature.length;
        
        System.arraycopy(ihdrData, 0, pngData, offset, ihdrData.length);
        offset += ihdrData.length;
        
        System.arraycopy(idatData, 0, pngData, offset, idatData.length);
        offset += idatData.length;
        
        System.arraycopy(iendData, 0, pngData, offset, iendData.length);
        
        return pngData;
    }
}

