        // Length (1 - too short)
        iccpData[0] = 0; iccpData[1] = 0; iccpData[2] = 0; iccpData[3] = 1;
        // Chunk type "iCCP"
        System.arraycopy("iCCP".getBytes(), 0, iccpData, 4, 4);
