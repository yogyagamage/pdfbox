                PDStructureTreeRoot.class, 
                PDFCloneUtility.class
            );
            method.setAccessible(true);
            method.invoke(instance, srcStructTree, destStructTree, cloner);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }
}

