                    new byte[16], // id
                    6,        // encRevision = REVISION_6
                    32,       // keyLengthInBytes
                    true      // encryptMetadata
                );
            } catch (Exception e) {
                // Expected - GeneralSecurityException should be thrown
                // which triggers logIfStrongEncryptionMissing()
                // which calls LOG.warn()
            }
            
        } catch (NoSuchAlgorithmException e) {
            // This will also trigger the logIfStrongEncryptionMissing() method
            // through the catch block in computeHash2B
        }
    }
}

