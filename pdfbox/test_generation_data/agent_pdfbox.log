import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

class PageDrawer_PDCircleAppearanceHandlergenerateNormalAppearance_LogerrorFikaTest {

    @Test
    void testDrawPageTriggersLogError() throws Exception {
        // Create a real PDDocument and PDPage
        PDDocument document = new PDDocument();
        PDPage page = new PDPage();
        document.addPage(page);

        // Create a real PDFRenderer (needed for PageDrawer constructor)
        PDFRenderer renderer = new PDFRenderer(document);

        // Create PageDrawerParameters using reflection since constructor is package-private
        PageDrawerParameters parameters = mock(PageDrawerParameters.class);
        when(parameters.getPage()).thenReturn(page);
        when(parameters.getRenderer()).thenReturn(renderer);
        when(parameters.isSubsamplingAllowed()).thenReturn(false);
        when(parameters.getDestination()).thenReturn(null);
        when(parameters.getRenderingHints()).thenReturn(null);
        when(parameters.getImageDownscalingOptimizationThreshold()).thenReturn(0.0f);

        // Create a real PageDrawer instance
        PageDrawer pageDrawer = new PageDrawer(parameters);

        // Create a Graphics2D context (using a BufferedImage)
        BufferedImage image = new BufferedImage(100, 100, BufferedImage.TYPE_INT_ARGB);
        Graphics2D graphics = image.createGraphics();

        // Create a PDRectangle for page size
        PDRectangle pageSize = new PDRectangle(100, 100);

        // Create a PDAnnotationCircle that will trigger the error path
        PDAnnotationCircle annotation = new PDAnnotationCircle();
        annotation.setRectangle(new PDRectangle(10, 10, 50, 50));
        
        // Add the annotation to the page
        page.getAnnotations().add(annotation);

        // Create a PDAnnotationFileAttachment to set up the appearance handler chain
        PDAnnotationFileAttachment fileAttachment = new PDAnnotationFileAttachment();
        
        // Use reflection to set the customAppearanceHandler to a PDCircleAppearanceHandler
        // that will throw an IOException in generateNormalAppearance()
        PDCircleAppearanceHandler circleHandler = new PDCircleAppearanceHandler(annotation, document) {
            @Override
            public void generateNormalAppearance() {
                // This will trigger the LOG.error() call in the original method
                throw new RuntimeException(new IOException("Test exception to trigger Log.error()"));
            }
        };
        
        // Set the customAppearanceHandler on the file attachment
        Field customHandlerField = PDAnnotationFileAttachment.class.getDeclaredField("customAppearanceHandler");
        customHandlerField.setAccessible(true);
        customHandlerField.set(fileAttachment, circleHandler);

        // Add the file attachment annotation to the page
        page.getAnnotations().add(fileAttachment);

        // Call the entry point method - this should traverse the call chain
        // and eventually trigger the Log.error() call
        pageDrawer.drawPage(graphics, pageSize);

        // Clean up
        graphics.dispose();
        document.close();
    }
}

