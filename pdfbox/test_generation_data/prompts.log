 */
(PDShadingType5 shading, ColorModel cm, AffineTransform xform, Matrix matrix, Rectangle deviceBounds) throws IOException {
    this(shading, cm, xform, matrix);
    LOG.debug("Type5ShadingContext");
    // PATH: Test should invoke the next PDShadingType5.collectTriangles(...) [step in execution path]
