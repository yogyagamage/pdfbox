protected COSName parseCOSName() throws IOException {
    readExpectedChar('/');
    ByteArrayOutputStream buffer = new ByteArrayOutputStream();
    int c = source.read();
    while (!isEndOfName(c)) {
        final int ch = c;
        if (ch == '#') {
            int ch1 = source.read();
            int ch2 = source.read();
