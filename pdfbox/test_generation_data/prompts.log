/**
 * Reads the visual signature from the given file.
 *
 * @param file
 * 		the file containing the visual signature
 * @throws IOException
 * 		when something went wrong during parsing
 */
public void setVisualSignature(File file) throws IOException // PATH: Test should invoke the next SignatureOptions.initFromRandomAccessRead(...) [step in execution path]
{
    initFromRandomAccessRead(new RandomAccessReadBufferedFile(file));
}

private void initFromRandomAccessRead(RandomAccessRead rar) throws IOException {
    pdfSource = rar;
    PDFParser parser = new PDFParser(pdfSource);
    visualSignature = parser.parse().getDocument();
}

