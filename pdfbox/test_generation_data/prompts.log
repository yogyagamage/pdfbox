 */
public static PDDocument loadPDF(RandomAccessRead randomAccessRead, String password, InputStream keyStore, String alias, StreamCacheCreateFunction streamCacheCreateFunction) throws IOException {
    PDFParser parser = new PDFParser(randomAccessRead, password, keyStore, alias, streamCacheCreateFunction);
    // PATH: Test should invoke the next PDFParser.parse(...) [step in execution path]
    return parser.parse();
}

/**
