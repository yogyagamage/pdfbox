/**
 * This will set an item in the dictionary. If value is null then the result will be the same as removeItem( key ).
 *
 * @param key
 * 		The key to the dictionary object.
 * @param value
 * 		The value to the dictionary object.
 */
public void setItem(COSName key, COSBase value) {
    if (value == null) {
        removeItem(key);
    } else // wrap indirect objects
    if ((((value instanceof COSDictionary) || (value instanceof COSArray)) && (!value.isDirect())) && (value.getKey() != null)) {
        COSObject cosObject = new COSObject(value, value.getKey());
        items.put(key, cosObject);
        getUpdateState().update(cosObject);
    } else {
        items.put(key, value);
        getUpdateState().update(value);
    }
}

