    String imgFormContent = ((((("q " + width) + " 0 0 ") + height) + " 0 0 cm /") + imageName.getName()) + " Do Q
";
    String holderFormContent = ("q 1 0 0 1 0 0 cm /" + innerFormName.getName()) + " Do Q
";
