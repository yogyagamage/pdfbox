        if (i >= byteRangeBytes.length) {
            incrementPart[((int) ((byteRangeOffset + i) - inLength))] = 0x20;// SPACE

        } else {
            incrementPart[((int) ((byteRangeOffset + i) - inLength))] = byteRangeBytes[i];
