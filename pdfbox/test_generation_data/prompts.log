                c = ch1;
                buffer.write(ch);
            }
        } else {
            buffer.write(ch);
            c = source.read();
        }
    } 
    if (c != (-1)) {
        source.rewind(1);
    }
    return COSName.getPDFName(decodeBuffer(buffer));
}

