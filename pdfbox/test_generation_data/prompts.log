    // flip y-axis
    g.translate(0, image.getHeight());
    g.scale(1, -1);
    boolean savedFlipTG = flipTG;
    flipTG = false;
    // apply device transform (DPI)
    // the initial translation is ignored, because we're not writing into the initial graphics device
    g.transform(xform);
