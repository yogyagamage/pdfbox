@Override
public void createAcroFormDictionary(PDAcroForm acroForm, PDSignatureField signatureField) throws IOException // PATH: Test should invoke the next Log.info(...) [step in execution path]
{
    @SuppressWarnings("unchecked")
    List<PDField> acroFormFields = acroForm.getFields();
    COSDictionary acroFormDict = acroForm.getCOSObject();
    acroForm.setSignaturesExist(true);
    acroForm.setAppendOnly(true);
    acroFormDict.setDirect(true);
    acroFormFields.add(signatureField);
    // WTF sylfaen?
    acroForm.setDefaultAppearance("/sylfaen 0 Tf 0 g");
    pdfStructure.setAcroFormFields(acroFormFields);
    pdfStructure.setAcroFormDictionary(acroFormDict);
    LOG.info("AcroForm dictionary has been created");
}

