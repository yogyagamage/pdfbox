 * @param displacement
 * 		the displacement (i.e. advance) of the glyph in text space
 * @throws IOException
 * 		if the glyph cannot be processed
 */
protected void showGlyph(Matrix textRenderingMatrix, PDFont font, int code, Vector displacement) throws IOException {
