        } else if (diacXStart < currCharXStart) {
            insertDiacritic(i, diacritic);
            wasAdded = true;
        } else if (diacXEnd <= currCharXEnd) {
            insertDiacritic(i, diacritic);
            wasAdded = true;
        } else if (i == (strLen - 1)) {
