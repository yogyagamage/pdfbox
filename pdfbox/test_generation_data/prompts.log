 * @param encRevision
 * 		The revision of the encryption algorithm.
 * @param keyLengthInBytes
 * 		The length of the encryption key in bytes.
 * @param encryptMetadata
 * 		The encryption metadata
 * @param isOwnerPassword
 * 		whether the password given is the owner password (for revision 6)
 * @return The encrypted key bytes.
 * @throws IOException
 * 		If there is an error with encryption.
 */
public byte[] computeEncryptedKey(byte[] password, byte[] o, byte[] u, byte[] oe, byte[] ue, int permissions, byte[] id, int encRevision, int keyLengthInBytes, boolean encryptMetadata, boolean isOwnerPassword) throws IOException {
    if ((encRevision == REVISION_5) || (encRevision == REVISION_6)) {
        // PATH: Test should invoke the next StandardSecurityHandler.computeEncryptedKeyRev56(...) [step in execution path]
        return computeEncryptedKeyRev56(password, isOwnerPassword, o, u, oe, ue, encRevision);
    } else {
