 * @throws IOException
 * 		If there is an error reading the font stream.
 */
public static PDType0Font load(PDDocument doc, TrueTypeFont ttf, boolean embedSubset) throws IOException {
    return new PDType0Font(doc, ttf, embedSubset, false, false);
}

