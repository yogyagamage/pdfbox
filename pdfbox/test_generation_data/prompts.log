public boolean contains(COSBase object) {
    return ((object instanceof COSObject) && // PATH: Test should invoke the next COSObject.getObject(...) [step in execution path]
    objectPool.containsKey(((COSObject) (object)).getObject())) || objectPool.containsKey(object);
