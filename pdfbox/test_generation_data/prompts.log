            }
            int pos = 0;
            for (int i = 0; i < 64; i++) {
                System.arraycopy(password, 0, k1, pos, password.length);
                pos += password.length;
                System.arraycopy(k, 0, k1, pos, k.length);
                pos += k.length;
                if ((userKey != null) && (userKey.length >= 48)) {
