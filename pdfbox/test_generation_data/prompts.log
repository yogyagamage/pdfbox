        // when width is very small, the border of the line ending shapes
        // is not drawn.
        if (ab.width < 1.0E-5) {
            hasStroke = false;
        }
        // check for LE_NONE only needed to avoid q cm Q for that case
        if (!LE_NONE.equals(annotation.getStartPointEndingStyle())) {
            cs.saveGraphicsState();
