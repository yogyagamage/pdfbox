private List<FSFontInfo> loadDiskCache(List<File> files) {
    Set<String> pending = new HashSet<>(files.size());
    for (File file : files) {
        pending.add(file.getAbsolutePath());
    }
    List<FSFontInfo> results = new ArrayList<>();
