/**
 * This will load a document from an input stream. The stream is loaded to the memory to establish random access to
 * the data.
 *
 * @param input
 * 		The stream that contains the document.
 * @return The document that was loaded.
 * @throws IOException
 * 		If there is an error reading from the stream.
 */
public static FDFDocument loadXFDF(InputStream input) throws IOException {
    return new FDFDocument(XMLUtil.parse(input));
}

/**
 * Constructor that uses an existing document. The COSDocument that is passed in must be valid.
 *
 * @param doc
 * 		The COSDocument that this document wraps.
 * @deprecated Use {@link #FDFDocument(COSDocument, RandomAccessRead)}
 */
@Deprecated
public FDFDocument(COSDocument doc) {
    this(doc, null);
}

/**
 * Constructor.
