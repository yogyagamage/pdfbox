protected void showGlyph(Matrix textRenderingMatrix, PDFont font, int code, Vector displacement) throws IOException {
    if (font instanceof PDType3Font) // PATH: Test should invoke the next PDFStreamEngine.showType3Glyph(...) [step in execution path]
    {
