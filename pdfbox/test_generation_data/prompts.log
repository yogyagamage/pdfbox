 * @throws IOException
 * 		id the PageDrawer instance could not be created
 */
protected PageDrawer createPageDrawer(PageDrawerParameters parameters) throws IOException // PATH: Test should invoke the next new PageDrawer(...) [step in execution path]
{
    PageDrawer pageDrawer = new PageDrawer(parameters);
    pageDrawer.setAnnotationFilter(annotationFilter);
    return pageDrawer;
}

