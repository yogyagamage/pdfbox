/**
 * Constructor for reading a Type0 font from a PDF file.
 *
 * @param fontDictionary
 * 		The font dictionary according to the PDF specification.
 * @throws IOException
 * 		if the descendant font is missing.
 */
public (COSDictionary fontDictionary) throws IOException // PATH: Test should invoke the next PDType0Font.readEncoding(...) [step in execution path]
{
    this(fontDictionary);
    gsubData = GsubData.NO_DATA_FOUND;
    cmapLookup = null;
    COSArray descendantFonts = dict.getCOSArray(COSName.DESCENDANT_FONTS);
    if (descendantFonts == null) {
        throw new IOException("Missing descendant font array");
    }
    if (descendantFonts.size() == 0) {
        throw new IOException("Descendant font array is empty");
    }
    COSBase descendantFontDictBase = descendantFonts.getObject(0);
    if (!(descendantFontDictBase instanceof COSDictionary)) {
        throw new IOException("Missing descendant font dictionary");
    }
    if (!COSName.FONT.equals(((COSDictionary) (descendantFontDictBase)).getCOSName(COSName.TYPE, COSName.FONT))) {
        throw new IOException("Missing or wrong type in descendant font dictionary");
    }
    descendantFont = PDFontFactory.createDescendantFont(((COSDictionary) (descendantFontDictBase)), this);
    readEncoding();
    fetchCMapUCS2();
}

/**
 * Reads the font's Encoding entry, which should be a CMap name/stream.
 */
private void readEncoding() throws IOException {
    COSBase encoding = dict.getDictionaryObject(COSName.ENCODING);
    if (encoding instanceof COSName) {
        // predefined CMap
        COSName encodingName = ((COSName) (encoding));
        cMap = CMapManager.getPredefinedCMap(encodingName.getName());
        isCMapPredefined = true;
    } else if (encoding != null) {
        cMap = readCMap(encoding);
        if (cMap == null) {
            throw new IOException("Missing required CMap");
        } else if (!cMap.hasCIDMappings()) // PATH: Test should invoke the next Log.warn(...) [step in execution path]
        {
            LOG.warn("Invalid Encoding CMap in font " + getName());
        }
    }
    // check if the descendant font is CJK
    PDCIDSystemInfo ros = descendantFont.getCIDSystemInfo();
    if (ros != null) {
        String ordering = ros.getOrdering();
        isDescendantCJK = "Adobe".equals(ros.getRegistry()) && ((("GB1".equals(ordering) || "CNS1".equals(ordering)) || "Japan1".equals(ordering)) || "Korea1".equals(ordering));
    }
}

