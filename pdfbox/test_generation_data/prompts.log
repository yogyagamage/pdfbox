    final COSArray cosDecode = pdImage.getDecode();
    float[] decode = null;
    if (cosDecode != null) {
        int numberOfComponents = pdImage.getColorSpace().getNumberOfComponents();
        if (cosDecode.size() != (numberOfComponents * 2)) // PATH: Test should invoke the next Log.error(...) [step in execution path]
        {
            if (((pdImage.isStencil() && (cosDecode.size() >= 2)) && (cosDecode.get(0) instanceof COSNumber)) && (cosDecode.get(1) instanceof COSNumber)) {
