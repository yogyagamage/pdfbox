private void fallbackToAlternateColorSpace(Exception e) throws IOException {
    awtColorSpace = null;
    alternateColorSpace = getAlternateColorSpace();
    if (alternateColorSpace.equals(PDDeviceRGB.INSTANCE)) {
        isRGB = true;
    }
