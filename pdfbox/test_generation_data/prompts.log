        if ((!(annotation instanceof PDAnnotationUnknown)) || COSName.ANNOT.equals(objDictionary.getCOSName(COSName.TYPE))) {
            return annotation;
        }
    } catch (IOException exception) // PATH: Test should invoke the next Log.debug(...) [step in execution path]
    {
        LOG.debug("Couldn't get the referenced object - returning null instead", exception);
        // this can only happen if the target is an XObject.
    }
    return null;
}

