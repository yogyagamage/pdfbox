            PDShadingType5 shading = new PDShadingType5(document);
            shading.setShadingType(ShadingType.FREE_FORM_GOURAUD_SHADED_TRIANGLE_MESH);
            shading.setColorSpace(PDShadingType5.DEVICE_RGB);
            shading.setBitsPerCoordinate(8);
            shading.setBitsPerComponent(8);
            shading.setBitsPerFlag(8);
            shading.setDecode(new float[]{0, 1, 0, 1, 0, 1});
            
            float[] vertices = {
