    private static class TestCertificateFactory {
        static X509Certificate createTestCertificate() throws Exception {
            // Generate a minimal self-signed certificate for testing
            java.security.KeyPairGenerator keyGen = java.security.KeyPairGenerator.getInstance("RSA");
            keyGen.initialize(512);
            java.security.KeyPair keyPair = keyGen.generateKeyPair();
            
            java.security.cert.CertificateFactory certFactory = 
                java.security.cert.CertificateFactory.getInstance("X.509");
            
            // Create a simple self-signed certificate
            java.math.BigInteger serial = java.math.BigInteger.ONE;
            java.security.Principal issuer = new javax.security.auth.x500.X500Principal("CN=Test");
            java.security.Principal subject = new javax.security.auth.x500.X500Principal("CN=Test");
            java.util.Date notBefore = new java.util.Date();
            java.util.Date notAfter = new java.util.Date(System.currentTimeMillis() + 86400000);
            
            java.security.cert.X509Certificate cert = (java.security.cert.X509Certificate)
                java.security.cert.CertificateFactory.getInstance("X.509")
                    .generateCertificate(new java.io.ByteArrayInputStream(
                        generateSelfSignedCert(keyPair, "SHA256withRSA", issuer, subject, 
                            serial, notBefore, notAfter)));
            
            return cert;
        }
        
        private static byte[] generateSelfSignedCert(
                java.security.KeyPair keyPair,
                String signatureAlgorithm,
                java.security.Principal issuer,
                java.security.Principal subject,
                java.math.BigInteger serial,
                java.util.Date notBefore,
                java.util.Date notAfter) throws Exception {
            
            javax.security.auth.x500.X500Name issuerName = new javax.security.auth.x500.X500Name(issuer.getName());
            javax.security.auth.x500.X500Name subjectName = new javax.security.auth.x500.X500Name(subject.getName());
            
            org.bouncycastle.asn1.x509.V3TBSCertificateGenerator certGen = new org.bouncycastle.asn1.x509.V3TBSCertificateGenerator();
            certGen.setSerialNumber(new org.bouncycastle.asn1.ASN1Integer(serial));
            certGen.setIssuer(issuerName);
            certGen.setSubject(subjectName);
            certGen.setStartDate(new org.bouncycastle.asn1.ASN1GeneralizedTime(notBefore));
            certGen.setEndDate(new org.bouncycastle.asn1.ASN1GeneralizedTime(notAfter));
            certGen.setSignature(new org.bouncycastle.asn1.x509.AlgorithmIdentifier(
                org.bouncycastle.asn1.pkcs.PKCSObjectIdentifiers.sha256WithRSAEncryption));
            
            org.bouncycastle.asn1.x509.SubjectPublicKeyInfo keyInfo = 
                org.bouncycastle.asn1.x509.SubjectPublicKeyInfo.getInstance(
                    org.bouncycastle.asn1.ASN1Primitive.fromByteArray(keyPair.getPublic().getEncoded()));
            certGen.setSubjectPublicKeyInfo(keyInfo);
            
            org.bouncycastle.asn1.x509.TBSCertificate tbsCert = certGen.generateTBSCertificate();
            
            java.security.Signature signature = java.security.Signature.getInstance(signatureAlgorithm);
            signature.initSign(keyPair.getPrivate());
            signature.update(tbsCert.getEncoded());
            byte[] sigBytes = signature.sign();
            
            org.bouncycastle.asn1.ASN1EncodableVector v = new org.bouncycastle.asn1.ASN1EncodableVector();
            v.add(tbsCert);
            v.add(new org.bouncycastle.asn1.x509.AlgorithmIdentifier(
                org.bouncycastle.asn1.pkcs.PKCSObjectIdentifiers.sha256WithRSAEncryption));
            v.add(new org.bouncycastle.asn1.DERBitString(sigBytes));
            
            return new org.bouncycastle.asn1.DERSequence(v).getEncoded();
        }
