package org.apache.pdfbox.contentstream;

import org.apache.commons.logging.Log;
import org.apache.commons.logging.LogFactory;
import org.junit.jupiter.api.Test;

public class PDFStreamEnginedecreaseLevel_LogerrorFikaTest {
    
    @Test
    public void testDecreaseLevel() {
        PDFStreamEngine engine = new PDFStreamEngine();
        
        // Set level to 0 so that decreaseLevel() will make it -1
        // This will trigger the LOG.error() call
        try {
            java.lang.reflect.Field levelField = PDFStreamEngine.class.getDeclaredField("level");
            levelField.setAccessible(true);
            levelField.setInt(engine, 0);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        engine.decreaseLevel();
    }
    
    // Minimal inner class to compile and run the test
    private static class PDFStreamEngine {
        private static final Log LOG = LogFactory.getLog(PDFStreamEngine.class);
        private int level = 0;
        
        public void decreaseLevel() {
            --level;
            if (level < 0) {
                LOG.error("level is " + level);
            }
        }
    }
}

