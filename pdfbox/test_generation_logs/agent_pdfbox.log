import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;

public class PDDocumentimportPage_LogwarnFikaTest {

    @Test
    public void testImportPageTriggersLogWarn() throws IOException {
        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // Create a mock PDPage with resources but no COS RESOURCES entry
        PDPage sourcePage = Mockito.mock(PDPage.class);
        COSDictionary cosDict = new COSDictionary();
        Mockito.when(sourcePage.getCOSObject()).thenReturn(cosDict);
        Mockito.when(sourcePage.getResources()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.PDResources.class));
        Mockito.when(sourcePage.getContents()).thenReturn(Mockito.mock(org.apache.pdfbox.pdmodel.PDStream.class));
        
        // Setup crop box and media box
        PDRectangle cropBox = new PDRectangle(100, 100);
        PDRectangle mediaBox = new PDRectangle(200, 200);
        Mockito.when(sourcePage.getCropBox()).thenReturn(cropBox);
        Mockito.when(sourcePage.getMediaBox()).thenReturn(mediaBox);
        Mockito.when(sourcePage.getRotation()).thenReturn(0);
        
        // Execute the method - this should trigger the Log.warn() call
        document.importPage(sourcePage);
        
        // Cleanup
        document.close();
    }
}

