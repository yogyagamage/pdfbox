class PDVisibleSigBuildercreateAppearanceDictionary_LoginfoFikaTest {

    @Test
    void testCreateAppearanceDictionary() throws IOException {
        // Create real PDDocument
        PDDocument document = new PDDocument();
        
        // Create real COSStream for holder form
