package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.font.encoding.Encoding;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

public class PDType1Font_PDSimpleFontreadEncoding_LogwarnFikaTest {

    @Test
    public void testReadEncodingTriggersLogWarn() throws IOException {
        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage();
            document.addPage(page);
            
            ByteArrayOutputStream baos = new ByteArrayOutputStream();
            try (PDPageContentStream contentStream = new PDPageContentStream(document, page, baos, null)) {
                contentStream.beginText();
                contentStream.setFont(PDType1Font.HELVETICA, 12);
                contentStream.newLineAtOffset(100, 700);
                contentStream.showText("Test");
                contentStream.endText();
            }
            
            // Create a font with a custom encoding that will trigger the warning
            PDType1Font font = PDType1Font.HELVETICA;
            COSDictionary fontDict = new COSDictionary();
            fontDict.setItem(COSName.ENCODING, COSName.getPDFName("UnknownEncoding123"));
            
            // Use reflection to access protected method
            java.lang.reflect.Method readEncodingMethod = 
                PDType1Font.class.getSuperclass().getDeclaredMethod("readEncoding");
            readEncodingMethod.setAccessible(true);
            
            // Temporarily replace the dictionary to trigger the warning path
            COSDictionary originalDict = font.getCOSObject();
            try {
                java.lang.reflect.Field dictField = 
                    font.getClass().getSuperclass().getDeclaredField("dict");
                dictField.setAccessible(true);
                dictField.set(font, fontDict);
                
                readEncodingMethod.invoke(font);
            } finally {
                // Restore original dictionary
                java.lang.reflect.Field dictField = 
                    font.getClass().getSuperclass().getDeclaredField("dict");
                dictField.setAccessible(true);
                dictField.set(font, originalDict);
            }
        }
    }
}

