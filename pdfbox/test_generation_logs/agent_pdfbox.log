package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.font.PDType1Font;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;
import java.io.IOException;

class PDType1FontrepairLength1_LogwarnFikaTest {

    @Test
    void testRepairLength1TriggersLogWarn() throws Exception {
        byte[] fontData = createType1FontWithInvalidLength1();
        PDType1Font font = createType1Font(fontData);
        
        // Use reflection to access private method
        java.lang.reflect.Method method = PDType1Font.class.getDeclaredMethod(
            "repairLength1", byte[].class, int.class);
        method.setAccessible(true);
        
        // Call with length1 that will trigger the warning path
        method.invoke(font, fontData, 100);
    }
    
    private byte[] createType1FontWithInvalidLength1() {
        // Create minimal Type 1 font data that will trigger the warning path
        // The data needs to have 'exec' somewhere after offset 0
        String type1Data = "%!PS-AdobeFont-1.0\n" +
                          "/FontName /TestFont def\n" +
                          "currentdict end\n" +
                          "exec\n" +  // This will be found by findBinaryOffsetAfterExec
                          "binary data here";
        return type1Data.getBytes();
    }
    
    private PDType1Font createType1Font(byte[] fontData) throws IOException {
        // Create a real PDType1Font using the embedded standard 14 font
        // We'll use Helvetica and modify it to accept our test data
        try (PDDocument doc = new PDDocument()) {
            PDType1Font font = PDType1Font.HELVETICA;
            
            // Use reflection to set the font data for testing
            java.lang.reflect.Field field = PDType1Font.class.getDeclaredField("fontData");
            field.setAccessible(true);
            field.set(font, fontData);
            
            return font;
        }
    }
}

