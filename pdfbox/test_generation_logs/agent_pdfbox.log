        // Create a minimal PDF file with a cross-reference stream that has an incorrect offset
        File pdfFile = new File(tempDir, "test.pdf");
        try (OutputStream os = new FileOutputStream(pdfFile)) {
            // PDF header
            os.write("%PDF-1.4\n".getBytes());
            // Some content to reach startxref
            os.write("1 0 obj\n<<>>\nendobj\n".getBytes());
            // xref table with incorrect /XRefStm offset
            os.write("xref\n0 2\n0000000000 65535 f \n0000000018 00000 n \n".getBytes());
            // Trailer with /Prev and incorrect /XRefStm
            os.write("trailer\n<< /Size 2 /Prev 0 /XRefStm 999999 >>\n".getBytes());
            // startxref pointing to xref table
            os.write("startxref\n55\n%%EOF\n".getBytes());
        }

        // Create parser with lenient mode to allow correction
        COSParser parser = new COSParser(pdfFile);
        
        // Use reflection to access private parseXref method
        try {
            java.lang.reflect.Method parseXrefMethod = COSParser.class.getDeclaredMethod(
                "parseXref", long.class);
            parseXrefMethod.setAccessible(true);
            
            // Parse from the xref table offset (55)
            COSDictionary result = (COSDictionary) parseXrefMethod.invoke(parser, 55L);
            
        } catch (Exception e) {
            // Ignore exceptions - we only care about reaching the Log.warn call
        }
    }
}

