private void initVertices(Element element) throws IOException {
    XPath xpath = XPathFactory.newInstance().newXPath();
    try {
        String vertices = xpath.evaluate("vertices", element);
        if ((vertices == null) || vertices.isEmpty()) {
            throw new IOException("Error: missing element 'vertices'");
        }
        String[] verticesValues = vertices.split(",|;");
        float[] values = parseFloats(verticesValues);
        setVertices(values);
    } catch (XPathExpressionException e) // PATH: Test should invoke the next Log.debug(...) [step in execution path]
