            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);
            
            // Create a form XObject (required for TilingPaintFactory)
            PDFormXObject form = new PDFormXObject(document);
            form.setBBox(new PDRectangle(100, 100));
            
            // Create content stream for the form
            try (PDPageContentStream cs = new PDPageContentStream(document, form)) {
                cs.setNonStrokingColor(0, 0, 0);
                cs.addRect(0, 0, 100, 100);
                cs.fill();
            }
            
            // Create transformation matrix
            Matrix matrix = Matrix.getTranslateInstance(0, 0);
            
            // Create source rectangle
