    void testPrepareForDecryption_TriggersLogWarn() throws IOException {
        // Create encryption with version 4 or 5 and AESV2 crypt filter
        PDEncryption encryption = new PDEncryption();
        
        // Set version to 4 (REVISION_4)
        encryption.setVersion(4);
        
        // Create and configure crypt filter dictionary
        PDCryptFilterDictionary cryptFilterDict = new PDCryptFilterDictionary();
