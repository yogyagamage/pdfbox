    void testParseXrefInvokesLogError(@TempDir Path tempDir) throws IOException {
        File pdfFile = tempDir.resolve("test.pdf").toFile();
        createMinimalPDF(pdfFile);
        
        try (java.io.RandomAccessFile raf = new java.io.RandomAccessFile(pdfFile, "r")) {
            COSParser parser = new COSParser(raf);
            
            java.lang.reflect.Method parseXrefMethod = COSParser.class.getDeclaredMethod(
