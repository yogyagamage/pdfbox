package org.apache.pdfbox.pdfparser;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.pdfparser.BaseParser;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.InputStream;

import static org.mockito.Mockito.CALLS_REAL_METHODS;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.withSettings;

class PDFParser_BaseParserparseCOSDictionary_LogwarnFikaTest {

    @Test
    void testParseCOSDictionaryTriggersLogWarn() throws IOException {
        // Create a real BaseParser instance with mocked dependencies
        BaseParser parser = mock(BaseParser.class, withSettings()
                .useConstructor()
                .defaultAnswer(CALLS_REAL_METHODS));

        // Setup input stream with invalid dictionary content that will trigger the warning
        // The content: << a >> (missing '/' before 'a')
        String invalidDict = "<< a >>";
        InputStream inputStream = new ByteArrayInputStream(invalidDict.getBytes());
        
        // Use reflection to set the required protected field
        try {
            java.lang.reflect.Field sourceField = BaseParser.class.getDeclaredField("source");
            sourceField.setAccessible(true);
            
            // Create a real RandomAccessSource
            Object randomAccessSource = createRandomAccessSource(inputStream);
            sourceField.set(parser, randomAccessSource);
            
            // Set recursion depth to avoid recursion exception
            java.lang.reflect.Field recursionDepthField = BaseParser.class.getDeclaredField("recursionDepth");
            recursionDepthField.setAccessible(true);
            recursionDepthField.set(parser, 0);
            
            // Set LOG field to ensure it exists (it will be inherited)
            java.lang.reflect.Field logField = BaseParser.class.getDeclaredField("LOG");
            logField.setAccessible(true);
            
        } catch (Exception e) {
            throw new RuntimeException("Failed to setup test via reflection", e);
        }

        // Execute the method - this should trigger LOG.warn when encountering 'a' instead of '/'
        parser.parseCOSDictionary(false);
    }

    private Object createRandomAccessSource(InputStream inputStream) throws Exception {
        // Create a real RandomAccessSource implementation
        Class<?> randomAccessSourceClass = Class.forName("org.apache.pdfbox.io.RandomAccessRead");
        Class<?> randomAccessBufferClass = Class.forName("org.apache.pdfbox.io.RandomAccessReadBuffer");
        
        // Convert InputStream to byte array
        byte[] data = inputStream.readAllBytes();
        
        // Create RandomAccessReadBuffer instance
        return randomAccessBufferClass.getConstructor(byte[].class).newInstance((Object) data);
    }
}

