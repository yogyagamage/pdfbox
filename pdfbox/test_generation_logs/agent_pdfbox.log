/**
 * This will retrieve the markup annotation which this popup relates to.
 *
 * @return The parent markup annotation.
 */
public PDAnnotationMarkup getParent() {
    try {
        PDAnnotation ann = PDAnnotation.createAnnotation(getCOSObject().getDictionaryObject(COSName.PARENT, COSName.P));
        if (!(ann instanceof PDAnnotationMarkup)) {
            LOG.error(("parent annotation is of type " + ann.getClass().getSimpleName()) + " but should be of type PDAnnotationMarkup");
