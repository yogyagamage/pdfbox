            linkAnnotation.setRectangle(new PDRectangle(100, 100, 200, 50));
            
            PDLinkAppearanceHandler handler = new PDLinkAppearanceHandler(linkAnnotation, document);
            handler.generateAppearanceStreams();
        }
    }
