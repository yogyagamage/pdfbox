package org.apache.pdfbox.pdmodel.interactive.annotation.handlers;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationText;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAppearanceStream;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;
import java.lang.reflect.Field;
import java.util.HashSet;
import java.util.Set;

class PDTextAppearanceHandlergenerateNormalAppearance_LogerrorFikaTest {

    @Test
    void testGenerateNormalAppearance() throws Exception {
        // Create real objects
        PDDocument document = new PDDocument();
        PDPage page = new PDPage();
        document.addPage(page);
        
        // Create annotation with supported name
        PDAnnotationText annotation = new PDAnnotationText();
        annotation.setName(PDAnnotationText.NAME_NOTE);
        
        // Create handler instance
        PDTextAppearanceHandler handler = new PDTextAppearanceHandler();
        
        // Use reflection to set required fields
        setAnnotationField(handler, annotation);
        setPageField(handler, page);
        
        // Create a mock PDAppearanceStream that will throw IOException
        PDAppearanceStream appearanceStream = Mockito.mock(PDAppearanceStream.class);
        Mockito.when(appearanceStream.createContentStream()).thenThrow(new IOException("Test exception"));
        
        // Set the appearance stream field
        setAppearanceStreamField(handler, appearanceStream);
        
        // Set SUPPORTED_NAMES to include our annotation name
        setSupportedNamesField(annotation.getName());
        
        // This should trigger the IOException and call LOG.error(e)
        handler.generateNormalAppearance();
        
        document.close();
    }
    
    private void setAnnotationField(PDTextAppearanceHandler handler, PDAnnotationText annotation) throws Exception {
        Field annotationField = PDTextAppearanceHandler.class.getDeclaredField("annotation");
        annotationField.setAccessible(true);
        annotationField.set(handler, annotation);
    }
    
    private void setPageField(PDTextAppearanceHandler handler, PDPage page) throws Exception {
        Field pageField = PDTextAppearanceHandler.class.getDeclaredField("page");
        pageField.setAccessible(true);
        pageField.set(handler, page);
    }
    
    private void setAppearanceStreamField(PDTextAppearanceHandler handler, PDAppearanceStream appearanceStream) throws Exception {
        Field appearanceField = PDTextAppearanceHandler.class.getDeclaredField("appearance");
        appearanceField.setAccessible(true);
        appearanceField.set(handler, appearanceStream);
    }
    
    private void setSupportedNamesField(String annotationName) throws Exception {
        Field supportedNamesField = PDTextAppearanceHandler.class.getDeclaredField("SUPPORTED_NAMES");
        supportedNamesField.setAccessible(true);
        
        @SuppressWarnings("unchecked")
        Set<String> supportedNames = (Set<String>) supportedNamesField.get(null);
        if (supportedNames == null) {
            supportedNames = new HashSet<>();
        }
        supportedNames.add(annotationName);
        supportedNamesField.set(null, supportedNames);
    }
}

