public List<PDNameTreeNode<T>> getKids() {
    List<PDNameTreeNode<T>> retval = null;
    COSArray kids = node.getCOSArray(COSName.KIDS);
    if (kids != null) {
        List<PDNameTreeNode<T>> pdObjects = new ArrayList<>(kids.size());
        for (int i = 0; i < kids.size(); i++) {
