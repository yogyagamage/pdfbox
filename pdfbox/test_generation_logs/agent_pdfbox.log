package org.apache.pdfbox.pdfparser;

import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.pdfparser.COSParser;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.file.Path;

public class FDFParser_COSParserparseXref_LogerrorFikaTest {

    @TempDir
    private Path tempDir;

    @Test
    public void testParseXrefInvokesLogError() throws IOException {
        // Create a minimal PDF file with a hybrid xref that will trigger the error path
        File pdfFile = tempDir.resolve("test.pdf").toFile();
        
        try (OutputStream os = new FileOutputStream(pdfFile)) {
            // PDF header
            os.write("%PDF-1.4\n".getBytes());
            
            // Create a minimal PDF with xref table and invalid /XRefStm offset
            // This will cause parseXrefObjStream to throw IOException when isLenient=true
            
            // Write some objects
            os.write("1 0 obj\n".getBytes());
            os.write("<< /Type /Catalog /Pages 2 0 R >>\n".getBytes());
            os.write("endobj\n".getBytes());
            
            os.write("2 0 obj\n".getBytes());
            os.write("<< /Type /Pages /Kids [] /Count 0 >>\n".getBytes());
            os.write("endobj\n".getBytes());
            
            // Write xref table
            os.write("xref\n".getBytes());
            os.write("0 3\n".getBytes());
            os.write("0000000000 65535 f \n".getBytes());
            os.write("0000000010 00000 n \n".getBytes());
            os.write("0000000050 00000 n \n".getBytes());
            
            // Write trailer with /XRefStm pointing to invalid offset
            os.write("trailer\n".getBytes());
            os.write("<< /Size 3 /Root 1 0 R /XRefStm 99999 >>\n".getBytes()); // Invalid offset
            os.write("startxref\n".getBytes());
            os.write("100\n".getBytes()); // startxref offset
            os.write("%%EOF\n".getBytes());
        }
        
        // Create parser with lenient mode enabled
        COSParser parser = new COSParser(pdfFile);
        parser.setLenient(true);
        
        try {
            // This should trigger the LOG.error call when parseXrefObjStream fails
            // with IOException and isLenient=true
            COSDictionary trailer = parser.parseXref(100);
        } catch (Exception e) {
            // We don't care about exceptions, just need to reach the Log.error call
        }
    }
}

