package org.apache.pdfbox.pdmodel.graphics.image;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject;
import java.awt.image.BufferedImage;
import java.io.ByteArrayInputStream;
import java.io.IOException;

class PDImageXObject_SampledImageReadermethod_LogFactorygetLogFikaTest2 {

    @Test
    void testSampledImageReaderStaticInitialization() throws IOException {
        // Create a minimal valid image data stream
        byte[] imageData = createSampleImageData();
        
        try (PDDocument document = new PDDocument()) {
            // This will trigger static initialization of SampledImageReader
            // which calls LogFactory.getLog(SampledImageReader.class)
            PDImageXObject.createFromByteArray(
                document, 
                imageData, 
                "test.jpg"
            );
        }
    }
    
    private byte[] createSampleImageData() {
        // Create a minimal valid JPEG image (just header)
        return new byte[] {
            (byte)0xFF, (byte)0xD8, // SOI marker
            (byte)0xFF, (byte)0xE0, // APP0 marker
            0x00, 0x10,             // Length
            0x4A, 0x46, 0x49, 0x46, 0x00, // "JFIF"
            0x01, 0x01,             // Version
            0x00,                   // Density units
            0x00, 0x01,             // X density
            0x00, 0x01,             // Y density
            0x00, 0x00,             // Thumbnail
            (byte)0xFF, (byte)0xDB, // DQT marker
            0x00, 0x43,             // Length
            0x00                    // Quantization table data (partial)
        };
    }
}

