package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.pdmodel.font.FileSystemFontProvider.OpenTypeFont;
import org.apache.pdfbox.pdmodel.font.FileSystemFontProvider.FontInfo;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

class FSFontInfogetOTFFont_LogdebugFikaTest {

    @Test
    void testGetOTFFontInvokesLogDebug(@TempDir Path tempDir) throws Exception {
        // Create a minimal valid OTF font file
        Path fontFile = tempDir.resolve("testfont.otf");
        byte[] otfData = createMinimalOTF();
        Files.write(fontFile, otfData);
        
        // Create a FontInfo instance (the class containing getOTFFont)
        FontInfo fontInfo = new FontInfo();
        
        // Use reflection to access private method
        java.lang.reflect.Method method = FontInfo.class.getDeclaredMethod(
            "getOTFFont", String.class, File.class);
        method.setAccessible(true);
        
        // Invoke the method - this should trigger LOG.debug when LOG.isDebugEnabled() returns true
        method.invoke(fontInfo, "TestFont", fontFile.toFile());
    }
    
    private byte[] createMinimalOTF() {
        // Create minimal OTF font data that OTFParser can parse without throwing exceptions
        // This is a simplified version - in reality you'd need proper OTF structure
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        try {
            // OTF signature
            baos.write(new byte[] { 'O', 'T', 'T', 'O' });
            // numTables (2 tables: head and name)
            baos.write(new byte[] { 0, 0, 0, 2 });
            // searchRange, entrySelector, rangeShift
            baos.write(new byte[] { 0, 1, 0, 0, 0, 0, 0, 0 });
            
            // Table directory entry for 'head' table
            baos.write(new byte[] { 'h', 'e', 'a', 'd' });
            baos.write(new byte[] { 0, 0, 0, 0 }); // checksum
            baos.write(new byte[] { 0, 0, 0, 54 }); // offset (after directory)
            baos.write(new byte[] { 0, 0, 0, 54 }); // length
            
            // Table directory entry for 'name' table
            baos.write(new byte[] { 'n', 'a', 'm', 'e' });
            baos.write(new byte[] { 0, 0, 0, 0 }); // checksum
            baos.write(new byte[] { 0, 0, 0, 108 }); // offset
            baos.write(new byte[] { 0, 0, 0, 32 }); // length
            
            // 'head' table content
            baos.write(new byte[] { 0, 1, 0, 0 }); // version
            baos.write(new byte[] { 0, 1, 0, 0 }); // fontRevision
            baos.write(new byte[] { 0, 0, 0, 0 }); // checksumAdjustment
            baos.write(new byte[] { 0x5F, 0x0F, 0x3C, 0xF5 }); // magicNumber
            baos.write(new byte[] { 0, 0 }); // flags
            baos.write(new byte[] { 0, 16 }); // unitsPerEm
            baos.write(new byte[] { 0, 0, 0, 0 }); // created
            baos.write(new byte[] { 0, 0, 0, 0 }); // modified
            baos.write(new byte[] { 0, 0 }); // xMin
            baos.write(new byte[] { 0, 0 }); // yMin
            baos.write(new byte[] { 0, 0 }); // xMax
            baos.write(new byte[] { 0, 0 }); // yMax
            baos.write(new byte[] { 0, 0 }); // macStyle
            baos.write(new byte[] { 0, 0 }); // lowestRecPPEM
            baos.write(new byte[] { 0, 0 }); // fontDirectionHint
            baos.write(new byte[] { 0, 0 }); // indexToLocFormat
            baos.write(new byte[] { 0, 0 }); // glyphDataFormat
            
            // 'name' table content
            baos.write(new byte[] { 0, 0 }); // format
            baos.write(new byte[] { 0, 1 }); // count
            baos.write(new byte[] { 0, 6 }); // stringOffset
            
            // Name record
            baos.write(new byte[] { 0, 1 }); // platformID (Mac)
            baos.write(new byte[] { 0, 0 }); // encodingID
            baos.write(new byte[] { 0, 0 }); // languageID
            baos.write(new byte[] { 1, 0 }); // nameID (Font Family Name)
            baos.write(new byte[] { 0, 8 }); // length
            baos.write(new byte[] { 0, 0 }); // offset
            
            // String data
            baos.write("TestFont".getBytes());
            
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
        return baos.toByteArray();
    }
}

