package org.apache.pdfbox.multipdf;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDDocumentCatalog;
import org.apache.pdfbox.pdmodel.PDDocumentInformation;
import org.apache.pdfbox.cos.COSDictionary;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.cos.COSBase;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;

class SplittercreateNewDocument_LogwarnFikaTest {

    @Test
    void testCreateNewDocument_TriggersLogWarn() throws IOException {
        // Create a source document with document information containing a nested dictionary
        PDDocument sourceDocument = new PDDocument();
        PDDocumentInformation sourceDocInfo = new PDDocumentInformation();
        
        // Create a dictionary with a nested dictionary entry to trigger the warning
        COSDictionary infoDict = sourceDocInfo.getCOSObject();
        COSDictionary nestedDict = new COSDictionary();
        infoDict.setItem(COSName.getPDFName("CustomKey"), nestedDict);
        
        // Set up the source document to have /Root and /Info share the same dictionary
        // This triggers the second LOG.warn call
        sourceDocument.setDocumentInformation(sourceDocInfo);
        PDDocumentCatalog catalog = sourceDocument.getDocumentCatalog();
        
        // Force the condition where /Root and /Info share the same dictionary
        // We need to manipulate the internal COS objects
        COSDictionary rootDict = catalog.getCOSObject();
        COSDictionary infoDictRef = sourceDocInfo.getCOSObject();
        
        // Create a new dictionary that will be shared
        COSDictionary sharedDict = new COSDictionary();
        sharedDict.setItem(COSName.getPDFName("Type"), COSName.CATALOG);
        
        // Replace both catalog and info dictionaries with the shared one
        // This is a hack to satisfy the condition in the code
        catalog.getCOSObject().clear();
        catalog.getCOSObject().addAll(sharedDict);
        sourceDocInfo.getCOSObject().clear();
        sourceDocInfo.getCOSObject().addAll(sharedDict);
        
        // Create a Splitter instance
        Splitter splitter = new Splitter(sourceDocument);
        
        // Set a stream cache function to avoid NPE
        splitter.setStreamCacheCreateFunction(Mockito.mock(org.apache.pdfbox.io.RandomAccessRead.class));
        
        // Execute the method - this should trigger both LOG.warn calls
        splitter.createNewDocument();
        
        // Clean up
        sourceDocument.close();
    }
}

