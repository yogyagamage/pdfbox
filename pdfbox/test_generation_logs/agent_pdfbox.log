class PDICCBasedgetNumberOfComponents_LogwarnFikaTest {

    @Test
    void testGetNumberOfComponents() throws IOException {
        // Create a minimal COSStream with /N entry
        COSDictionary streamDict = new COSDictionary();
        streamDict.setInt(COSName.N, 3); // Different from ICC profile components
        
        COSStream cosStream = new COSStream(streamDict);
        
        // Create ICC profile data with different number of components
        // ICC header: 128 bytes total, bytes 8-11 = size, bytes 24-27 = 'acsp', 
        // bytes 16-19 = CMM type, bytes 80-83 = profile class
        byte[] iccData = new byte[128];
        // Set size (bytes 8-11) = 128
        iccData[8] = 0; iccData[9] = 0; iccData[10] = 0; iccData[11] = (byte) 128;
        // Set 'acsp' signature (bytes 24-27)
        iccData[24] = 'a'; iccData[25] = 'c'; iccData[26] = 's'; iccData[27] = 'p';
        // Set profile class (bytes 16-19) = display profile 'mntr' (0x6D6E7472)
        iccData[16] = 'm'; iccData[17] = 'n'; iccData[18] = 't'; iccData[19] = 'r';
        // Set number of components (bytes 84-87) = 4 (CMYK)
        iccData[84] = 0; iccData[85] = 0; iccData[86] = 0; iccData[87] = 4;
        
        // Create PDICCBased with the stream and ICC profile
        PDICCBased iccBased = new PDICCBased(cosStream);
        iccBased.iccProfile = new PDICCBased.ICCProfile(new ByteArrayInputStream(iccData));
        
        // Reset numberOfComponents to force recalculation
        iccBased.numberOfComponents = -1;
        
        // This should trigger the warning log when numIccComponents (4) != numberOfComponents (3)
        iccBased.getNumberOfComponents();
    }
}

