    @Test
    void testRadialShadingPaintCreation() throws Exception {
        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);
            
            try (PDPageContentStream contentStream = new PDPageContentStream(document, page)) {
                Rectangle2D rect = new Rectangle2D.Float(50, 50, 200, 200);
                AffineTransform transform = new AffineTransform();
                
                RadialShadingPaint paint = new RadialShadingPaint(rect, transform);
                
                Graphics2D graphics = contentStream.getGraphics();
                if (graphics != null) {
                    graphics.setPaint(paint);
                }
            }
            
            ByteArrayOutputStream baos = new ByteArrayOutputStream();
            document.save(baos);
        }
    }
}

