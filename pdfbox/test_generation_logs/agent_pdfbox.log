package org.apache.pdfbox.rendering;

import org.apache.pdfbox.contentstream.operator.Operator;
import org.apache.pdfbox.contentstream.operator.text.SetFontAndSize;
import org.apache.pdfbox.cos.COSBase;
import org.apache.pdfbox.cos.COSName;
import org.apache.pdfbox.cos.COSNumber;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDResources;
import org.apache.pdfbox.pdmodel.font.PDFont;
import org.apache.pdfbox.pdmodel.font.PDType1Font;
import org.junit.jupiter.api.Test;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

class PageDrawer_SetFontAndSizemethod_LogFactorygetLogFikaTest {

    @Test
    void testSetFontAndSize() throws IOException {
        SetFontAndSize operator = new SetFontAndSize();
        List<COSBase> arguments = new ArrayList<>();
        
        PDFont font = PDType1Font.HELVETICA;
        PDResources resources = new PDResources();
        resources.put(COSName.getPDFName("F1"), font);
        
        PDPage page = new PDPage();
        page.setResources(resources);
        
        arguments.add(COSName.getPDFName("F1"));
        arguments.add(COSNumber.get(12.0f));
        
        operator.process(new Operator("Tf", "Tf"), arguments);
    }
}

