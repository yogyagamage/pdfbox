            parseXrefMethod.setAccessible(true);
            
            try {
                parseXrefMethod.invoke(parser, 0L);
            } catch (Exception ignored) {
            }
        }
    }
    
    private void createMinimalPDF(File file) throws IOException {
        try (OutputStream os = new FileOutputStream(file)) {
            os.write("%PDF-1.4\n".getBytes());
            os.write("%\xE2\xE3\xCF\xD3\n".getBytes());
            os.write("xref\n".getBytes());
            os.write("0 1\n".getBytes());
            os.write("0000000000 65535 f \n".getBytes());
            os.write("trailer\n".getBytes());
            os.write("<< /Size 1 /Root 1 0 R >>\n".getBytes());
            os.write("startxref\n".getBytes());
            os.write("0\n".getBytes());
            os.write("%%EOF\n".getBytes());
        }
    }
}

