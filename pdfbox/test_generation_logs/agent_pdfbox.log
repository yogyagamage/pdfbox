package org.apache.pdfbox.printing;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.printing.PDFPrintable;
import org.apache.pdfbox.printing.Scaling;
import org.junit.jupiter.api.Test;
import java.awt.*;
import java.awt.print.PageFormat;
import java.awt.print.Paper;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class PDFPrintableprint_LogwarnFikaTest {

    @Test
    public void testPrintInvokesLogWarn() throws Exception {
        // Create a minimal PDF document
        byte[] pdfData = createMinimalPdf();
        PDDocument document = PDDocument.load(new ByteArrayInputStream(pdfData));
        
        // Create PDFPrintable with center=true to trigger the warning path
        PDFPrintable printable = new PDFPrintable(document, Scaling.ACTUAL_SIZE, true, 0, false, null, true);
        
        // Create a PageFormat with very small imageable area to cause negative translation
        PageFormat pageFormat = new PageFormat();
        Paper paper = new Paper();
        paper.setSize(100, 100); // Small paper
        paper.setImageableArea(1, 1, 98, 98); // Small imageable area
        pageFormat.setPaper(paper);
        
        // Create a Graphics object that won't throw exceptions
        Graphics graphics = createTestGraphics();
        
        // Call print with pageIndex=0 - this should trigger the LOG.warn() call
        // when center=true and translation values become negative
        printable.print(graphics, pageFormat, 0);
        
        document.close();
    }
    
    private byte[] createMinimalPdf() {
        // Create a minimal PDF with a very large page to ensure crop box dimensions
        // are larger than our small imageable area, causing negative translation
        try (PDDocument doc = new PDDocument()) {
            PDPage page = new PDPage(new PDRectangle(2000, 2000)); // Very large page
            doc.addPage(page);
            
            java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
            doc.save(baos);
            return baos.toByteArray();
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }
    
    private Graphics createTestGraphics() {
        // Create a BufferedImage and get its Graphics to avoid null Graphics
        java.awt.image.BufferedImage image = 
            new java.awt.image.BufferedImage(100, 100, java.awt.image.BufferedImage.TYPE_INT_ARGB);
        return image.getGraphics();
    }
}

