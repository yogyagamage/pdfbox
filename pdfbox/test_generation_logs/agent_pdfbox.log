package org.apache.pdfbox.pdmodel.graphics.shading;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.graphics.shading.PDShading;
import org.apache.pdfbox.pdmodel.graphics.shading.PDShadingType7;
import org.apache.pdfbox.pdmodel.graphics.color.PDDeviceRGB;
import java.io.ByteArrayOutputStream;

class PDShadingType7_PDTriangleBasedShadingTypemethod_LogFactorygetLogFikaTest {

    @Test
    void testTriangleBasedShadingTypeLogInitialization() throws Exception {
        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);
            
            PDShadingType7 shading = new PDShadingType7(document);
            shading.setColorSpace(PDDeviceRGB.INSTANCE);
            shading.setBitsPerCoordinate(8);
            shading.setBitsPerComponent(8);
            shading.setBitsPerFlag(8);
            
            try (PDPageContentStream cs = new PDPageContentStream(document, page)) {
                cs.shadingFill(shading);
            }
            
            ByteArrayOutputStream baos = new ByteArrayOutputStream();
            document.save(baos);
        }
    }
}

