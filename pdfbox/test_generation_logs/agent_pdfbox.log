package org.apache.pdfbox.pdmodel.graphics.image;

import org.junit.jupiter.api.Test;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject;
import java.awt.image.BufferedImage;
import java.io.ByteArrayInputStream;
import java.io.IOException;

class PDInlineImage_SampledImageReadermethod_LogFactorygetLogFikaTest2 {

    @Test
    void testSampledImageReaderStaticInitialization() throws IOException {
        // Create a minimal PDF document with an image to trigger SampledImageReader usage
        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);
            
            // Create a tiny 1x1 pixel image
            BufferedImage bufferedImage = new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB);
            bufferedImage.setRGB(0, 0, 0xFFFFFF);
            
            // Create PDImageXObject which internally uses SampledImageReader
            PDImageXObject pdImage = PDImageXObject.createFromByteArray(
                document,
                createSampleImageData(),
                "test"
            );
            
            // Draw the image to ensure full initialization
            try (PDPageContentStream contentStream = new PDPageContentStream(document, page)) {
                contentStream.drawImage(pdImage, 100, 100);
            }
        }
        // Static initialization of SampledImageReader.LOG will have triggered LogFactory.getLog
    }
    
    private byte[] createSampleImageData() {
        // Minimal valid JPEG data (just header and EOI marker)
        return new byte[] {
            (byte)0xFF, (byte)0xD8, // SOI
            (byte)0xFF, (byte)0xE0, // APP0
            0x00, 0x10, // Length
            0x4A, 0x46, 0x49, 0x46, 0x00, // JFIF
            0x01, 0x01, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00,
            (byte)0xFF, (byte)0xDB, // DQT
            0x00, 0x43, // Length
            0x00, // Table data...
            (byte)0xFF, (byte)0xC0, // SOF0
            0x00, 0x0B, // Length
            0x08, // Precision
            0x00, 0x01, // Height
            0x00, 0x01, // Width
            0x03, // Components
            0x01, 0x22, 0x00, // Component 1
            0x02, 0x11, 0x01, // Component 2
            0x03, 0x11, 0x01, // Component 3
            (byte)0xFF, (byte)0xC4, // DHT
            0x00, 0x1F, // Length
            0x00, // Table data...
            (byte)0xFF, (byte)0xDA, // SOS
            0x00, 0x0C, // Length
            0x03, // Components
            0x01, 0x00, // Component 1
            0x02, 0x11, // Component 2
            0x03, 0x11, // Component 3
            0x00, 0x3F, 0x00, // Spectral selection
            (byte)0xFF, (byte)0xD9  // EOI
        };
    }
}

