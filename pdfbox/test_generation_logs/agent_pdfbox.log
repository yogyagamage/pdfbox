package org.apache.pdfbox.pdmodel.interactive.annotation.handlers;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAnnotationSquare;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDAppearanceStream;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDBorderEffectDictionary;
import org.apache.pdfbox.pdmodel.interactive.annotation.PDBorderStyleDictionary;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.awt.Color;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

class PDSquareAppearanceHandlergenerateNormalAppearance_LogerrorFikaTest {

    @Test
    void testGenerateNormalAppearance_TriggersLogError() throws Exception {
        // Create a real PDDocument
        PDDocument document = new PDDocument();
        
        // Create a real PDAnnotationSquare
        PDAnnotationSquare annotation = new PDAnnotationSquare();
        annotation.setRectangle(new org.apache.pdfbox.pdmodel.common.PDRectangle(100, 100, 200, 200));
        annotation.setColor(new Color(255, 0, 0));
        
        // Create a mock appearance stream that will throw IOException
        PDAppearanceStream mockAppearanceStream = Mockito.mock(PDAppearanceStream.class);
        Mockito.when(mockAppearanceStream.createContentStream()).thenThrow(new IOException("Test IOException"));
        
        // Create the handler instance
        PDSquareAppearanceHandler handler = new PDSquareAppearanceHandler(annotation, document);
        
        // Use reflection to set up the annotation with the mock appearance stream
        java.lang.reflect.Field annotationField = PDSquareAppearanceHandler.class.getDeclaredField("annotation");
        annotationField.setAccessible(true);
        annotationField.set(handler, annotation);
        
        // Set the mock appearance stream on the annotation
        java.lang.reflect.Field appearanceField = PDAnnotationSquare.class.getDeclaredField("normalAppearance");
        appearanceField.setAccessible(true);
        appearanceField.set(annotation, mockAppearanceStream);
        
        // Try to generate appearance - should trigger IOException and Log.error()
        try {
            handler.generateNormalAppearance();
        } catch (Exception e) {
            // Expected - we want the IOException to be caught and logged
        }
        
        document.close();
    }
}

