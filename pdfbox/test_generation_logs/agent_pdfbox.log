    @Test
    public void testGetContentsForStreamParsing_TriggersLogWarn() throws IOException {
        // Create a real PDPage instance
        PDPage page = new PDPage();
        
        // Create a mock COSStream that will throw IOException when createRawInputStream is called
        COSStream mockContentStream = Mockito.mock(COSStream.class);
        when(mockContentStream.getFilters()).thenReturn(COSName.FLATE_DECODE);
