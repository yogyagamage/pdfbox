import org.mockito.Mockito;

import java.lang.reflect.Method;

class COSParserinit_LogwarnFikaTest {

    @Test
    void testInitTriggersLogWarn() throws Exception {
        // Create a real COSParser instance
        COSParser parser = new COSParser();
        
        // Create a mock StreamCacheCreateFunction
        COSDocument.StreamCacheCreateFunction mockFunction = 
            Mockito.mock(COSDocument.StreamCacheCreateFunction.class);
        
        // Set system property to non-integer value to trigger NumberFormatException
