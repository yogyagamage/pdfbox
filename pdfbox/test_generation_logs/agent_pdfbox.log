            os.write("<< /Size 3 /Root 1 0 R /XRefStm 999999 /Prev 0 >>\n".getBytes());
            os.write("startxref\n".getBytes());
            os.write("100\n".getBytes());
            os.write("%%EOF\n".getBytes());
