        ByteArrayOutputStream outputStream = new ByteArrayOutputStream();
        
        // Create a minimal CIDFontType2 dictionary
        org.apache.pdfbox.cos.COSDictionary fontDict = new org.apache.pdfbox.cos.COSDictionary();
        fontDict.setItem(org.apache.pdfbox.cos.COSName.TYPE, org.apache.pdfbox.cos.COSName.FONT);
        fontDict.setItem(org.apache.pdfbox.cos.COSName.SUBTYPE, org.apache.pdfbox.cos.COSName.CID_FONT_TYPE2);
        fontDict.setItem(org.apache.pdfbox.cos.COSName.BASE_FONT, org.apache.pdfbox.cos.COSName.getPDFName("TestFont"));
        fontDict.setItem(org.apache.pdfbox.cos.COSName.CID_TO_GID_MAP, org.apache.pdfbox.cos.COSName.IDENTITY);
        
        // Create DW and W entries to satisfy constructor requirements
        fontDict.setInt(org.apache.pdfbox.cos.COSName.DW, 1000);
        
        org.apache.pdfbox.cos.COSArray wArray = new org.apache.pdfbox.cos.COSArray();
        wArray.add(org.apache.pdfbox.cos.COSInteger.get(0));
        wArray.add(org.apache.pdfbox.cos.COSInteger.get(255));
        wArray.add(org.apache.pdfbox.cos.COSInteger.get(500));
        fontDict.setItem(org.apache.pdfbox.cos.COSName.W, wArray);
        
        // Create CIDSystemInfo
        org.apache.pdfbox.cos.COSDictionary cidSystemInfo = new org.apache.pdfbox.cos.COSDictionary();
        cidSystemInfo.setString(org.apache.pdfbox.cos.COSName.REGISTRY, "Adobe");
        cidSystemInfo.setString(org.apache.pdfbox.cos.COSName.ORDERING, "Identity");
        cidSystemInfo.setInt(org.apache.pdfbox.cos.COSName.SUPPLEMENT, 0);
        fontDict.setItem(org.apache.pdfbox.cos.COSName.CIDSYSTEMINFO, cidSystemInfo);
        
        // Create font descriptor
        org.apache.pdfbox.cos.COSDictionary fontDescriptor = new org.apache.pdfbox.cos.COSDictionary();
        fontDescriptor.setItem(org.apache.pdfbox.cos.COSName.TYPE, org.apache.pdfbox.cos.COSName.FONT_DESC);
        fontDescriptor.setItem(org.apache.pdfbox.cos.COSName.FONT_NAME, org.apache.pdfbox.cos.COSName.getPDFName("TestFont"));
        fontDescriptor.setInt(org.apache.pdfbox.cos.COSName.FLAGS, 4);
        fontDescriptor.setInt(org.apache.pdfbox.cos.COSName.ITALIC_ANGLE, 0);
        fontDescriptor.setInt(org.apache.pdfbox.cos.COSName.ASCENT, 800);
        fontDescriptor.setInt(org.apache.pdfbox.cos.COSName.DESCENT, -200);
        fontDescriptor.setInt(org.apache.pdfbox.cos.COSName.CAP_HEIGHT, 700);
        fontDescriptor.setInt(org.apache.pdfbox.cos.COSName.STEM_V, 80);
        fontDescriptor.setItem(org.apache.pdfbox.cos.COSName.FONT_BBOX, new org.apache.pdfbox.cos.COSArray());
        fontDict.setItem(org.apache.pdfbox.cos.COSName.FONT_DESC, fontDescriptor);
        
        org.apache.pdfbox.pdmodel.font.PDCIDFontType2 cidFont = 
