    @Test
    public void testGetType1FontInvokesLogDebug(@TempDir Path tempDir) throws Exception {
        // Create a minimal valid PFB font file for Type1Font parsing
        File fontFile = tempDir.resolve("test.pfb").toFile();
        
        // PFB header format: 0x80 0x01 (start), length (4 bytes), data
        try (FileOutputStream fos = new FileOutputStream(fontFile)) {
            // Start marker
            fos.write(0x80);
            fos.write(0x01);
            
            // Length of segment (4 bytes, little-endian)
            int length = 4;
            fos.write(length & 0xFF);
            fos.write((length >> 8) & 0xFF);
            fos.write((length >> 16) & 0xFF);
            fos.write((length >> 24) & 0xFF);
            
            // Minimal font data (just enough to pass initial parsing)
            fos.write(new byte[] { 0x25, 0x21, 0x50, 0x53 }); // %!PS
            
            // End marker
            fos.write(0x80);
            fos.write(0x03);
            
            // End segment length (0)
            fos.write(0);
            fos.write(0);
            fos.write(0);
            fos.write(0);
