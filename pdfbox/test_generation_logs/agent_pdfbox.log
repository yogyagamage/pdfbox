package org.apache.pdfbox.pdmodel.font;

import org.apache.pdfbox.pdmodel.font.FontFileReader;
import org.apache.pdfbox.pdmodel.font.OpenTypeFont;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import java.io.File;
import java.io.IOException;
import java.nio.file.Path;

class FSFontInfogetOTFFont_LogisDebugEnabledFikaTest {

    @Test
    void testGetOTFFontInvokesIsDebugEnabled(@TempDir Path tempDir) throws Exception {
        // Create a minimal valid OTF file for parsing
        File otfFile = createMinimalOTFFile(tempDir);
        
        // Create instance of the containing class
        FontFileReader fontFileReader = new FontFileReader();
        
        // Use reflection to access private method
        java.lang.reflect.Method method = FontFileReader.class.getDeclaredMethod(
            "getOTFFont", String.class, File.class);
        method.setAccessible(true);
        
        // Invoke with parameters that will take the OTF path (not TTC)
        method.invoke(fontFileReader, "TestFont", otfFile);
    }
    
    private File createMinimalOTFFile(Path tempDir) throws IOException {
        // Create a minimal valid OTF file that OTFParser can parse without throwing exceptions
        // This is a simplified version - in reality you'd need proper OTF structure
        File otfFile = tempDir.resolve("testfont.otf").toFile();
        
        // Write minimal OTF header (SFNT version 1.0 for OTF)
        try (java.io.FileOutputStream fos = new java.io.FileOutputStream(otfFile);
             java.io.DataOutputStream dos = new java.io.DataOutputStream(fos)) {
            
            // SFNT version (OTF/CFF)
            dos.writeInt(0x4F54544F); // "OTTO"
            
            // Number of tables
            dos.writeShort(3);
            
            // Search range, entry selector, range shift (calculated for 3 tables)
            dos.writeShort(2 * (int)Math.pow(2, (int)(Math.log(3)/Math.log(2))));
            dos.writeShort((int)(Math.log(3)/Math.log(2)));
            dos.writeShort(3 * 16 - 2 * (int)Math.pow(2, (int)(Math.log(3)/Math.log(2))));
            
            // CFF table entry
            writeTableEntry(dos, "CFF ", 0, 100);
            
            // Required tables for minimal OTF
            writeTableEntry(dos, "head", 100, 54);
            writeTableEntry(dos, "name", 154, 100);
        }
        
        return otfFile;
    }
    
    private void writeTableEntry(java.io.DataOutputStream dos, String tag, 
                                 int offset, int length) throws IOException {
        // Write 4-byte tag
        for (int i = 0; i < 4; i++) {
            dos.writeByte(i < tag.length() ? tag.charAt(i) : ' ');
        }
        // Checksum (dummy)
        dos.writeInt(0);
        // Offset
        dos.writeInt(offset);
        // Length
        dos.writeInt(length);
    }
}

