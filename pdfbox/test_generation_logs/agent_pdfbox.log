package org.apache.pdfbox.pdmodel.graphics.image;

import org.junit.jupiter.api.Test;
import java.awt.image.BufferedImage;
import java.awt.image.AffineTransformOp;
import java.awt.geom.AffineTransform;
import java.awt.Graphics2D;
import java.awt.RenderingHints;

class PDImageXObjectscaleImage_LogwarnFikaTest {

    @Test
    void testScaleImageTriggersLogWarn() throws Exception {
        // Create a minimal image that will cause ImagingOpException
        BufferedImage srcImage = new BufferedImage(10, 10, BufferedImage.TYPE_INT_RGB);
        
        // Create a custom AffineTransformOp that throws ImagingOpException
        AffineTransform transform = AffineTransform.getScaleInstance(2.0, 2.0);
        AffineTransformOp op = new AffineTransformOp(transform, AffineTransformOp.TYPE_BICUBIC) {
            @Override
            public BufferedImage filter(BufferedImage src, BufferedImage dst) {
                throw new ImagingOpException("Test exception to trigger Log.warn");
            }
        };
        
        // Use reflection to call the private method
        java.lang.reflect.Method method = getClass().getDeclaringClass()
            .getDeclaredMethod("scaleImage", 
                BufferedImage.class, int.class, int.class, int.class, boolean.class);
        method.setAccessible(true);
        
        // Invoke with parameters that ensure interpolate=true and largeScale=false
        // to go through the AffineTransformOp path
        method.invoke(null, srcImage, 20, 20, BufferedImage.TYPE_INT_RGB, true);
    }
}

