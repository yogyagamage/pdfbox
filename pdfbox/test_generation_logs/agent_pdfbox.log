                fontDict.setItem(COSName.BASE_FONT, COSName.getPDFName("TestFont"));
                fontDict.setItem(COSName.ENCODING, COSName.getPDFName("UnknownEncoding123"));
                
                // Create a simple font subclass that will trigger the warning
