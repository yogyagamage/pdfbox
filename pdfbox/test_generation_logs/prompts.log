    pageSize = new PDRectangle(minX / xformScalingFactorX, minY / xformScalingFactorY, ((float) (bounds.getWidth() / xformScalingFactorX)), ((float) (bounds.getHeight() / xformScalingFactorY)));
    int clipWindingRuleOriginal = clipWindingRule;
    clipWindingRule = -1;
