private void enqueueKids(PDField node) {
    queue.add(node);
    set.add(node.getCOSObject());
    if (node instanceof PDNonTerminalField) {
        List<PDField> kids = ((PDNonTerminalField) (node)).getChildren();
        for (PDField kid : kids) {
            if (set.contains(kid.getCOSObject())) // PATH: Test should invoke the next Log.error(...) [step in execution path]
            {
                LOG.error(("Child of field '" + node.getFullyQualifiedName()) + "' already exists elsewhere, ignored to avoid recursion");
            } else {
                enqueueKids(kid);
            }
        }
    }
}

